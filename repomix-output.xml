<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel do Maestro — ERP Fabrica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/global.css" />
  <style>
    /* TABS NAVIGATION */
    .maestro-tabs {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 6px;
      width: fit-content;
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
    }
    .tab-btn {
      padding: 10px 20px;
      border-radius: var(--radius);
      border: none;
      background: none;
      font-weight: 700;
      cursor: pointer;
      color: var(--text-secondary);
      font-size: 13.5px;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .tab-btn.active {
      background: var(--brand);
      color: white;
    }

    /* MAESTRO LAYOUT */
    .maestro-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 20px;
      align-items: start;
    }

    /* SIDEBAR PENDENCIAS */
    .sidebar-pendencias {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      max-height: 750px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: var(--shadow);
    }

    .pendencias-header {
      font-weight: 700;
      font-size: 15px;
      border-bottom: 2px solid var(--border-light);
      padding-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .pendencias-list {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-right: 4px;
    }

    .op-drag-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 12px;
      cursor: grab;
      font-size: 13px;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .op-drag-card:active {
      cursor: grabbing;
    }
    .op-drag-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
      border-color: var(--brand);
    }

    .op-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .op-code {
      font-weight: 700;
      color: var(--brand);
    }
    .op-badge {
      font-size: 9px;
      padding: 2px 6px;
      border-radius: 8px;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    .op-name {
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
    }
    .op-details {
      font-size: 11px;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
    }

    /* GRID SEMANAL (5 COLUNAS) */
    .grid-semanal {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      align-items: start;
    }

    .dia-col {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-height: 650px;
      box-shadow: var(--shadow-sm);
    }

    .dia-header {
      padding: 12px;
      text-align: center;
      color: white;
      font-weight: 700;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .dia-nome { font-size: 14px; text-transform: capitalize; }
    .dia-data { font-size: 11px; opacity: 0.85; }
    .dia-desc { font-size: 10px; font-weight: 500; opacity: 0.9; margin-top: 2px; }

    /* Cores de Cabeçalho dos Dias */
    .col-segunda .dia-header { background: #6366f1; } /* Roxo / D-1 Cozinha ou D+0 Montagem */
    .col-terca   .dia-header { background: #2563eb; }
    .col-quarta  .dia-header { background: #f97316; }
    .col-quinta  .dia-header { background: #2563eb; }
    .col-sexta   .dia-header { background: #f97316; }

    .dia-col-body {
      padding: 10px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
      overflow-y: auto;
    }

    /* CARTÃO DO COLABORADOR */
    .colab-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 12px;
      transition: all 0.2s;
      min-height: 100px;
    }
    .colab-card.drag-over {
      border-color: var(--brand);
      background: var(--brand-light);
      box-shadow: 0 0 0 2px var(--brand);
    }

    .colab-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 8px;
    }
    .colab-nome {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .colab-novato-badge {
      font-size: 9px;
      background: #fed7aa;
      color: #9a3412;
      padding: 1px 4px;
      border-radius: 4px;
      font-weight: 700;
    }

    /* BARRA DE PROGRESSO */
    .progress-wrapper {
      margin-bottom: 8px;
    }
    .progress-label {
      font-size: 10.5px;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
    }
    .progress-bar-bg {
      background: var(--border-light);
      height: 6px;
      border-radius: 3px;
      overflow: hidden;
      position: relative;
    }
    .progress-bar-fill {
      height: 100%;
      background: var(--green);
      transition: width 0.3s ease, background-color 0.3s ease;
      width: 0%;
    }
    .progress-bar-fill.excedido {
      background: var(--red) !important;
    }

    /* LEGENDA DE PRODUÇÃO (ESSENCIAL) */
    .legend-list {
      list-style: none;
      padding: 0;
      margin: 0;
      border-top: 1px dashed var(--border);
      padding-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .legend-item {
      font-size: 11px;
      color: var(--text-secondary);
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }
    .legend-item:hover {
      color: var(--brand);
    }
    .legend-bullet {
      color: var(--brand);
      margin-right: 4px;
    }

    /* SLIDE-OVER DE COMPRAS */
    .slide-over {
      position: fixed;
      top: 0;
      right: 0;
      width: 420px;
      height: 100%;
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
      z-index: 1000;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
    }
    .slide-over.open {
      transform: translateX(0);
    }
    .slide-over-header {
      padding: 20px;
      border-bottom: 1px solid var(--border-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg);
    }
    .slide-over-header h3 {
      font-size: 16px;
      font-weight: 700;
    }
    .slide-over-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--text-muted);
    }
    .slide-over-body {
      padding: 20px;
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .slide-over-footer {
      padding: 20px;
      border-top: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .falta-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .falta-info {
      display: flex;
      flex-direction: column;
    }
    .falta-nome { font-weight: 700; font-size: 13px; }
    .falta-det { font-size: 11px; color: var(--text-muted); }
    .falta-qtd { font-weight: 700; color: var(--red); font-size: 14px; }

    /* GENERAL BUTTON STYLE */
    .btn-validate {
      background: var(--brand);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-validate:hover {
      background: var(--brand-hover);
    }

    .btn-wa {
      background: #25d366;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      text-decoration: none;
    }
    .btn-wa:hover {
      background: #20ba5a;
    }

    .week-nav {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .week-nav button {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
    }
    .week-nav button:hover {
      background: var(--brand-light);
      color: var(--brand);
      border-color: var(--brand);
    }
  </style>
</head>
