      display: flex;
      justify-content: space-between;
    }

    .ops-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 600px;
      overflow-y: auto;
    }

    .op-item {
      border: 1px solid var(--border);
