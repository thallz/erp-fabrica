<div class="drawer-backdrop" id="drawer-backdrop" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <h2 id="drawer-title">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Novo Colaborador
    </h2>
    <p id="drawer-subtitle">Cadastre um novo operador no painel da fábrica.</p>
    <button class="drawer-close" onclick="closeDrawer()">&#10005;</button>
  </div>
  <div class="drawer-body">
    <form id="form-colaborador" onsubmit="submitColaborador(event)">
      <input type="hidden" id="f-id" />
      
      <div class="form-group">
        <label>Nome do Colaborador <span style="color:var(--red)">*</span></label>
        <input type="text" id="f-nome" placeholder="Ex: Maria de Souza" required />
      </div>

      <div class="form-row cols-2">
        <div class="form-group">
          <label>Meta Diária (unidades) <span style="color:var(--red)">*</span></label>
          <input type="number" id="f-meta" placeholder="Ex: 350" required min="50" max="1000" />
        </div>
        <div class="form-group">
          <label>Status <span style="color:var(--red)">*</span></label>
          <select id="f-status" required>
            <option value="Ativo">Ativo</option>
            <option value="Inativo">Inativo</option>
          </select>
        </div>
      </div>

      <div class="form-group" style="margin-top:10px;">
        <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
          <input type="checkbox" id="f-novato" style="width:auto; margin:0;" />
          <span>É colaborador novato (Alerta de meta e suporte técnico no agendamento)</span>
        </label>
      </div>
    </form>
  </div>
  <div class="drawer-footer">
    <button class="btn btn-close" onclick="closeDrawer()">Cancelar</button>
    <button class="btn btn-primary" onclick="document.getElementById('form-colaborador').requestSubmit()">Salvar Colaborador</button>
  </div>
</div>

<div id="toast-container"></div>

<script>
  const API = 'http://localhost:3001/api';
  let colaboradores = [];

  function toast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  async function testConnection() {
    try {
      const res = await fetch(`${API}/status`);
      if (res.ok) {
        document.getElementById('api-status').textContent = 'API Online';
        document.getElementById('api-status').className = 'api-status api-online';
      }
    } catch {
      document.getElementById('api-status').textContent = 'Modo Offline';
      document.getElementById('api-status').className = 'api-status api-offline';
    }
  }

  async function loadColaboradores() {
    try {
      const res = await fetch(`${API}/colaboradores`);
      if (!res.ok) throw new Error();
      colaboradores = await res.json();
      renderColaboradores();
    } catch {
      toast('Erro de conexão ao carregar colaboradores.', 'error');
    }
  }

  function renderColaboradores() {
    const tbody = document.getElementById('colab-tbody');
    const term = document.getElementById('colab-search').value.toLowerCase().trim();
    
    const filtered = colaboradores.filter(c => c.nome.toLowerCase().includes(term));
    
    // Update KPIs
    const ativos = colaboradores.filter(c => c.status === 'Ativo').length;
    const novatos = colaboradores.filter(c => c.eh_novato && c.status === 'Ativo').length;
    const veteranos = ativos - novatos;

    document.getElementById('kpi-ativos').textContent = ativos;
    document.getElementById('kpi-novatos').textContent = novatos;
    document.getElementById('kpi-veteranos').textContent = veteranos;
    document.getElementById('footer-count').textContent = `Exibindo ${filtered.length} de ${colaboradores.length} colaboradores`;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:30px;">Nenhum colaborador encontrado.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(c => {
      const statusBadge = c.status === 'Ativo' ? 'badge-green' : 'badge-red';
      const perfilBadge = c.eh_novato ? 'badge-amber' : 'badge-blue';
      const perfilLabel = c.eh_novato ? 'Novato' : 'Veterano';

      return `
        <tr>
          <td>#${c.id}</td>
          <td><strong>${c.nome}</strong></td>
          <td><span style="font-size:14.5px; font-weight:700;">${c.meta_diaria || c.meta_diaria_individual} un</span></td>
          <td><span class="badge ${perfilBadge}">${perfilLabel}</span></td>
          <td><span class="badge ${statusBadge}">${c.status}</span></td>
          <td style="text-align:right">
            <div class="action-icons" style="justify-content:flex-end">
              <button onclick="openEditarColaborador(${c.id})" title="Editar">&#9998;</button>
              <button class="red" onclick="excluirColaborador(${c.id})" title="Excluir">&#128465;</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function filtrarColaboradores() {
    renderColaboradores();
  }

  function openDrawer() {
    document.getElementById('drawer-backdrop').classList.add('open');
    document.getElementById('drawer').classList.add('open');
  }

  function closeDrawer() {
    document.getElementById('drawer-backdrop').classList.remove('open');
    document.getElementById('drawer').classList.remove('open');
    document.getElementById('form-colaborador').reset();
    document.getElementById('f-id').value = '';
  }

  function openNovoColaborador() {
    document.getElementById('drawer-title').innerHTML = `
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Novo Colaborador
    `;
    document.getElementById('drawer-subtitle').textContent = 'Cadastre um novo operador no painel da fábrica.';
    openDrawer();
  }

  function openEditarColaborador(id) {
    const colab = colaboradores.find(c => c.id === id);
    if (!colab) return;

    document.getElementById('drawer-title').innerHTML = `
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Editar Colaborador
    `;
    document.getElementById('drawer-subtitle').textContent = `Editando dados de ${colab.nome}`;
    
    document.getElementById('f-id').value = colab.id;
    document.getElementById('f-nome').value = colab.nome;
    document.getElementById('f-meta').value = colab.meta_diaria || colab.meta_diaria_individual;
    document.getElementById('f-status').value = colab.status || 'Ativo';
    document.getElementById('f-novato').checked = colab.eh_novato || false;

    openDrawer();
  }

  async function submitColaborador(e) {
    e.preventDefault();
    const id = document.getElementById('f-id').value;
    const nome = document.getElementById('f-nome').value;
    const meta_diaria = document.getElementById('f-meta').value;
    const status = document.getElementById('f-status').value;
    const eh_novato = document.getElementById('f-novato').checked;

    const payload = { nome, meta_diaria, status, eh_novato };

    try {
      let res;
      if (id) {
        // Editar
        res = await fetch(`${API}/colaboradores/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } else {
        // Criar
        res = await fetch(`${API}/colaboradores`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }

      if (!res.ok) throw new Error();
      toast(id ? 'Colaborador atualizado!' : 'Colaborador cadastrado!', 'success');
      closeDrawer();
      await loadColaboradores();
    } catch {
      toast('Erro ao salvar colaborador.', 'error');
    }
  }

  async function excluirColaborador(id) {
    if (!confirm('Deseja realmente excluir este colaborador? Esta ação não pode ser desfeita.')) return;
    try {
      const res = await fetch(`${API}/colaboradores/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error();
      toast('Colaborador excluído!', 'success');
      await loadColaboradores();
    } catch {
      toast('Erro ao excluir colaborador.', 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    testConnection();
    loadColaboradores();
  });
</script>
</body>
</html>
</file>

