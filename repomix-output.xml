          <span class="spinner" style="display:inline-block;margin-right:8px"></span>
          Carregando clientes...
        </p>
      </div>

    </div>
  </div>
</div>

<!-- ==================== MODAL CENTRALIZADO DE CLIENTE (520px) ==================== -->
<div class="modal-overlay" id="cliente-modal-overlay" onclick="closeClienteModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="cliente-modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Novo Cliente
      </h3>
      <button class="modal-close" onclick="closeClienteModal()">✕</button>
    </div>

    <div class="modal-body">
      <form id="form-cliente" onsubmit="salvarCliente(event)">
        <input type="hidden" id="cliente-id" />

        <!-- DADOS PRINCIPAIS -->
        <div class="form-group">
          <label>Razão Social / Nome *</label>
          <input type="text" id="cliente-razao" required placeholder="Ex: Padaria Bella Vista Ltda" />
        </div>

        <div class="form-row cols-2">
          <div class="form-group">
            <label>CNPJ</label>
            <input type="text" id="cliente-cnpj"
              placeholder="00.000.000/0001-00"
              maxlength="18"
              oninput="mascaraCNPJ(this)" />
            <div class="input-hint">Formato: 00.000.000/0001-00</div>
          </div>
          <div class="form-group">
            <label>Telefone / WhatsApp</label>
            <input type="text" id="cliente-telefone"
              placeholder="(11) 99999-9999"
              maxlength="15"
              oninput="mascaraTelefone(this)" />
          </div>
        </div>

        <!-- DADOS DE ENTREGA -->
        <div class="form-section-header">📍 Endereço de Entrega</div>

        <div class="form-group">
          <label>Endereço Completo</label>
          <textarea id="cliente-endereco" rows="3"
            placeholder="Rua, número, bairro, cidade — Ex: Rua das Flores, 123, Centro, São Paulo/SP"
            style="resize:vertical;min-height:72px"></textarea>
        </div>

        <div class="form-group">
          <label>Tipo de Cliente</label>
          <select id="cliente-tipo">
            <option value="B2B">B2B — Revenda / Empresa</option>
            <option value="B2C">B2C — Consumidor Final</option>
            <option value="ATACADO">Atacado</option>
          </select>
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="closeClienteModal()">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-cliente').requestSubmit()">
        Salvar Cliente
      </button>
    </div>
  </div>
</div>

<script>
  const API_URL = 'http://localhost:3001/api/comercial/clientes';

  let todosClientes = [];

  /* ======================== TOAST ======================== */
  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  /* ======================== MÁSCARAS ======================== */
  function mascaraCNPJ(input) {
    let v = input.value.replace(/\D/g, '').slice(0, 14);
    if (v.length > 12) v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2}).*/, '$1.$2.$3/$4-$5');
    else if (v.length > 8) v = v.replace(/^(\d{2})(\d{3})(\d{3})(\d{0,4}).*/, '$1.$2.$3/$4');
    else if (v.length > 5) v = v.replace(/^(\d{2})(\d{3})(\d{0,3}).*/, '$1.$2.$3');
    else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,3}).*/, '$1.$2');
    input.value = v;
  }

  function mascaraTelefone(input) {
    let v = input.value.replace(/\D/g, '').slice(0, 11);
    if (v.length === 11) v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
    else if (v.length === 10) v = v.replace(/^(\d{2})(\d{4})(\d{4})$/, '($1) $2-$3');
    else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4,5})(\d{0,4})$/, '($1) $2-$3');
    else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
    input.value = v;
  }

  /* ======================== MODAL ======================== */
  function openClienteModal(id = null) {
    document.getElementById('form-cliente').reset();
    document.getElementById('cliente-id').value = '';

    if (id) {
      const c = todosClientes.find(x => x.id === id);
      document.getElementById('cliente-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg> Editar Cliente`;
      document.getElementById('cliente-id').value       = c.id;
      document.getElementById('cliente-razao').value    = c.razao_social || '';
      document.getElementById('cliente-cnpj').value     = c.cnpj || '';
      document.getElementById('cliente-telefone').value = c.telefone || '';
      document.getElementById('cliente-endereco').value = c.endereco || '';
      document.getElementById('cliente-tipo').value     = c.tipo || 'B2B';
    } else {
      document.getElementById('cliente-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg> Novo Cliente`;
    }

    document.getElementById('cliente-modal-overlay').classList.add('open');
  }

  function closeClienteModal() {
    document.getElementById('cliente-modal-overlay').classList.remove('open');
  }

  function closeClienteModalOnBackdrop(event) {
    if (event.target === document.getElementById('cliente-modal-overlay')) closeClienteModal();
  }

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeClienteModal();
  });

  /* ======================== LOAD / RENDER ======================== */
  async function carregarClientes() {
    try {
      const res = await fetch(API_URL);
      todosClientes = await res.json();
      renderizar(todosClientes);
    } catch {
      document.getElementById('clientes-grid').innerHTML =
        `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red)">
          ⚠️ Erro ao conectar com o servidor em localhost:3001</p>`;
    }
  }

  function renderizar(lista) {
    const grid = document.getElementById('clientes-grid');
    if (!lista.length) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
        Nenhum cliente cadastrado. Clique em <strong>+ Novo Cliente</strong> para começar.</p>`;
      return;
    }

    grid.innerHTML = lista.map(c => {
      const tipo = c.tipo || 'B2B';
      const endereco = c.endereco ? c.endereco : null;

      return `
        <div class="cli-card">
          <div>
            <div class="cli-card-header">
              <span class="badge-b2b">${tipo}</span>
              <span class="badge badge-gray">#${c.id}</span>
            </div>
            <div class="cli-title">${c.razao_social}</div>

            <div style="margin-top:12px;display:flex;flex-direction:column;gap:5px">
              ${c.cnpj ? `
              <div class="cli-info-row">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
                </svg>
                <span style="font-family:monospace;font-size:12.5px">${c.cnpj}</span>
              </div>` : ''}

              ${c.telefone ? `
              <div class="cli-info-row">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.61 19a19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.18A2 2 0 0 1 4.52 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <span>${c.telefone}</span>
              </div>` : ''}

              ${endereco ? `
              <div class="cli-info-row">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span style="white-space:normal;word-break:break-word;line-height:1.3">${endereco}</span>
              </div>` : ''}
            </div>
          </div>

          <div class="cli-card-footer">
            <button class="btn btn-outline btn-sm" onclick="openClienteModal(${c.id})">Editar</button>
            <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"
              onclick="excluirCliente(${c.id}, '${c.razao_social.replace(/'/g, "\\'")}')">Excluir</button>
          </div>
        </div>`;
    }).join('');
  }

  function filtrar() {
    const q = document.getElementById('input-busca').value.toLowerCase();
    renderizar(todosClientes.filter(c =>
      c.razao_social.toLowerCase().includes(q) ||
      (c.cnpj || '').toLowerCase().includes(q) ||
      (c.telefone || '').includes(q)
    ));
  }

  /* ======================== SAVE ======================== */
  async function salvarCliente(e) {
    e.preventDefault();
    const id = document.getElementById('cliente-id').value;
    const body = {
      razao_social: document.getElementById('cliente-razao').value.trim(),
      cnpj:         document.getElementById('cliente-cnpj').value.trim(),
      telefone:     document.getElementById('cliente-telefone').value.trim(),
      endereco:     document.getElementById('cliente-endereco').value.trim(),
      tipo:         document.getElementById('cliente-tipo').value
    };

    if (!body.razao_social) {
      showToast('A Razão Social é obrigatória.', 'error');
      return;
    }

    try {
      const res = id
        ? await fetch(`${API_URL}/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })
        : await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });

      if (res.ok) {
        showToast(id ? '✅ Cliente atualizado!' : '✅ Cliente cadastrado!', 'success');
        closeClienteModal();
        carregarClientes();
      } else {
        const d = await res.json();
        showToast('Erro: ' + (d.erro || 'Desconhecido'), 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    }
  }

  /* ======================== DELETE ======================== */
  async function excluirCliente(id, nome) {
    if (!confirm(`Excluir "${nome}"? Esta ação não pode ser desfeita.`)) return;
    try {
      const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
      if (res.ok) {
        showToast('🗑️ Cliente removido.');
        carregarClientes();
      } else {
        const d = await res.json();
        showToast('Erro: ' + d.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarClientes;
</script>
</body>
</html>
</file>

