                </div>
              `;
            }

            let recheioHtml = '';
            if (recheioRecs.length > 0) {
              const textoRecheios = recheioRecs.map(r => `*${r.peso_total_kg} kg* de *${r.nome}*`).join(' e ');
              recheioHtml = `
                <div class="instrucao-item" style="margin-left: 15px; margin-top: 10px;">
                  <div class="instrucao-header">👉 2. Retirar Recheio [${recheioRecs.map(r=>r.nome).join(', ')}] da câmara de resfriamento (D-1):</div>
