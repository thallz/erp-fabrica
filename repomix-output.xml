  <div class="slide-over-footer">
    <button class="btn-wa" id="btn-whatsapp-compras" style="display:none;" onclick="enviarWhatsAppCompras()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.333 4.993L2 22l5.13-1.347a9.96 9.96 0 0 0 4.887 1.277h.005c5.505 0 9.989-4.478 9.99-9.985A9.97 9.97 0 0 0 12.012 2zm4.957 14.135c-.272.766-1.58 1.488-2.176 1.583-.55.088-1.267.16-3.7-.847-3.11-1.288-5.11-4.446-5.267-4.653-.156-.207-1.272-1.69-1.272-3.228 0-1.538.8-2.292 1.085-2.597.285-.306.623-.383.83-.383.208 0 .416.002.6.01.196.007.458-.074.717.552.264.639.907 2.213.985 2.373.078.16.13.346.026.556-.104.21-.156.34-.312.522-.156.181-.325.405-.467.545-.162.16-.33.334-.143.655.188.32.834 1.378 1.79 2.228.956.85 1.76 1.11 2.072 1.27.311.162.493.136.677-.077.185-.213.79-.92.998-1.233.208-.313.416-.26.702-.154.286.106 1.815.856 2.128 1.012.311.157.52.233.597.368.077.135.077.785-.195 1.551z"/></svg>
      Enviar para Compras (WhatsApp)
    </button>
  </div>
</div>

<div id="toast-container"></div>

<script>
  const API = 'http://localhost:3001/api';
  let dataReferencia = new Date();
  let totalOps = [];
  let currentAgenda = {};
  let missingStockItems = [];
  let activeTab = 'PREPARO'; // PREPARO (Visão A: Cozinha) ou MONTAGEM (Visão B: Montagem)

  let draggedOpId = null;

  function toast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  // Alternar Visões de Dashboard
  function alterarTab(tabName) {
    activeTab = tabName;
    
    document.getElementById('btn-tab-preparo').classList.remove('active');
    document.getElementById('btn-tab-montagem').classList.remove('active');
    if (tabName === 'PREPARO') {
      document.getElementById('btn-tab-preparo').classList.add('active');
      document.getElementById('pendencias-titulo').textContent = 'Fila de Cozinha (kg)';
      
      document.getElementById('desc-seg').textContent = '🥣 Recheio (D-1)';
      document.getElementById('desc-ter').textContent = '🥣 Recheio (D-1)';
      document.getElementById('desc-qua').textContent = '🥣 Recheio (D-1)';
      document.getElementById('desc-qui').textContent = '🥣 Recheio (D-1)';
      document.getElementById('desc-sex').textContent = '🥣 Recheio (D-1)';
    } else {
      document.getElementById('btn-tab-montagem').classList.add('active');
      document.getElementById('pendencias-titulo').textContent = 'Fila de Confecção (un)';
      
      document.getElementById('desc-seg').textContent = '🍞 Fermentados (D+0)';
      document.getElementById('desc-ter').textContent = '🍰 Assados (D+0)';
      document.getElementById('desc-qua').textContent = '🔥 Fritos (D+0)';
      document.getElementById('desc-qui').textContent = '🍰 Assados (D+0)';
      document.getElementById('desc-sex').textContent = '🔥 Fritos (D+0)';
    }

    renderSidebarPendencias();
    renderMaestroBoard(obterDatasSemanaUtil(dataReferencia), currentAgenda);
  }

  function obterDatasSemanaUtil(dataRef) {
    const d = new Date(dataRef);
    const day = d.getDay();
    const diff = d.getDate() - day + (day === 0 ? -6 : 1);
    
    const segunda = new Date(d.setDate(diff));
    const datas = [];
    for (let i = 0; i < 5; i++) {
      const temp = new Date(segunda);
      temp.setDate(segunda.getDate() + i);
      datas.push(temp);
    }
    return datas;
  }

  function formatarYYYYMMDD(data) {
    return data.toISOString().split('T')[0];
  }

  function formatarDDMM(dataStr) {
    const parts = dataStr.split('-');
    return `${parts[2]}/${parts[1]}`;
  }

  function navegarSemana(dias) {
    dataReferencia.setDate(dataReferencia.getDate() + dias);
    carregarTudo();
  }

  async function init() {
    await testarConexao();
    await carregarTudo();
  }

  async function testarConexao() {
    const el = document.getElementById('connection-status');
    try {
      const res = await fetch(`${API}/status`);
      if (res.ok) {
        el.textContent = 'API Online';
        el.className = 'api-status api-online';
      } else throw new Error();
    } catch {
      el.textContent = 'Modo Offline';
      el.className = 'api-status api-offline';
      toast('Servidor backend offline.', 'error');
    }
  }

  async function carregarTudo() {
    const datas = obterDatasSemanaUtil(dataReferencia);
    const startStr = formatarYYYYMMDD(datas[0]);
    const endStr = formatarYYYYMMDD(datas[4]);

    document.getElementById('label-semana').textContent = `Semana de ${formatarDDMM(startStr)} a ${formatarDDMM(endStr)}`;

    document.getElementById('data-seg').textContent = formatarDDMM(startStr);
    document.getElementById('data-ter').textContent = formatarDDMM(formatarYYYYMMDD(datas[1]));
    document.getElementById('data-qua').textContent = formatarDDMM(formatarYYYYMMDD(datas[2]));
    document.getElementById('data-qui').textContent = formatarDDMM(formatarYYYYMMDD(datas[3]));
    document.getElementById('data-sex').textContent = formatarDDMM(endStr);

    try {
      const resFila = await fetch(`${API}/producao/fila`);
      const rawFila = await resFila.json();
      totalOps = Array.isArray(rawFila) ? rawFila : [];

      const resSemana = await fetch(`${API}/planejamento/semanal?data_inicio=${startStr}&data_fim=${endStr}`);
      const dataSemana = await resSemana.json();
      currentAgenda = dataSemana.agenda || {};

      renderSidebarPendencias();
      renderMaestroBoard(datas, currentAgenda);
    } catch (err) {
      console.error('Erro ao carregar planejamento:', err);
      toast('Erro ao obter dados do servidor.', 'error');
    }
  }

  // 1. Renderizar fila de pendências
  function renderSidebarPendencias() {
    const list = document.getElementById('pendencias-container');
    const badge = document.getElementById('badge-pendencias');

    const desprogramadas = totalOps.filter(op => !op.data_programada && (op.tipo_op === activeTab || (!op.tipo_op && activeTab === 'MONTAGEM')));
    badge.textContent = `${desprogramadas.length} OPs`;

    if (desprogramadas.length === 0) {
      list.innerHTML = `<div style="color:var(--text-muted);font-size:12px;text-align:center;padding:40px 10px;">Nenhuma OP de ${activeTab === 'PREPARO' ? 'Cozinha' : 'Montagem'} na fila.</div>`;
      return;
    }

    list.innerHTML = desprogramadas.map(op => {
      const isPrep = op.tipo_op === 'PREPARO';
      const displayNome = isPrep ? (op.receita_nome || 'Receita Preparo') : op.produto;
      const displayUnidade = isPrep ? 'kg' : 'un';
      const peso = parseFloat(op.peso_produtividade || 1.0);
      const pontos = op.quantidade_planejada * peso;
      const catClass = isPrep ? 'tag-fermentado' : 'tag-' + (op.categoria_producao || 'Geral').trim().toLowerCase();

      return `
        <div class="op-drag-card" draggable="true" ondragstart="dragStart(event, ${op.numero_op})">
          <div class="op-meta-row">
            <span class="op-code">OP-${String(op.numero_op).padStart(3, '0')}</span>
            <span class="op-badge ${catClass}">${isPrep ? 'PREPARO' : 'MONTAGEM'}</span>
          </div>
          <div class="op-name">${displayNome}</div>
          <div class="op-details">
            <span>Demanda: <strong>${op.quantidade_planejada} ${displayUnidade}</strong></span>
            ${isPrep ? '' : `<span>Pts: <strong>${pontos.toFixed(1)}</strong></span>`}
          </div>
        </div>
      `;
    }).join('');
  }

  // 2. Renderizar Quadro Maestro Semanal (D-1 Cozinha vs D+0 Montagem)
  function renderMaestroBoard(datasSemana, agenda) {
    const diasIDs = ['seg', 'ter', 'qua', 'qui', 'sex'];

    datasSemana.forEach((data, index) => {
      const dStr = formatarYYYYMMDD(data);
      const colId = `body-${diasIDs[index]}`;
      const colEl = document.getElementById(colId);
      colEl.innerHTML = '';

      const diaAgenda = agenda[dStr] || { colaboradores: [] };
      const colabs = diaAgenda.colaboradores || [];

      if (colabs.length === 0) {
        colEl.innerHTML = '<div style="color:var(--text-muted);font-size:11px;text-align:center;padding:40px 0;">Nenhum operador ativo.</div>';
        return;
      }

      colabs.forEach(c => {
        const opsFiltradas = (c.ops || []).filter(o => o.tipo_op === activeTab || (!o.tipo_op && activeTab === 'MONTAGEM'));

        const meta = c.meta_diaria_individual || 350;
        
        let totalCargaExibida = 0;
        let pct = 0;
        let exceeds = false;

        if (activeTab === 'PREPARO') {
          totalCargaExibida = opsFiltradas.reduce((sum, o) => sum + parseFloat(o.quantidade_planejada), 0);
          pct = Math.min(100, (totalCargaExibida / 50.0) * 100);
          exceeds = totalCargaExibida > 50.0;
        } else {
          totalCargaExibida = opsFiltradas.reduce((sum, o) => sum + (o.quantidade_planejada * (o.peso_produtividade || 1.0)), 0);
          pct = Math.min(200, (totalCargaExibida / meta) * 100);
          exceeds = totalCargaExibida > meta;
        }

        // Mapear itens da legenda
        const legendsHtml = opsFiltradas.length > 0
          ? opsFiltradas.map(o => {
              const displayNomeLeg = o.tipo_op === 'PREPARO' ? (o.receita_nome || 'Preparo') : o.produto_nome;
              const displayUnLeg = o.tipo_op === 'PREPARO' ? 'kg' : 'un';
              const elementId = `op-legend-${o.op_id}`;
              
              // Se for Cozinha (PREPARO), disparamos checagem assíncrona de almoxarifado
              if (activeTab === 'PREPARO') {
                  verificarMateriaPrimaOP(o.op_id, elementId);
              }

              return `
                <li class="legend-item" id="${elementId}" onclick="desagendarOP(${o.op_id})">
                  <div>
                    <span class="legend-bullet">•</span><strong>${o.quantidade_planejada} ${displayUnLeg}</strong> - ${displayNomeLeg}
                    <span style="font-size: 9px; color: var(--text-muted)">❌</span>
                  </div>
                  ${o.alerta ? `
                    <div style="color:#b91c1c; font-size:9.5px; font-weight:700; background:#fef2f2; border:1px solid #fee2e2; padding:4px 6px; border-radius:4px; margin-top:4px;">
                      ⚠️ ${o.alerta}
                    </div>
                  ` : ''}
                </li>
              `;
            }).join('')
          : '<li style="font-size:10px;color:var(--text-muted);list-style:none;">Sem carga</li>';

        const card = document.createElement('div');
        card.className = 'colab-card';
        card.setAttribute('ondragover', 'allowDrop(event)');
        card.setAttribute('ondragleave', 'dragLeave(event)');
        card.setAttribute('ondrop', `drop(event, ${c.colaborador_id}, '${dStr}')`);
        card.id = `card-${dStr}-${c.colaborador_id}`;

        const progressHtml = activeTab === 'MONTAGEM'
          ? `
            <div class="progress-wrapper">
              <div class="progress-label">
                <span>Carga Montagem:</span>
                <strong>${totalCargaExibida.toFixed(1)} / ${meta} pts</strong>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill ${exceeds ? 'excedido' : ''}" style="width: ${pct}%"></div>
              </div>
            </div>
          `
          : `
            <div class="progress-wrapper">
              <div class="progress-label">
                <span>Carga Cozinha (Preparos):</span>
                <strong>${totalCargaExibida.toFixed(1)} kg planejado</strong>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width: ${pct}%; background:#8b5cf6;"></div>
              </div>
            </div>
          `;

        card.innerHTML = `
          <div class="colab-header">
            <div style="display:flex; flex-direction:column;">
              <span class="colab-nome">${c.nome}</span>
              ${c.eh_novato ? '<span class="colab-novato-badge" style="width:fit-content;margin-top:2px;">Novato</span>' : ''}
            </div>
            <button onclick="imprimirFicha(${c.colaborador_id}, '${dStr}')" title="Imprimir Ficha de Trabalho" style="background:none; border:none; cursor:pointer; font-size:14px; padding:2px;">🖨️</button>
          </div>
          ${progressHtml}
          <ul class="legend-list">
            ${legendsHtml}
          </ul>
        `;

        colEl.appendChild(card);
      });
    });
  }

  // Aviso de Almoxarifado para Cozinha (Preparo)
  async function verificarMateriaPrimaOP(opId, elementId) {
      try {
          const res = await fetch(`${API}/producao/op/${opId}/impedimentos`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.tem_impedimentos) {
              const container = document.getElementById(elementId);
              if (container) {
                  const badge = document.createElement('div');
                  badge.style.color = '#b91c1c';
                  badge.style.background = '#fef2f2';
                  badge.style.border = '1px solid #fee2e2';
                  badge.style.fontSize = '9px';
                  badge.style.fontWeight = '700';
                  badge.style.padding = '4px 6px';
                  badge.style.borderRadius = '4px';
                  badge.style.marginTop = '4px';
                  badge.innerHTML = `⚠️ FALTAM NO ESTOQUE: ${data.impedimentos.map(i=>i.nome).join(', ')}`;
                  container.appendChild(badge);
              }
          }
      } catch (e) {
          console.error(e);
      }
  }

  // --- DRAG AND DROP HANDLERS ---
  function dragStart(ev, opId) {
    draggedOpId = opId;
    ev.dataTransfer.setData("text/plain", opId);
  }

  function allowDrop(ev) {
    ev.preventDefault();
    ev.currentTarget.classList.add('drag-over');
  }

  function dragLeave(ev) {
    ev.currentTarget.classList.remove('drag-over');
  }

  async function drop(ev, colabId, targetDateStr) {
    ev.preventDefault();
    ev.currentTarget.classList.remove('drag-over');

    const opId = parseInt(ev.dataTransfer.getData("text/plain") || draggedOpId, 10);
    if (!opId) return;

    atualizarLocalmenteOP(opId, colabId, targetDateStr);

    try {
      const res = await fetch(`${API}/producao/op/${opId}/agendar`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          data_programada: targetDateStr,
          colaborador_id: colabId
        })
      });

      if (!res.ok) throw new Error();
      toast(`OP-${String(opId).padStart(3, '0')} agendada com sucesso.`, 'success');
      await carregarTudo();
    } catch (err) {
      toast('Erro ao agendar OP no servidor.', 'error');
      await carregarTudo();
    }
  }

  function atualizarLocalmenteOP(opId, colabId, dateStr) {
    const op = totalOps.find(o => o.numero_op === opId);
    if (op) {
      op.data_programada = dateStr;
      op.colaborador_id = colabId;
    }
  }

  async function desagendarOP(opId) {
    try {
      const res = await fetch(`${API}/producao/op/${opId}/agendar`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          data_programada: null,
          colaborador_id: null
        })
      });
      if (!res.ok) throw new Error();
      toast(`OP-${String(opId).padStart(3, '0')} removida do agendamento.`, 'success');
      await carregarTudo();
    } catch {
      toast('Erro ao desagendar OP.', 'error');
    }
  }

  function imprimirFicha(colaboradorId, dataStr) {
    window.open(`ficha_trabalho.html?colaborador_id=${colaboradorId}&data=${dataStr}`, '_blank');
  }

  // --- SLIDE-OVER DE COMPRAS ---
  function abrirSlideOver() {
    document.getElementById('slide-over').classList.add('open');
    validarFaltasEstoque();
  }

  function fecharSlideOver() {
    document.getElementById('slide-over').classList.remove('open');
  }

  async function validarFaltasEstoque() {
    const datas = obterDatasSemanaUtil(dataReferencia);
    const startStr = formatarYYYYMMDD(datas[0]);
    const endStr = formatarYYYYMMDD(datas[4]);
    const body = document.getElementById('slide-over-body');
    const btnWA = document.getElementById('btn-whatsapp-compras');

    body.innerHTML = '<div style="text-align:center;padding:40px 10px;">Calculando necessidade líquida de compras...</div>';
    btnWA.style.display = 'none';

    try {
      const res = await fetch(`${API}/planejamento/validar-estoque?data_inicio=${startStr}&data_fim=${endStr}`);
      const data = await res.json();
      missingStockItems = data.itens || [];

      if (missingStockItems.length === 0) {
        body.innerHTML = `
          <div style="text-align: center; color: var(--green); padding: 40px 10px; font-weight:600">
            ✅ Estoques Suficientes!<br/>
            Nenhum insumo em falta no almoxarifado para esta semana.
          </div>
        `;
        return;
      }

      body.innerHTML = missingStockItems.map(item => `
        <div class="falta-card">
          <div class="falta-info">
            <span class="falta-nome">${item.nome}</span>
            <span class="falta-det">Tipo: ${item.tipo} | Estoque: ${item.estoque_atual} ${item.unidade}</span>
          </div>
          <div class="falta-qtd">Falta: ${item.falta} ${item.unidade}</div>
        </div>
      `).join('');

      btnWA.style.display = 'flex';
    } catch {
      body.innerHTML = '<div style="text-align:center;color:var(--red);padding:40px 10px;">Erro de conexão ao validar estoques.</div>';
    }
  }

  function enviarWhatsAppCompras() {
    if (missingStockItems.length === 0) return;

    const datas = obterDatasSemanaUtil(dataReferencia);
    const startStr = formatarDDMM(formatarYYYYMMDD(datas[0]));
    const endStr = formatarDDMM(formatarYYYYMMDD(datas[4]));

    let msg = `📋 *LISTA DE COMPRAS — ERP FÁBRICA*\n`;
    msg += `Demanda de Vendas e Produção: Semana de ${startStr} a ${endStr}\n\n`;
    msg += `Insumos em falta necessitando de compra imediata:\n`;

    missingStockItems.forEach(item => {
      msg += `• *${item.nome}*: necessita de mais *${item.falta} ${item.unidade}* (Demanda: ${item.demanda} / Estoque atual: ${item.estoque_atual})\n`;
    });

    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  }

  window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
