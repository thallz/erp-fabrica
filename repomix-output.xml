<file path="app-desktop/index.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ERP Fábrica | Versão Definitiva B2B</title>
    <style>
        :root { --primary: #2563eb; --success: #059669; --warning: #d97706; --danger: #dc2626; --bg: #f8fafc; --text: #1e293b; --border: #e2e8f0; --white: #ffffff; --modal-bg: rgba(15, 23, 42, 0.9); }
        body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--bg); color: var(--text); margin: 0; line-height: 1.5; }

        nav { background: var(--white); border-bottom: 1px solid var(--border); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .nav-links { display: flex; gap: 10px; flex-wrap: wrap; }
        .nav-links button { background: none; border: none; font-weight: 600; color: #64748b; cursor: pointer; padding: 10px 15px; transition: 0.3s; border-radius: 6px; }
        .nav-links button.active { color: var(--primary); background: #eff6ff; border-bottom: 2px solid var(--primary); }
        .btn-system { background: #1e293b; color: white; display: flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 6px; cursor: pointer; border: none; font-size: 0.9rem; }

        .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
        .section { display: none; }
        .section.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px; }
        h2 { margin: 0; font-size: 1.8rem; color: #0f172a; }
        .btn-group { display: flex; gap: 10px; flex-wrap: wrap; }
        button.btn-primary { background: var(--primary); color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        button.btn-config { background: #e2e8f0; color: #475569; border: none; padding: 10px; border-radius: 8px; cursor: pointer; transition: 0.2s; font-weight: bold; }

        .filter-bar { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 10px; border-bottom: 1px solid #f1f5f9; }
        .filter-btn { background: white; border: 1px solid var(--border); padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; color: #64748b; cursor: pointer; transition: 0.2s; white-space: nowrap; }
        .filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
        .card { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; transition: 0.3s; }
        .card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .card-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem; align-items: flex-start; }
        .card-tag { font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; background: #f1f5f9; color: #64748b; font-weight: normal; margin-top: 5px; display: inline-block; }
        .admin-table { width: 100%; font-size: 0.85rem; margin-top: auto; border-collapse: separate; border-spacing: 0; background: #f8fafc; border-radius: 8px; padding: 10px; }
        .admin-table td { padding: 4px 0; border-bottom: 1px dashed #e2e8f0; }
        .value-cell { text-align: right; font-weight: 600; }
        .status-good { color: var(--success); font-weight: bold; }
        .status-bad { color: var(--danger); font-weight: bold; }
        .card-actions { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); display: flex; gap: 10px; }
        .btn-card { flex: 1; padding: 8px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; font-size: 0.85rem; }
        .btn-edit { background: #f1f5f9; color: #334155; }
        .btn-del { background: #fee2e2; color: #ef4444; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--modal-bg); z-index: 100; backdrop-filter: blur(4px); align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal-content { background: white; width: 90%; max-width: 650px; border-radius: 16px; padding: 2rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); max-height: 90vh; overflow-y: auto; }
        .close-modal { float: right; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b; }
        .grid-form { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 1.5rem; }
        .input-group { display: flex; flex-direction: column; gap: 6px; }
        label { font-size: 0.85rem; font-weight: 600; color: #475569; }
        input, select { padding: 12px; border: 1px solid var(--border); border-radius: 8px; outline: none; }
        .temp-list { background: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px dashed #cbd5e1; margin-bottom: 1.5rem; }
        .cat-list-item { display: flex; justify-content: space-between; padding: 10px; border-bottom: 1px solid #eee; }
        .live-summary { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 15px; border-radius: 8px; font-weight: 600; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 15px; }
        .pack-area { background: #fff7ed; border: 1px solid #fed7aa; padding: 15px; border-radius: 8px; margin-bottom: 15px; }
        .op-card { border-left: 5px solid var(--warning); }
        .client-card { border-left: 5px solid var(--primary); }
        .api-status { font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; }
        .api-online { background: #dcfce7; color: #166534; }
        .api-offline { background: #fee2e2; color: #991b1b; }

        .module-nav { background: #0f172a; padding: 0 2rem; display: flex; gap: 0; }
        .module-nav button { background: none; border: none; color: #94a3b8; font-weight: 700; font-size: 0.95rem; padding: 14px 24px; cursor: pointer; border-bottom: 3px solid transparent; transition: 0.2s; }
        .module-nav button.active { color: white; border-bottom-color: var(--primary); background: rgba(37,99,235,0.15); }
        .modulo { display: none; }
        .modulo.active { display: block; }
        .sub-nav { background: var(--white); border-bottom: 1px solid var(--border); padding: 0.75rem 2rem; display: flex; gap: 8px; flex-wrap: wrap; }
        .sub-nav button { background: #f1f5f9; border: 1px solid var(--border); color: #475569; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem; }
        .sub-nav button.active { background: var(--primary); color: white; border-color: var(--primary); }
        .sub-section { display: none; }
        .sub-section.active { display: block; animation: fadeIn 0.3s ease; }
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .kpi-card { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
        .kpi-card .label { font-size: 0.8rem; color: #64748b; margin-bottom: 4px; }
        .kpi-card .value { font-size: 1.5rem; font-weight: 800; color: #0f172a; }
        .data-table-wrap { background: white; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        .data-table th { background: #f8fafc; text-align: left; padding: 12px 16px; font-weight: 700; color: #475569; border-bottom: 1px solid var(--border); }
        .data-table td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; }
        .data-table tr:hover td { background: #f8fafc; }
        .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
        .st-CRIADO { background: #e0e7ff; color: #3730a3; }
        .st-PRODUZINDO { background: #fef3c7; color: #b45309; }
        .st-FATURADO { background: #dbeafe; color: #1d4ed8; }
        .st-ENTREGUE { background: #dcfce7; color: #166534; }
        .pedido-card { border-left: 5px solid var(--primary); }

        @media print {
            nav, .module-nav, .sub-nav, .header-actions, .filter-bar, .modal-overlay, #modulo-comercial, #modulo-financeiro, #prod-materia, #prod-receitas, #prod-fabrica { display: none !important; }
            body { background: white; color: black; font-family: 'Times New Roman', serif; font-size: 12pt; }
            .container { max-width: 100%; margin: 0; padding: 0; }
            .section { display: block !important; }
            #prod-produtos::before { content: "Tabela de Preços"; display: block; font-size: 24px; font-weight: bold; text-align: center; margin-bottom: 20px; border-bottom: 2px solid black; }
            .cards-grid { display: block; }
            .card { border: none; border-bottom: 1px dashed #999; border-radius: 0; box-shadow: none; padding: 10px 0; margin: 0; page-break-inside: avoid; }
            .card-actions, .btn-group, button, .card-tag { display: none !important; }
            .admin-table { background: none; width: 100%; margin: 0; padding: 0; }
            .admin-table td { border: none; padding: 2px 0; font-size: 12pt; }
            .value-cell { font-weight: bold; color: black !important; text-align: right; }
            .hide-print { display: none !important; }
        }
    </style>
</head>
<body>

<nav>
    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 2rem; background:var(--white); border-bottom:1px solid var(--border);">
        <strong style="font-size:1.1rem; color:#0f172a;">ERP Fábrica de Salgados</strong>
        <div style="display:flex; gap:10px; align-items:center;">
            <span id="api-status" class="api-status api-offline">API offline</span>
            <button class="btn-system" onclick="abrirModalSistema()">💾 Backup</button>
        </div>
    </div>
    <div class="module-nav">
        <button onclick="mudarModulo('comercial')" id="mod-nav-comercial" class="active">Comercial</button>
        <button onclick="mudarModulo('producao')" id="mod-nav-producao">Produção</button>
        <button onclick="mudarModulo('financeiro')" id="mod-nav-financeiro">Financeiro</button>
    </div>
</nav>

<!-- MÓDULO COMERCIAL -->
<div id="modulo-comercial" class="modulo active">
    <div class="sub-nav">
        <button onclick="mudarSubAba('comercial','pedidos')" id="sub-comercial-pedidos" class="active">Pedidos</button>
        <button onclick="mudarSubAba('comercial','clientes')" id="sub-comercial-clientes">Clientes</button>
    </div>
    <div class="container">
        <section id="com-pedidos" class="sub-section active">
            <div class="header-actions">
                <h2>Pedidos de Venda</h2>
                <button class="btn-primary" onclick="abrirModalPedido()">+ Lançar Pedido</button>
            </div>
            <div id="grid-pedidos" class="data-table-wrap"></div>
        </section>
        <section id="com-clientes" class="sub-section">
            <div class="header-actions">
                <h2>Clientes B2B</h2>
                <button class="btn-primary" onclick="abrirModalCliente()">+ Novo Cliente</button>
            </div>
            <div id="grid-clientes" class="cards-grid"></div>
        </section>
    </div>
</div>

<!-- MÓDULO PRODUÇÃO -->
<div id="modulo-producao" class="modulo">
    <div class="sub-nav">
        <button onclick="mudarSubAba('producao','materia')" id="sub-producao-materia" class="active">Almoxarifado</button>
        <button onclick="mudarSubAba('producao','receitas')" id="sub-producao-receitas">Receitas</button>
        <button onclick="mudarSubAba('producao','produtos')" id="sub-producao-produtos">Produtos</button>
        <button onclick="mudarSubAba('producao','fabrica')" id="sub-producao-fabrica">Chão de Fábrica</button>
        <button onclick="mudarSubAba('producao','compras')" id="sub-producao-compras">Lista de Compras</button>
    </div>
    <div class="container">
        <section id="prod-materia" class="sub-section active">
            <div class="header-actions">
                <h2>Almoxarifado</h2>
                <div class="btn-group">
                    <button class="btn-config" onclick="abrirGestorCategorias('materia')">⚙️ Categorias</button>
                    <button class="btn-primary" onclick="abrirModalMateria()">+ Novo Insumo</button>
                </div>
            </div>
            <div id="filter-materia" class="filter-bar"></div>
            <div id="grid-materias" class="cards-grid"></div>
        </section>
        <section id="prod-receitas" class="sub-section">
            <div class="header-actions">
                <h2>Receitas (Massas/Recheios)</h2>
                <div class="btn-group">
                    <button class="btn-config" onclick="abrirGestorCategorias('receita')">⚙️ Categorias</button>
                    <button class="btn-primary" onclick="abrirModalReceita()">+ Nova Receita</button>
                </div>
            </div>
            <div id="filter-receita" class="filter-bar"></div>
            <div id="grid-receitas" class="cards-grid"></div>
        </section>
        <section id="prod-produtos" class="sub-section">
            <div class="header-actions">
                <h2>Engenharia de Produtos</h2>
                <div class="btn-group">
                    <button class="btn-config" onclick="window.print()">🖨️ Imprimir Tabela</button>
                    <button class="btn-config" onclick="abrirGestorCategorias('produto')">⚙️ Categorias</button>
                    <button class="btn-primary" onclick="abrirModalProduto()">+ Novo Produto</button>
                </div>
            </div>
            <div id="filter-produto" class="filter-bar"></div>
            <div id="grid-produtos" class="cards-grid"></div>
        </section>
        <section id="prod-fabrica" class="sub-section">
            <div class="header-actions">
                <h2>Fila de Produção</h2>
                <div class="btn-group">
                    <button class="btn-config" onclick="window.open('calculadora.html','_blank')">🧮 Calculadora Completa</button>
                    <button class="btn-primary" onclick="abrirModalNovaOP()">+ Lançar OP</button>
                </div>
            </div>
            <div id="grid-producao" class="cards-grid"></div>
        </section>
        <section id="prod-compras" class="sub-section">
            <div class="header-actions">
                <h2>MRP — Necessidade de Compras</h2>
                <div class="btn-group">
                    <select id="mrp-margem" onchange="carregarNecessidadeCompras()" style="padding:10px; border-radius:8px; border:1px solid var(--border);">
                        <option value="0">Margem 0%</option>
                        <option value="0.05" selected>Margem 5%</option>
                        <option value="0.10">Margem 10%</option>
                    </select>
                    <button class="btn-config" onclick="carregarNecessidadeCompras()">🔄 Atualizar</button>
                    <button class="btn-config" onclick="enviarWhatsAppCompras()">📱 WhatsApp</button>
                    <button class="btn-config" onclick="window.print()">🖨️ Imprimir</button>
                </div>
            </div>
            <div id="mrp-avisos" style="margin-bottom:15px;"></div>
            <div id="grid-compras" class="data-table-wrap"></div>
        </section>
    </div>
</div>

<!-- MÓDULO FINANCEIRO -->
<div id="modulo-financeiro" class="modulo">
    <div class="sub-nav">
        <button onclick="mudarSubAba('financeiro','dashboard')" id="sub-financeiro-dashboard" class="active">Visão Geral</button>
        <button onclick="mudarSubAba('financeiro','receber')" id="sub-financeiro-receber">Contas a Receber</button>
    </div>
    <div class="container">
        <section id="fin-dashboard" class="sub-section active">
            <div class="header-actions"><h2>Indicadores Financeiros</h2></div>
            <div id="kpi-financeiro" class="kpi-grid"></div>
            <div id="grid-status-pedidos" class="data-table-wrap"></div>
        </section>
        <section id="fin-receber" class="sub-section">
            <div class="header-actions"><h2>Contas a Receber</h2></div>
            <div id="grid-contas-receber" class="data-table-wrap"></div>
        </section>
    </div>
</div>

<!-- MODAL BACKUP -->
<div id="modal-sistema" class="modal-overlay">
    <div class="modal-content" style="text-align:center;">
        <button class="close-modal" onclick="fecharModais()">&times;</button>
        <h3>Backup e Segurança</h3>
        <div style="display:grid; gap:15px; margin-top:20px;">
            <div style="background:#f0f9ff; padding:20px; border-radius:10px; border:1px solid #bae6fd;">
                <h4>1. Salvar Dados Locais</h4>
                <p style="font-size:0.85rem; color:#64748b;">Receitas, categorias e fichas técnicas detalhadas</p>
                <button class="btn-primary" onclick="baixarBackup()">⬇️ Baixar Arquivo</button>
            </div>
            <div style="background:#fff7ed; padding:20px; border-radius:10px; border:1px solid #fed7aa;">
                <h4>2. Importar Backup (.json)</h4>
                <p style="font-size:0.8rem; color:#64748b;">Aceita backup do Sistema Fábrica (navegador) ou do ERP</p>
                <input type="file" id="file-upload" accept=".json" style="margin-bottom:10px; width:100%;">
                <button class="btn-config" style="background:#d97706; color:white; width:100%; margin-bottom:10px;" onclick="restaurarBackup()">⬆️ Carregar Arquivo JSON</button>
                <button class="btn-primary" style="width:100%;" onclick="importarDoLocalStorageNavegador()">🌐 Importar do localStorage (só no navegador)</button>
                <p style="font-size:0.75rem; color:#92400e; margin-top:8px;">No Electron: exporte o .json no Chrome onde rodava o Sistema Fábrica e use "Carregar Arquivo".</p>
                <p id="import-status" style="font-size:0.8rem; color:#64748b; margin-top:10px;"></p>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CATEGORIAS -->
<div id="modal-categorias" class="modal-overlay">
    <div class="modal-content">
        <button class="close-modal" onclick="fecharModais()">&times;</button>
        <h3 id="titulo-gestor-cat">Categorias</h3>
        <input type="hidden" id="tipo-gestao-atual">
        <div style="display:flex; gap:10px; margin-bottom:20px;">
            <input type="text" id="nova-cat-nome" placeholder="Nome..." style="flex:1; padding:8px; border:1px solid #ccc; border-radius:4px;">
            <button onclick="adicionarCategoria()" class="btn-primary">Adicionar</button>
        </div>
        <div id="lista-categorias-existentes" style="max-height:300px; overflow-y:auto;"></div>
    </div>
</div>

<!-- MODAL INSUMO -->
<div id="modal-materia" class="modal-overlay">
    <div class="modal-content">
        <button class="close-modal" onclick="fecharModais()">&times;</button>
        <h3>Cadastro de Insumo</h3>
        <input type="hidden" id="edit-mat-id">
        <div class="grid-form">
            <div class="input-group"><label>Tipo</label><select id="mat-tipo" onchange="atualizarLabelPeso()"><option value="kg">Peso (Kg)</option><option value="un">Unidade (Un)</option></select></div>
            <div class="input-group"><label>Categoria</label><select id="mat-categoria"></select></div>
        </div>
        <div class="input-group" style="margin-bottom:15px;"><label>Nome</label><input type="text" id="mat-nome"></div>
        <div class="grid-form">
            <div class="input-group"><label>Preço Pago (R$)</label><input type="number" id="mat-preco" step="0.01"></div>
            <div class="input-group"><label id="lbl-mat-qtd">Peso TOTAL da Embalagem (g)</label><input type="number" id="mat-qtd" placeholder="ex: 1000 para 1kg"></div>
        </div>
        <small style="color:#d97706; display:block; margin-top:-10px; margin-bottom:10px;">* Se comprou 1Kg, digite 1000g. Se comprou 500g, digite 500.</small>
        <button class="btn-primary" style="width:100%" onclick="salvarMateria()">Gravar no Banco</button>
    </div>
</div>

<!-- MODAL RECEITA -->
<div id="modal-receita" class="modal-overlay">
    <div class="modal-content">
        <button class="close-modal" onclick="fecharModais()">&times;</button>
        <h3>Receita</h3>
        <input type="hidden" id="edit-rec-id">
        <div class="grid-form">
            <div class="input-group"><label>Nome da Receita</label><input type="text" id="rec-nome"></div>
            <div class="input-group"><label>Categoria</label><select id="rec-categoria"></select></div>
        </div>
        <div style="background:#f1f5f9; padding:15px; border-radius:8px; margin-bottom:15px;">
            <label style="font-size:0.8rem; font-weight:bold; margin-bottom:5px; display:block;">Adicionar Ingrediente:</label>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <select id="rec-tipo-origem" style="flex:1; min-width:120px;" onchange="atualizarSelectReceita()"><option value="materia">Matéria-Prima</option><option value="receita">Pré-Preparo</option></select>
                <select id="rec-select" style="flex:2; min-width:150px;"></select>
                <input type="number" id="rec-qtd" placeholder="Gramas" style="flex:1; min-width:80px;">
                <button onclick="addTempRec()" style="background:var(--primary); color:white; border:none; padding:10px 15px; border-radius:6px; cursor:pointer;">+</button>
            </div>
        </div>
        <div id="lista-temp-rec" class="temp-list"></div>
        <button class="btn-primary" style="width:100%" onclick="salvarReceita()">Salvar Receita</button>
    </div>
</div>

<!-- MODAL PRODUTO -->
<div id="modal-produto" class="modal-overlay">
    <div class="modal-content">
        <button class="close-modal" onclick="fecharModais()">&times;</button>
        <h3>Produto Final e Precificação</h3>
        <input type="hidden" id="edit-prod-id">
        <div class="grid-form">
            <div class="input-group"><label>Nome do Produto</label><input type="text" id="prod-nome"></div>
            <div class="input-group"><label>Categoria</label><select id="prod-categoria"></select></div>
            <div class="input-group"><label>Impostos (%)</label><input type="number" id="prod-imposto" value="10" oninput="recalcularLive()"></div>
            <div class="input-group"><label>Preço de Venda (R$)</label><input type="number" id="prod-mercado"></div>
        </div>
        <div style="background:#f1f5f9; padding:15px; border-radius:8px; margin-bottom:15px;">
