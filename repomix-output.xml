<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Colaboradores — ERP Fabrica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/global.css" />
  <style>
    /* Grid de Cards de Colaboradores (320px minmax) */
    .colab-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }

    .colab-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 18px;
      display: flex; flex-direction: column; justify-content: space-between;
      transition: box-shadow .15s, transform .12s;
    }
    .colab-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .colab-card-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 8px;
    }

    .colab-title {
      font-size: 16.5px;
      font-weight: 800;
      color: var(--text-primary);
      margin-top: 4px;
      white-space: normal;
      word-wrap: break-word;
    }

    .colab-meta-box {
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 8px;
      padding: 10px 12px;
      margin: 12px 0;
      display: flex; justify-content: space-between; align-items: center;
    }
    .colab-meta-label { font-size: 12px; color: var(--text-secondary); }
    .colab-meta-val { font-size: 16px; font-weight: 800; color: var(--brand); }

    .colab-card-footer {
      display: flex; justify-content: flex-end; gap: 8px; align-items: center;
      border-top: 1px dashed var(--border-light);
      padding-top: 12px; margin-top: 4px;
    }

    /* =========== MODAL CENTRALIZADO =========== */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.5);
      z-index: 1100;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal-box {
      background: var(--surface);
      border-radius: 16px;
      box-shadow: var(--shadow-lg);
      width: 440px;
      max-width: calc(100vw - 32px);
      max-height: 90vh;
      display: flex; flex-direction: column;
      transform: translateY(12px) scale(.97);
      transition: transform .2s;
    }
    .modal-overlay.open .modal-box { transform: none; }

    .modal-header {
      padding: 20px 24px 14px;
      border-bottom: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-header h3 { font-size: 16.5px; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; }
    .modal-close {
      background: none; border: none; cursor: pointer;
      font-size: 20px; color: var(--text-muted);
      line-height: 1; padding: 2px 6px; border-radius: 4px;
      transition: background .12s;
    }
    .modal-close:hover { background: var(--bg); color: var(--text-primary); }

    .modal-body { padding: 20px 24px; overflow-y: auto; flex: 1; }
    .modal-footer {
      padding: 14px 24px 18px;
      border-top: 1px solid var(--border-light);
      display: flex; justify-content: flex-end; gap: 8px; align-items: center;
    }
  </style>
</head>
<body>

<div id="toast-container"></div>

<div class="erp-shell">

  <!-- MAIN (LARGURA TOTAL 100%) -->
  <div class="main-wrap">
    <!-- TOPBAR COM NAVEGAÇÃO -->
    <header class="topbar">
      <a href="colaboradores.html" class="topbar-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <span>ERP Fabrica</span>
      </a>
      <nav class="topbar-nav">
        <a href="almoxarifado.html">📦 Almoxarifado</a>
        <a href="receitas.html">👨🍳 Receitas</a>
        <a href="produtos.html">🍰 Produtos Finais</a>
        <a href="clientes.html">👥 Clientes</a>
        <a href="vendas.html">💰 Lançar Vendas</a>
        <a href="ordens_producao.html">🏭 Ordens de Produção</a>
        <a href="colaboradores.html" class="active">👤 Colaboradores</a>
        <a href="planejamento.html">📅 Planejamento</a>
      </nav>
      <div class="topbar-right">
        <span class="badge-online">● Online</span>
      </div>
    </header>

    <div class="page-content">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Gestão de Colaboradores</h1>
          <p>Cadastre sua equipe de produção e defina as metas diárias individuais para o Planejamento Maestro.</p>
        </div>
        <div class="page-header-actions">
          <div class="search-bar" style="width:260px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="input-busca" placeholder="Buscar colaborador..." oninput="filtrar()" />
          </div>
          <button class="btn btn-primary" onclick="openColaboradorModal()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Novo Colaborador
          </button>
        </div>
      </div>

      <!-- GRID DE CARDS -->
      <div class="colab-grid" id="colaboradores-grid">
        <p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
          <span class="spinner" style="display:inline-block;margin-right:8px"></span>
          Carregando colaboradores...
        </p>
      </div>

    </div>
  </div>
</div>

<!-- ==================== MODAL CENTRALIZADO DE COLABORADOR (440px) ==================== -->
<div class="modal-overlay" id="colab-modal-overlay" onclick="closeColaboradorModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="colab-modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
        Novo Colaborador
      </h3>
      <button class="modal-close" onclick="closeColaboradorModal()">✕</button>
    </div>

    <div class="modal-body">
      <form id="form-colaborador" onsubmit="salvarColaborador(event)">
        <input type="hidden" id="colab-id" />

        <div class="form-group">
          <label>Nome do Colaborador *</label>
          <input type="text" id="colab-nome" required placeholder="Ex: João Silva" />
        </div>

        <div class="form-row cols-2">
          <div class="form-group">
            <label>Meta Diária Individual (un) *</label>
            <input type="number" id="colab-meta" min="1" step="1" value="350" required placeholder="350" />
          </div>
          <div class="form-group">
            <label>Status *</label>
            <select id="colab-status" required>
              <option value="Ativo">Ativo</option>
              <option value="Inativo">Inativo</option>
            </select>
          </div>
        </div>

        <div class="form-group" style="display:flex;align-items:center;gap:8px;margin-top:8px">
          <input type="checkbox" id="colab-novato" style="width:auto;cursor:pointer" />
          <label for="colab-novato" style="margin:0;cursor:pointer;font-weight:500">Marcar como Novato (Perfil em treinamento)</label>
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="closeColaboradorModal()">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-colaborador').requestSubmit()">
        Salvar Colaborador
      </button>
    </div>
  </div>
</div>

<script>
  const API_COLABORADORES = 'http://localhost:3001/api/colaboradores';

  let todosColaboradores = [];

  /* ======================== TOAST & FORMATAÇÃO ======================== */
  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  /* ======================== MODAL CENTRALIZADO ======================== */
  function openColaboradorModal(id = null) {
    document.getElementById('form-colaborador').reset();
    document.getElementById('colab-id').value = '';
    document.getElementById('colab-meta').value = '350';
    document.getElementById('colab-status').value = 'Ativo';
    document.getElementById('colab-novato').checked = false;

    if (id) {
      const c = todosColaboradores.find(x => x.id === id);
      document.getElementById('colab-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg> Editar Colaborador`;
      document.getElementById('colab-id').value       = c.id;
      document.getElementById('colab-nome').value     = c.nome || '';
      document.getElementById('colab-meta').value     = c.meta_diaria_individual || c.meta_diaria || 350;
      document.getElementById('colab-status').value   = c.status || 'Ativo';
      document.getElementById('colab-novato').checked = Boolean(c.eh_novato);
    } else {
      document.getElementById('colab-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg> Novo Colaborador`;
    }

    document.getElementById('colab-modal-overlay').classList.add('open');
  }

  function closeColaboradorModal() {
    document.getElementById('colab-modal-overlay').classList.remove('open');
  }

  function closeColaboradorModalOnBackdrop(event) {
    if (event.target === document.getElementById('colab-modal-overlay')) closeColaboradorModal();
  }

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeColaboradorModal();
  });

  /* ======================== LOAD / RENDER ======================== */
  async function carregarColaboradores() {
    try {
      const res = await fetch(API_COLABORADORES);
      todosColaboradores = await res.json();
      renderizar(todosColaboradores);
    } catch {
      document.getElementById('colaboradores-grid').innerHTML =
        `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red)">
          ⚠️ Erro ao conectar com o servidor em localhost:3001
        </p>`;
    }
  }

  function renderizar(lista) {
    const grid = document.getElementById('colaboradores-grid');
    if (!lista.length) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
        Nenhum colaborador cadastrado. Clique em <strong>+ Novo Colaborador</strong> para começar.
      </p>`;
      return;
    }

    grid.innerHTML = lista.map(c => {
      const meta = parseInt(c.meta_diaria_individual || c.meta_diaria || 350, 10);
      const isAtivo = (c.status || 'Ativo') === 'Ativo';
      const statusBadge = isAtivo
        ? '<span class="badge badge-green">● Ativo</span>'
        : '<span class="badge badge-red">● Inativo</span>';
      
      const novatoBadge = c.eh_novato
        ? '<span class="badge badge-amber" style="margin-left:4px">🌱 Novato</span>'
        : '';

      return `
        <div class="colab-card">
          <div>
            <div class="colab-card-header">
              <div>
                ${statusBadge}
                ${novatoBadge}
              </div>
              <span class="badge badge-gray">#${c.id}</span>
            </div>

            <div class="colab-title">${c.nome}</div>

            <div class="colab-meta-box">
              <span class="colab-meta-label">Meta Diária Individual:</span>
              <span class="colab-meta-val">${meta} un/dia</span>
            </div>
          </div>

          <div class="colab-card-footer">
            <button class="btn btn-outline btn-sm" onclick="openColaboradorModal(${c.id})">Editar</button>
            <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"
              onclick="excluirColaborador(${c.id}, '${c.nome.replace(/'/g, "\\'")}')">Excluir</button>
          </div>
        </div>`;
    }).join('');
  }

  function filtrar() {
    const q = document.getElementById('input-busca').value.toLowerCase();
    renderizar(todosColaboradores.filter(c =>
      c.nome.toLowerCase().includes(q)
    ));
  }

  /* ======================== SAVE ======================== */
  async function salvarColaborador(e) {
    e.preventDefault();
    const id = document.getElementById('colab-id').value;
    const body = {
      nome:        document.getElementById('colab-nome').value.trim(),
      meta_diaria: parseInt(document.getElementById('colab-meta').value, 10) || 350,
      status:      document.getElementById('colab-status').value,
      eh_novato:   document.getElementById('colab-novato').checked
    };

    if (!body.nome) {
      showToast('O Nome é obrigatório.', 'error');
      return;
    }

    try {
      const res = id
        ? await fetch(`${API_COLABORADORES}/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })
        : await fetch(API_COLABORADORES, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });

      if (res.ok) {
        showToast(id ? '✅ Colaborador atualizado!' : '✅ Colaborador cadastrado!', 'success');
        closeColaboradorModal();
        carregarColaboradores();
      } else {
        const d = await res.json();
        showToast('Erro: ' + (d.erro || 'Desconhecido'), 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    }
  }

  /* ======================== DELETE ======================== */
  async function excluirColaborador(id, nome) {
    if (!confirm(`Excluir o colaborador "${nome}"? Esta ação não pode ser desfeita.`)) return;
    try {
      const res = await fetch(`${API_COLABORADORES}/${id}`, { method: 'DELETE' });
      if (res.ok) {
        showToast('🗑️ Colaborador removido.');
        carregarColaboradores();
      } else {
        const d = await res.json();
        showToast('Erro: ' + d.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarColaboradores;
</script>
</body>
</html>
</file>

