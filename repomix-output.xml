      <div id="ft-container" style="margin-bottom:12px;">
        <!-- Rows of insumos added dynamically -->
      </div>
      <button type="button" class="btn btn-outline" onclick="adicionarLinhaFT()" style="width:100%; border-style:dashed;">
        + Adicionar Item de Ficha Técnica
      </button>
    </form>
  </div>
  <div class="drawer-footer">
    <button class="btn btn-close" onclick="closeDrawer()">Cancelar</button>
    <button class="btn btn-primary" onclick="document.getElementById('form-produto').requestSubmit()">Salvar Produto</button>
  </div>
