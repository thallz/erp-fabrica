        try {
            const res = await fetch(`${API_URL}/producao/alocar`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ produto_id: prodId, quantidade_planejada: qtd })
            });
            if (res.ok) { await carregarTodosOsDados(); fecharModais(); }
        } catch (e) { alert('Erro.'); }
    }

