<div class="drawer-backdrop" id="drawer-backdrop" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <h2>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
      Criar OP Manual
    </h2>
    <p>Aloque uma nova necessidade de produção diretamente na fila.</p>
    <button class="drawer-close" onclick="closeDrawer()">&#10005;</button>
  </div>
  <div class="drawer-body">
    <form id="form-op" onsubmit="submitOP(event)">
      <div class="form-group">
        <label>Escolha o Produto Acabado <span style="color:var(--red)">*</span></label>
        <select id="f-produto-id" required>
          <option value="">Carregando produtos...</option>
        </select>
      </div>

      <div class="form-group">
        <label>Quantidade Planejada (unidades) <span style="color:var(--red)">*</span></label>
        <input type="number" id="f-quantidade" placeholder="Ex: 100" required min="1" />
      </div>
    </form>
  </div>
  <div class="drawer-footer">
    <button class="btn btn-close" onclick="closeDrawer()">Cancelar</button>
    <button class="btn btn-primary" onclick="document.getElementById('form-op').requestSubmit()">Alocar na Fila</button>
  </div>
</div>

<div id="toast-container"></div>

<script>
  const API = 'http://localhost:3001/api';
  let opsList = [];
  let produtos = [];

  function toast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }

  async function testConnection() {
    try {
      const res = await fetch(`${API}/status`);
      if (res.ok) {
        document.getElementById('api-status').textContent = 'API Online';
        document.getElementById('api-status').className = 'api-status api-online';
      }
    } catch {
      document.getElementById('api-status').textContent = 'Modo Offline';
      document.getElementById('api-status').className = 'api-status api-offline';
    }
  }

  async function loadProdutos() {
    try {
      const res = await fetch(`${API}/produtos`);
      if (!res.ok) throw new Error();
      produtos = await res.json();
      
      const select = document.getElementById('f-produto-id');
      if (produtos.length === 0) {
        select.innerHTML = '<option value="">Nenhum produto com ficha técnica cadastrada</option>';
        return;
      }

      select.innerHTML = '<option value="">Selecione...</option>' + 
        produtos.map(p => `<option value="${p.id}">${p.nome} (${p.categoria_producao || 'Geral'})</option>`).join('');
    } catch (e) {
      console.error(e);
      document.getElementById('f-produto-id').innerHTML = '<option value="">Erro ao carregar produtos</option>';
    }
  }

  async function loadOPs() {
    try {
      const res = await fetch(`${API}/producao/fila`);
      if (!res.ok) throw new Error();
      opsList = await res.json();
      renderOPs();
    } catch {
      toast('Erro ao obter fila de OPs do servidor.', 'error');
    }
  }

  function renderOPs() {
    const tbody = document.getElementById('op-tbody');
    const term = document.getElementById('op-search').value.toLowerCase().trim();

    const filtered = opsList.filter(o => {
      const nomeProd = (o.tipo_op === 'PREPARO' ? o.receita_nome : o.produto) || '';
      return nomeProd.toLowerCase().includes(term);
    });

    const totalFila = opsList.filter(o => o.status === 'FILA').length;
    const totalProd = opsList.filter(o => o.status === 'PRODUZINDO').length;

    document.getElementById('kpi-fila').textContent = totalFila;
    document.getElementById('kpi-produzindo').textContent = totalProd;
    document.getElementById('kpi-total').textContent = opsList.length;
    document.getElementById('footer-count').textContent = `Exibindo ${filtered.length} de ${opsList.length} ordens de produção`;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:var(--text-muted); padding:30px;">Nenhuma OP ativa na fila de trabalho.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(o => {
      const isPrep = o.tipo_op === 'PREPARO';
      const displayNome = isPrep ? (o.receita_nome || 'Receita Preparo') : o.produto;
      const displayUnidade = isPrep ? 'kg' : 'un';
      const statusClass = o.status === 'PRODUZINDO' ? 'badge-green' : 'badge-amber';
      
      let actionsHtml = '';
      if (o.status === 'FILA') {
        actionsHtml += `<button class="primary" onclick="alterarStatus(${o.numero_op}, 'PRODUZINDO')">Iniciar</button>`;
      } else if (o.status === 'PRODUZINDO') {
        actionsHtml += `<button class="green" onclick="alterarStatus(${o.numero_op}, 'CONCLUIDA')">Concluir</button>`;
      }
      actionsHtml += `<button class="red" onclick="excluirOP(${o.numero_op})">Excluir</button>`;

      const dataStr = o.data_programada ? o.data_programada.split('T')[0].split('-').reverse().join('/') : '—';
      const colabStr = o.colaborador_nome ? `${o.colaborador_nome}` : '—';

      return `
        <tr>
          <td><strong>OP-${String(o.numero_op).padStart(3, '0')}</strong></td>
          <td><span class="badge ${isPrep ? 'badge-purple' : 'badge-blue'}">${isPrep ? 'PREPARO' : 'MONTAGEM'}</span></td>
          <td><strong>${displayNome}</strong></td>
          <td><span style="font-weight:700;">${o.quantidade_planejada} ${displayUnidade}</span></td>
          <td><span style="font-size:12px;">📅 ${dataStr}<br/><span style="color:var(--text-muted)">👤 ${colabStr}</span></span></td>
          <td><span class="badge ${statusClass}">${o.status}</span></td>
          <td style="text-align:right">
            <div class="action-icons" style="justify-content:flex-end">
              ${actionsHtml}
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function filtrarOPs() {
    renderOPs();
  }

  function openDrawer() {
    document.getElementById('drawer-backdrop').classList.add('open');
    document.getElementById('drawer').classList.add('open');
  }

  function closeDrawer() {
    document.getElementById('drawer-backdrop').classList.remove('open');
    document.getElementById('drawer').classList.remove('open');
    document.getElementById('form-op').reset();
  }

  function openNovaOP() {
    loadProdutos();
    openDrawer();
  }

  async function submitOP(e) {
    e.preventDefault();
    const produto_id = document.getElementById('f-produto-id').value;
    const quantidade_planejada = document.getElementById('f-quantidade').value;

    try {
      const res = await fetch(`${API}/producao/alocar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ produto_id, quantidade_planejada })
      });

      const data = await res.json();
      if (!res.ok) {
        toast(`Erro: ${data.erro || 'Falha ao alocar OP'}`, 'error');
        return;
      }

      toast('OP alocada na fila com sucesso!', 'success');
      closeDrawer();
      await loadOPs();
    } catch {
      toast('Erro ao enviar dados para a API.', 'error');
    }
  }

  async function alterarStatus(id, novoStatus) {
    try {
      const res = await fetch(`${API}/producao/op/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: novoStatus })
      });

      const data = await res.json();
      if (!res.ok) {
        toast(`Impedimento: ${data.erro || 'Erro ao alterar status'}`, 'error');
        return;
      }

      toast(`OP atualizada para ${novoStatus}!`, 'success');
      await loadOPs();
    } catch {
      toast('Erro de rede ao atualizar status.', 'error');
    }
  }

  async function excluirOP(id) {
    if (!confirm('Deseja realmente excluir esta ordem de produção? Isso também excluirá preparos pendentes vinculados.')) return;
    try {
      const res = await fetch(`${API}/producao/op/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error();
      toast('Ordem de produção excluída!', 'success');
      await loadOPs();
    } catch {
      toast('Erro ao excluir OP.', 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    testConnection();
    loadOPs();
  });
</script>
</body>
</html>
