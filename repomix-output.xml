            <div class="chart-container">
              <canvas id="salesChart"></canvas>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2>Fila de Producao</h2>
            <p>Ordens de producao prioritarias</p>
          </div>
          <div class="card-body" style="padding-top:12px">
            <ul class="queue-list" id="queue-list">
              <li style="color:var(--text-muted);font-size:13px">Carregando...</li>
            </ul>
            <div style="margin-top:12px;text-align:center">
              <a href="producao.html" class="btn btn-outline btn-sm" style="width:100%;justify-content:center">Ver fila completa</a>
            </div>
          </div>
        </div>
      </div>

      <!-- SHORTCUTS + REPORTS -->
      <div class="dashboard-grid">
        <div class="card">
          <div class="card-header">
            <h2>Atalhos Operacionais</h2>
            <p>Acoes rapidas para produtividade</p>
          </div>
          <div class="card-body">
            <div class="shortcuts-grid">
              <a href="vendas.html" class="shortcut-btn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Lancar Pedido
              </a>
              <a href="vendas.html" class="shortcut-btn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                Novo Cliente
              </a>
              <a href="producao.html" class="shortcut-btn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Gerar OP
              </a>
            </div>
          </div>
        </div>

        <div class="card reports-card">
          <div class="card-header">
            <h2>Relatorios Rapidos</h2>
            <p>Exportacao instantanea de documentos</p>
          </div>
          <div class="card-body">
            <div class="form-group">
              <label>Periodo</label>
              <div class="period-input-wrap">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                01/05/2024 — 31/05/2024
              </div>
            </div>
            <button class="btn btn-primary" style="width:100%;justify-content:center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Gerar PDF Diario
            </button>
            <div class="legend-dots">
              <div class="legend-dot"><div class="dot" style="background:var(--green)"></div> Relatorio de Vendas</div>
              <div class="legend-dot"><div class="dot" style="background:var(--blue)"></div> Movimentacao Estoque</div>
              <div class="legend-dot"><div class="dot" style="background:var(--amber)"></div> Fluxo de Caixa</div>
            </div>
