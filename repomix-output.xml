<div id="toast-container"></div>

<script>
  const API = 'http://localhost:3001/api';
  let produtos = [];
  let insumos = [];

  function toast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  async function testConnection() {
    try {
      const res = await fetch(`${API}/status`);
      if (res.ok) {
        document.getElementById('api-status').textContent = 'API Online';
        document.getElementById('api-status').className = 'api-status api-online';
      }
    } catch {
      document.getElementById('api-status').textContent = 'Modo Offline';
      document.getElementById('api-status').className = 'api-status api-offline';
    }
  }

  async function loadInsumos() {
    try {
      const res = await fetch(`${API}/insumos`);
      if (res.ok) {
        insumos = await res.json();
      }
    } catch (e) {
      console.error(e);
    }
  }

  async function loadProdutos() {
    try {
      const res = await fetch(`${API}/produtos`);
      if (!res.ok) throw new Error();
      produtos = await res.json();
      renderProdutos();
    } catch {
      toast('Erro de conexão ao carregar produtos.', 'error');
    }
  }

  function renderProdutos() {
    const tbody = document.getElementById('prod-tbody');
    const term = document.getElementById('prod-search').value.toLowerCase().trim();
    
    const filtered = produtos.filter(p => p.nome.toLowerCase().includes(term));
    
    // Update KPIs
    const total = produtos.length;
    const fritos = produtos.filter(p => (p.categoria_producao || '').toLowerCase() === 'frito').length;
    const assados = produtos.filter(p => 
      (p.categoria_producao || '').toLowerCase() === 'assado' || 
      (p.categoria_producao || '').toLowerCase() === 'fermentado'
    ).length;

    document.getElementById('kpi-produtos').textContent = total;
    document.getElementById('kpi-fritos').textContent = fritos;
    document.getElementById('kpi-assados').textContent = assados;
    document.getElementById('footer-count').textContent = `Exibindo ${filtered.length} de ${produtos.length} produtos`;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:30px;">Nenhum produto cadastrado.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(p => {
      const catBadge = p.categoria_producao === 'Frito' ? 'badge-red' : 
                       (p.categoria_producao === 'Fermentado' ? 'badge-green' : 'badge-purple');

      return `
        <tr>
          <td>#${p.id}</td>
          <td><strong>${p.nome}</strong></td>
          <td><span class="badge ${catBadge}">${p.categoria_producao || 'Geral'}</span></td>
          <td><span style="font-weight:700;">${parseFloat(p.peso_produtividade || 1.0).toFixed(1)}</span></td>
          <td><strong>R$ ${parseFloat(p.preco_venda).toFixed(2)}</strong></td>
          <td style="text-align:right">
            <div class="action-icons" style="justify-content:flex-end">
              <button onclick="openEditarProduto(${p.id})" title="Editar">&#9998;</button>
              <button class="red" onclick="excluirProduto(${p.id})" title="Excluir">&#128465;</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function filtrarProdutos() {
    renderProdutos();
  }

  function openDrawer() {
    document.getElementById('drawer-backdrop').classList.add('open');
    document.getElementById('drawer').classList.add('open');
  }

  function closeDrawer() {
    document.getElementById('drawer-backdrop').classList.remove('open');
    document.getElementById('drawer').classList.remove('open');
    document.getElementById('form-produto').reset();
    document.getElementById('f-id').value = '';
    document.getElementById('ft-container').innerHTML = '';
  }

  function adicionarLinhaFT(insumoId = '', quantidade = '') {
    const container = document.getElementById('ft-container');
    const div = document.createElement('div');
    div.className = 'ft-row';
    
    let options = insumos.map(i => `<option value="${i.id}" ${i.id == insumoId ? 'selected' : ''}>${i.nome} (${i.unidade_medida})</option>`).join('');
    
    div.innerHTML = `
      <select class="ft-insumo-select" required>
        <option value="">Selecione o Insumo...</option>
        ${options}
      </select>
      <input type="number" class="ft-qtd-input" placeholder="Qtd" step="0.0001" min="0.0001" value="${quantidade}" required />
      <button type="button" onclick="this.parentElement.remove()">&#10005;</button>
    `;
    container.appendChild(div);
  }

  function openNovoProduto() {
    document.getElementById('drawer-title').textContent = 'Novo Produto';
    document.getElementById('drawer-subtitle').textContent = 'Cadastre um produto final e monte sua ficha técnica.';
    openDrawer();
    adicionarLinhaFT();
  }

  async function openEditarProduto(id) {
    const prod = produtos.find(p => p.id === id);
    if (!prod) return;

    document.getElementById('drawer-title').textContent = 'Editar Produto';
    document.getElementById('drawer-subtitle').textContent = `Editando ${prod.nome}`;
    
    document.getElementById('f-id').value = prod.id;
    document.getElementById('f-nome').value = prod.nome;
    document.getElementById('f-preco').value = prod.preco_venda;
    document.getElementById('f-categoria').value = prod.categoria_producao || 'Geral';
    document.getElementById('f-peso').value = prod.peso_produtividade || 1.0;

    // Load Ficha Técnica
    try {
      const res = await fetch(`${API}/produtos/${id}`);
      if (res.ok) {
        const fullProd = await res.json();
        const container = document.getElementById('ft-container');
        container.innerHTML = '';
        if (fullProd.ficha_tecnica && fullProd.ficha_tecnica.length > 0) {
          fullProd.ficha_tecnica.forEach(item => {
            adicionarLinhaFT(item.insumo_id, item.quantidade);
          });
        } else {
          adicionarLinhaFT();
        }
      }
    } catch (e) {
      adicionarLinhaFT();
    }

    openDrawer();
  }

  async function submitProduto(e) {
    e.preventDefault();
    const id = document.getElementById('f-id').value;
    const nome = document.getElementById('f-nome').value;
    const preco_venda = parseFloat(document.getElementById('f-preco').value);
    const categoria_producao = document.getElementById('f-categoria').value;
    const peso_produtividade = parseFloat(document.getElementById('f-peso').value);

    // Build Ficha Técnica array
    const rows = document.querySelectorAll('.ft-row');
    const ficha_tecnica = [];
    rows.forEach(row => {
      const insumo_id = parseInt(row.querySelector('.ft-insumo-select').value);
      const quantidade = parseFloat(row.querySelector('.ft-qtd-input').value);
      if (insumo_id && quantidade) {
        ficha_tecnica.push({ insumo_id, quantidade });
      }
    });

    const payload = {
      nome,
      preco_venda,
      cmv_estimado: 0.0,
      margem_contribuicao: 1.0,
      categoria_producao,
      peso_produtividade,
      ficha_tecnica
    };

    try {
      let res;
      if (id) {
        res = await fetch(`${API}/produtos/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } else {
        res = await fetch(`${API}/produtos`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }

      if (!res.ok) throw new Error();
      toast(id ? 'Produto atualizado!' : 'Produto cadastrado!', 'success');
      closeDrawer();
      await loadProdutos();
    } catch {
      toast('Erro ao salvar produto.', 'error');
    }
  }

  async function excluirProduto(id) {
    if (!confirm('Deseja realmente excluir este produto?')) return;
    try {
      const res = await fetch(`${API}/produtos/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error();
      toast('Produto excluído!', 'success');
      await loadProdutos();
    } catch {
      toast('Erro ao excluir produto.', 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', async () => {
    testConnection();
    await loadInsumos();
    await loadProdutos();
  });
</script>
</body>
</html>
</file>

