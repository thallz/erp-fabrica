              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- CHART + QUEUE -->
        <div class="dashboard-grid">
          <div class="card">
            <div class="card-header">
              <h2>Desempenho Semanal de Vendas</h2>
              <p>Volume financeiro processado nos ultimos 6 dias uteis</p>
            </div>
            <div class="card-body">
              <div class="chart-container">
                <canvas id="salesChart"></canvas>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <h2>Fila de Producao</h2>
              <p>Ordens de producao prioritarias</p>
            </div>
            <div class="card-body" style="padding-top:12px">
              <ul class="queue-list" id="queue-list">
                <li style="color:var(--text-muted);font-size:13px">Carregando...</li>
              </ul>
              <div style="margin-top:12px;text-align:center">
                <a href="producao.html" class="btn btn-outline btn-sm" style="width:100%;justify-content:center">Ver
                  fila completa</a>
              </div>
            </div>
          </div>
        </div>

        <!-- SHORTCUTS + REPORTS -->
        <div class="dashboard-grid">
          <div class="card">
            <div class="card-header">
              <h2>Atalhos Operacionais</h2>
              <p>Acoes rapidas para produtividade</p>
            </div>
            <div class="card-body">
              <div class="shortcuts-grid">
                <a href="vendas.html" class="shortcut-btn">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                  </svg>
                  Lancar Pedido
                </a>
                <a href="vendas.html" class="shortcut-btn">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="8.5" cy="7" r="4" />
                    <line x1="20" y1="8" x2="20" y2="14" />
                    <line x1="23" y1="11" x2="17" y2="11" />
                  </svg>
                  Novo Cliente
                </a>
                <a href="producao.html" class="shortcut-btn">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                  </svg>
                  Gerar OP
                </a>
              </div>
            </div>
          </div>

          <div class="card reports-card">
            <div class="card-header">
              <h2>Relatorios Rapidos</h2>
              <p>Exportacao instantanea de documentos</p>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label>Periodo</label>
                <div class="period-input-wrap">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  01/05/2024 — 31/05/2024
                </div>
              </div>
              <button class="btn btn-primary" style="width:100%;justify-content:center">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Gerar PDF Diario
              </button>
              <div class="legend-dots">
                <div class="legend-dot">
                  <div class="dot" style="background:var(--green)"></div> Relatorio de Vendas
                </div>
                <div class="legend-dot">
                  <div class="dot" style="background:var(--blue)"></div> Movimentacao Estoque
                </div>
                <div class="legend-dot">
                  <div class="dot" style="background:var(--amber)"></div> Fluxo de Caixa
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- FOOTER -->
      <footer class="site-footer">
        <span>&copy; 2024 ERP Fabrica — Todos os direitos reservados &nbsp;&nbsp;<span class="status-dot"></span>
          Sistema Online (Sincronizado)</span>
        <div class="footer-links">
          <a href="#">Suporte Tecnico</a>
          <a href="#">Documentacao</a>
          <span>IP: 192.168.1.15</span>
        </div>
      </footer>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container"></div>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    const API = 'http://localhost:3001/api';

    function fmtBRL(v) {
      return Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function toast(msg, type = '') {
      const el = document.createElement('div');
      el.className = 'toast ' + type;
      el.textContent = msg;
      document.getElementById('toast-container').appendChild(el);
      setTimeout(() => el.remove(), 3500);
    }

    // --- Chart ---
    let chart;
    function initChart(data) {
      const ctx = document.getElementById('salesChart').getContext('2d');
      if (chart) chart.destroy();
      chart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: data.labels,
          datasets: [{
            data: data.values,
            backgroundColor: '#5b4be3',
            borderRadius: 6,
            borderSkipped: false,
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: {
            legend: { display: false }, tooltip: {
              callbacks: { label: ctx => fmtBRL(ctx.raw) }
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11 } } },
            y: { grid: { color: '#f0f1f5' }, ticks: { font: { family: 'Inter', size: 11 }, callback: v => 'R$' + (v / 1000).toFixed(0) + 'k' } }
          }
        }
      });
    }

    // --- Queue render ---
    function renderQueue(ops) {
      const list = document.getElementById('queue-list');
      if (!ops || !ops.length) {
        list.innerHTML = '<li style="color:var(--text-muted);font-size:13px;padding:8px 0">Nenhuma OP na fila.</li>';
        return;
      }
      const statusMap = {
        'FILA': { label: 'Aguardando', cls: 'badge-amber' },
        'PRODUZINDO': { label: 'Em progresso', cls: 'badge-blue' },
        'CONCLUIDA': { label: 'Concluida', cls: 'badge-green' },
        'PAUSADA': { label: 'Pausada', cls: 'badge-gray' },
      };
      list.innerHTML = ops.slice(0, 6).map(op => {
        const s = statusMap[op.status] || { label: op.status, cls: 'badge-gray' };
        return `
        <li class="queue-item">
          <div class="queue-item-header">
            <span class="queue-item-op">OP-${String(op.id).padStart(3, '0')}</span>
            <span class="badge ${s.cls}" style="font-size:10px">${s.label}</span>
          </div>
          <div class="queue-item-title">${op.produto_nome || 'Produto #' + op.produto_id}</div>
          <div class="queue-item-sub">Qtd planejada: ${op.quantidade_planejada}</div>
        </li>`;
      }).join('');
    }

    // --- Load all dashboard data ---
    async function loadDashboard() {
      try {
        const [financeiro, ops] = await Promise.all([
          fetch(`${API}/financeiro/resumo`).then(r => r.json()),
          fetch(`${API}/producao/fila`).then(r => r.json()).catch(() => [])
        ]);

        document.getElementById('kpi-faturamento').textContent = fmtBRL(financeiro.faturamento_total);
        document.getElementById('kpi-pedidos-sub').textContent = `${financeiro.total_pedidos} pedidos realizados`;

        const produzindo = (financeiro.pedidos_por_status || []).find(s => s.status === 'PRODUZINDO');
        document.getElementById('kpi-producao').textContent = produzindo ? produzindo.quantidade : '0';
        document.getElementById('kpi-producao-sub').textContent = 'OPs para finalizar hoje';

        document.getElementById('kpi-receber').textContent = fmtBRL(financeiro.a_receber);
        document.getElementById('kpi-receber-sub').textContent = 'A receber de pedidos ativos';

        // Estoque critico — mock enquanto endpoint nao existe
        document.getElementById('kpi-critico').textContent = '—';

        renderQueue(ops);

        // Chart: últimos 6 dias baseado em pedidos_por_status mock
        const days = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sab'];
        const vals = [4500, 4800, 4600, 6000, 5800, 3100];
        initChart({ labels: days, values: vals });

      } catch (err) {
        console.error('[ERP] Dashboard error:', err);
        toast('Servidor offline — dados de demonstracao.', 'error');

        // Fallback demo
        document.getElementById('kpi-faturamento').textContent = 'R$ 12.450,00';
        document.getElementById('kpi-pedidos-sub').textContent = '14 pedidos realizados';
        document.getElementById('kpi-producao').textContent = '28';
        document.getElementById('kpi-producao-sub').textContent = '8 OPs para finalizar hoje';
        document.getElementById('kpi-receber').textContent = 'R$ 4.200,00';
        document.getElementById('kpi-receber-sub').textContent = '3 titulos com +15 dias';
        document.getElementById('kpi-critico').textContent = '12 itens';

        const demoOps = [
          { id: 1, status: 'PRODUZINDO', produto_nome: 'Metalurgica Silva', quantidade_planejada: 200 },
          { id: 3, status: 'FILA', produto_nome: 'Auto Pecas Central', quantidade_planejada: 80 },
          { id: 4, status: 'PRODUZINDO', produto_nome: 'Industrias Knorr', quantidade_planejada: 50 },
          { id: 7, status: 'FILA', produto_nome: 'Logistica Express', quantidade_planejada: 120 },
          { id: 9, status: 'FILA', produto_nome: 'Construtora Norte', quantidade_planejada: 60 },
        ];
        renderQueue(demoOps);
        initChart({ labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sab'], values: [4500, 4800, 4600, 6000, 5800, 3100] });
      }
    }

    document.addEventListener('DOMContentLoaded', loadDashboard);
    document.addEventListener('keydown', e => {
      if (e.altKey && e.key === 's') document.querySelector('.topbar-search').focus();
    });
  </script>
</body>

</html>
</file>

<file path="frontend/vendas.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lançar Vendas — ERP Fabrica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/global.css" />
  <style>
    /* ============ TABELA DE PEDIDOS ============ */
    .pedidos-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .pedidos-card table { width: 100%; border-collapse: collapse; }
    .pedidos-card thead th {
      background: var(--bg);
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .05em;
      color: var(--text-muted);
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-light);
      text-align: left;
    }
    .pedidos-card tbody tr {
      border-bottom: 1px solid var(--border-light);
      transition: background .12s;
    }
    .pedidos-card tbody tr:last-child { border-bottom: none; }
    .pedidos-card tbody tr:hover { background: var(--bg); }
    .pedidos-card tbody td {
      padding: 13px 16px;
      font-size: 13.5px;
      vertical-align: middle;
    }
    .pedido-id { font-weight: 700; color: var(--brand); font-size: 13px; }
    .pedido-cliente { font-weight: 600; }
    .pedido-valor { font-weight: 700; color: var(--text-primary); }

    /* Status badges */
    .badge-status {
      padding: 3px 10px; border-radius: 20px;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .04em;
    }
    .badge-status.criado    { background: var(--blue-bg);   color: var(--blue); }
    .badge-status.produzindo { background: var(--amber-bg); color: var(--amber); }
    .badge-status.faturado  { background: var(--brand-light); color: var(--brand); }
    .badge-status.entregue  { background: var(--green-bg);  color: var(--green); }
    .badge-status.cancelado { background: var(--red-bg);    color: var(--red); }

    /* ============ MODAL CENTRALIZADO ============ */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.5);
      z-index: 1100;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal-box {
      background: var(--surface);
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,.2);
      width: 680px;
      max-width: calc(100vw - 32px);
      max-height: 92vh;
      display: flex; flex-direction: column;
      transform: translateY(14px) scale(.97);
      transition: transform .22s cubic-bezier(.22,1,.36,1);
    }
    .modal-overlay.open .modal-box { transform: none; }

    .modal-header {
      padding: 22px 26px 16px;
      border-bottom: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-header h3 {
      font-size: 17px; font-weight: 700; margin: 0;
      display: flex; align-items: center; gap: 8px;
    }
    .modal-close {
      background: none; border: none; cursor: pointer;
      font-size: 20px; color: var(--text-muted);
      line-height: 1; padding: 3px 7px; border-radius: 6px;
      transition: background .12s;
    }
    .modal-close:hover { background: var(--bg); color: var(--text-primary); }

    .modal-body { padding: 22px 26px; overflow-y: auto; flex: 1; }
    .modal-footer {
      padding: 14px 26px 20px;
      border-top: 1px solid var(--border-light);
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .modal-footer-total {
      font-size: 15px; font-weight: 700; color: var(--text-primary);
    }
    .modal-footer-actions { display: flex; gap: 8px; }

    /* ============ LINHAS DE ITEM DO PEDIDO ============ */
    .item-rows { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }

    .item-row {
      display: grid;
      grid-template-columns: 1fr 80px 100px auto;
      gap: 8px; align-items: start;
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .item-row select,
    .item-row input { padding: 7px 10px; font-size: 13px; }

    .item-stock-hint {
      font-size: 11.5px; font-weight: 500;
      margin-top: 3px;
      padding: 2px 4px; border-radius: 4px;
      display: none;
    }
    .item-stock-hint.ok  { color: var(--green); display: block; }
    .item-stock-hint.warn { color: var(--amber); display: block; }

    .row-remove {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 20px; line-height: 1;
      transition: color .12s; padding: 4px;
    }
    .row-remove:hover { color: var(--red); }

    .btn-add-row {
      background: none; border: none; cursor: pointer;
      color: var(--brand); font-size: 12.5px; font-weight: 600;
      display: inline-flex; align-items: center; gap: 4px;
      margin-top: 10px; padding: 0;
    }
    .btn-add-row:hover { text-decoration: underline; }

    /* Seção do formulário */
    .form-section-header {
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .06em;
      color: var(--text-muted);
      margin: 18px 0 10px;
      display: flex; align-items: center; gap: 6px;
    }
    .form-section-header::after {
      content: ''; flex: 1; height: 1px; background: var(--border-light);
    }

    /* Resultado OP gerada */
    .op-alert {
      background: var(--amber-bg); border: 1px solid var(--amber-border);
      border-radius: 10px; padding: 12px 14px; margin-top: 14px;
      font-size: 13px; color: var(--amber);
    }
    .op-alert strong { display: block; margin-bottom: 4px; font-size: 13.5px; }
    .op-alert ul { margin: 4px 0 0 18px; }

    /* Filtros de status */
    .filter-pills {
      display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px;
    }
    .pill {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 20px; padding: 4px 14px;
      font-size: 12.5px; font-weight: 500; cursor: pointer;
      color: var(--text-secondary);
      transition: all .12s;
    }
    .pill.active, .pill:hover {
      background: var(--brand); color: #fff; border-color: var(--brand);
    }
  </style>
</head>
<body>

<div id="toast-container"></div>

<div class="erp-shell">
  <div class="main-wrap">

    <!-- TOPBAR COM NAVEGAÇÃO -->
    <header class="topbar">
      <a href="vendas.html" class="topbar-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <span>ERP Fabrica</span>
      </a>
      <nav class="topbar-nav">
        <a href="almoxarifado.html">📦 Almoxarifado</a>
        <a href="receitas.html">👨🍳 Receitas</a>
        <a href="produtos.html">🍰 Produtos Finais</a>
        <a href="clientes.html">👥 Clientes</a>
        <a href="vendas.html" class="active">💰 Lançar Vendas</a>
        <a href="ordens_producao.html">🏭 Produção</a>
        <a href="colaboradores.html">👤 Colaboradores</a>
        <a href="planejamento.html">📅 Planejamento</a>
      </nav>
      <div class="topbar-right">
        <span class="badge-online">● Online</span>
      </div>
    </header>

    <div class="page-content">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Pedidos de Venda</h1>
          <p>Lançamento de pedidos B2B com baixa automática de estoque e geração de OP.</p>
        </div>
        <div class="page-header-actions">
          <div class="search-bar" style="width:260px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="input-busca" placeholder="Buscar cliente ou #pedido..." oninput="filtrar()" />
          </div>
          <button class="btn btn-primary" onclick="openPedidoModal()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Novo Pedido
          </button>
        </div>
      </div>

      <!-- FILTROS DE STATUS -->
      <div class="filter-pills">
        <span class="pill active" onclick="filtrarStatus('', this)">Todos</span>
        <span class="pill" onclick="filtrarStatus('CRIADO', this)">🔵 Criado</span>
        <span class="pill" onclick="filtrarStatus('PRODUZINDO', this)">🟡 Produzindo</span>
        <span class="pill" onclick="filtrarStatus('FATURADO', this)">🟣 Faturado</span>
        <span class="pill" onclick="filtrarStatus('ENTREGUE', this)">🟢 Entregue</span>
      </div>

      <!-- TABELA DE PEDIDOS -->
      <div class="pedidos-card">
        <table>
          <thead>
            <tr>
              <th style="width:70px">Pedido</th>
              <th>Cliente</th>
              <th>Data Entrega</th>
              <th>Itens</th>
              <th style="text-align:right">Valor Total</th>
              <th style="text-align:center">Status</th>
              <th style="text-align:center;width:120px">Ações</th>
            </tr>
          </thead>
          <tbody id="pedidos-tbody">
            <tr>
              <td colspan="7" style="text-align:center;padding:50px;color:var(--text-muted)">
                <div class="spinner" style="margin:0 auto 12px"></div>
                Carregando pedidos...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

<!-- ==================== MODAL CENTRALIZADO DE PEDIDO (680px) ==================== -->
<div class="modal-overlay" id="pedido-modal-overlay" onclick="closePedidoModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="pedido-modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="1" x2="12" y2="23"/>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
        Novo Pedido
      </h3>
      <button class="modal-close" onclick="closePedidoModal()">✕</button>
    </div>

    <div class="modal-body">
      <form id="form-pedido" onsubmit="salvarPedido(event)">

        <!-- CABEÇALHO DO PEDIDO -->
        <div class="form-row cols-2">
          <div class="form-group">
            <label>Cliente *</label>
            <select id="pedido-cliente" required>
              <option value="">Selecione o cliente...</option>
            </select>
          </div>
          <div class="form-group">
            <label>Data de Entrega *</label>
            <input type="date" id="pedido-data-entrega" required />
          </div>
        </div>

        <!-- ITENS DO PEDIDO -->
        <div class="form-section-header">🛒 Itens do Pedido</div>

        <div style="display:grid;grid-template-columns:1fr 80px 100px auto;gap:8px;padding:0 2px;margin-bottom:4px">
          <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase">Produto</span>
          <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase">Qtd (un)</span>
          <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase">Preço Unit.</span>
          <span></span>
        </div>

        <div class="item-rows" id="item-rows"></div>

        <button type="button" class="btn-add-row" onclick="adicionarLinhaItem()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Adicionar produto
        </button>

      </form>
    </div>

    <div class="modal-footer">
      <div class="modal-footer-total">
        Total: <span id="pedido-total">R$ 0,00</span>
      </div>
      <div class="modal-footer-actions">
        <button class="btn btn-outline" type="button" onclick="closePedidoModal()">Cancelar</button>
        <button class="btn btn-primary" type="button" onclick="document.getElementById('form-pedido').requestSubmit()">
          Lançar Pedido
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ==================== MODAL DE DETALHES DO PEDIDO ==================== -->
<div class="modal-overlay" id="detalhe-modal-overlay" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal-box" style="width:560px">
    <div class="modal-header">
      <h3 id="detalhe-modal-title">Detalhes do Pedido</h3>
      <button class="modal-close" onclick="document.getElementById('detalhe-modal-overlay').classList.remove('open')">✕</button>
    </div>
    <div class="modal-body" id="detalhe-modal-body">
      <!-- preenchido via JS -->
    </div>
    <div style="padding:14px 26px 20px;border-top:1px solid var(--border-light);display:flex;justify-content:space-between;align-items:center;gap:8px">
      <div style="display:flex;gap:8px">
        <select id="detalhe-status-select" style="padding:7px 10px;font-size:13px;border-radius:8px">
          <option value="CRIADO">Criado</option>
          <option value="PRODUZINDO">Produzindo</option>
          <option value="FATURADO">Faturado</option>
          <option value="ENTREGUE">Entregue</option>
          <option value="CANCELADO">Cancelado</option>
        </select>
        <button class="btn btn-outline" onclick="atualizarStatus()">Atualizar Status</button>
      </div>
      <button class="btn btn-outline" onclick="document.getElementById('detalhe-modal-overlay').classList.remove('open')">Fechar</button>
    </div>
  </div>
</div>

<script>
  const API_PEDIDOS  = 'http://localhost:3001/api/comercial/pedidos';
  const API_CLIENTES = 'http://localhost:3001/api/comercial/clientes';
  const API_PRODUTOS = 'http://localhost:3001/api/produtos';

  let todosPedidos  = [];
  let todosClientes = [];
  let todosProdutos = [];
  let filtroStatus  = '';
  let pedidoDetalheId = null;

  /* ======================== FORMATAÇÃO ======================== */
  function formatarDinheiro(valor) {
    const num = Number(valor || 0);
    return num.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  function formatarData(dataStr) {
    if (!dataStr) return '—';
    const d = new Date(dataStr);
    return d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
  }

  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }

  /* ======================== LOAD ======================== */
  async function carregarDados() {
    try {
      const [rPed, rCli, rPro] = await Promise.all([
        fetch(API_PEDIDOS),
        fetch(API_CLIENTES),
        fetch(API_PRODUTOS)
      ]);
      todosPedidos  = await rPed.json();
      todosClientes = await rCli.json();
      todosProdutos = await rPro.json();
      renderizarPedidos();
      popularClienteSelect();
    } catch {
      document.getElementById('pedidos-tbody').innerHTML =
        `<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--red)">
          ⚠️ Erro ao conectar com o servidor. Verifique se o backend está rodando na porta 3001.
        </td></tr>`;
    }
  }

  /* ======================== RENDER TABELA ======================== */
  function renderizarPedidos() {
    const busca = document.getElementById('input-busca').value.toLowerCase();
    const lista = todosPedidos.filter(p => {
      const matchStatus = !filtroStatus || p.status === filtroStatus;
      const matchBusca  = !busca ||
        p.razao_social.toLowerCase().includes(busca) ||
        String(p.id).includes(busca);
      return matchStatus && matchBusca;
    });

    const tbody = document.getElementById('pedidos-tbody');

    if (!lista.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:50px;color:var(--text-muted)">
        Nenhum pedido encontrado. Clique em <strong>+ Novo Pedido</strong> para começar.</td></tr>`;
      return;
    }

    tbody.innerHTML = lista.map(p => {
      const statusKey = (p.status || 'criado').toLowerCase();
      const statusLabel = {
        criado: '🔵 Criado', produzindo: '🟡 Produzindo',
        faturado: '🟣 Faturado', entregue: '🟢 Entregue', cancelado: '🔴 Cancelado'
      }[statusKey] || p.status;

      return `<tr>
        <td><span class="pedido-id">#${p.id}</span></td>
        <td><span class="pedido-cliente">${p.razao_social}</span></td>
        <td>${formatarData(p.data_entrega)}</td>
        <td><span class="badge badge-gray">${p.total_itens} produto(s)</span></td>
        <td style="text-align:right"><span class="pedido-valor">${formatarDinheiro(p.valor_total)}</span></td>
        <td style="text-align:center">
          <span class="badge-status ${statusKey}">${statusLabel}</span>
        </td>
        <td style="text-align:center">
          <button class="btn btn-outline btn-sm" onclick="abrirDetalhe(${p.id})">Detalhes</button>
        </td>
      </tr>`;
    }).join('');
  }

  function filtrar() { renderizarPedidos(); }

  function filtrarStatus(status, el) {
    filtroStatus = status;
    document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    renderizarPedidos();
  }

  /* ======================== POPULAR SELECTS ======================== */
  function popularClienteSelect(valorSelecionado = '') {
    const sel = document.getElementById('pedido-cliente');
    sel.innerHTML = '<option value="">Selecione o cliente...</option>';
    todosClientes.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id;
      opt.textContent = c.razao_social;
      if (c.id == valorSelecionado) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  /* ======================== MODAL DE PEDIDO ======================== */
  function openPedidoModal() {
    document.getElementById('form-pedido').reset();
    document.getElementById('item-rows').innerHTML = '';
    document.getElementById('pedido-total').textContent = 'R$ 0,00';
    popularClienteSelect();

    // Pré-selecionar data de hoje + 1 dia
    const amanha = new Date();
    amanha.setDate(amanha.getDate() + 1);
    document.getElementById('pedido-data-entrega').value = amanha.toISOString().split('T')[0];

    adicionarLinhaItem();

    document.getElementById('pedido-modal-overlay').classList.add('open');
  }

  function closePedidoModal() {
    document.getElementById('pedido-modal-overlay').classList.remove('open');
  }

  function closePedidoModalOnBackdrop(event) {
    if (event.target === document.getElementById('pedido-modal-overlay')) closePedidoModal();
  }

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePedidoModal(); }
  });

  /* ======================== LINHAS DE ITEM ======================== */
  function adicionarLinhaItem() {
    const container = document.getElementById('item-rows');
    const rowId = 'row-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6);
    const div = document.createElement('div');
    div.className = 'item-row'; div.id = rowId;

    let options = '<option value="">Selecione o produto...</option>';
    todosProdutos.forEach(p => {
      const estoque = parseInt(p.estoque_atual || 0);
      options += `<option value="${p.id}" data-preco="${p.preco_venda}" data-estoque="${estoque}">${p.nome} (Estoque: ${estoque} un)</option>`;
    });

    div.innerHTML = `
      <div>
        <select class="produto-select" required onchange="onProdutoChange('${rowId}')">
          ${options}
        </select>
        <div class="item-stock-hint" id="hint-${rowId}"></div>
      </div>
      <input type="number" class="qtd-input" min="1" step="1" value="1" placeholder="Qtd"
             required oninput="onQtdChange('${rowId}')" />
      <input type="number" class="preco-input" min="0" step="0.01" placeholder="R$"
             required oninput="recalcTotal()" />
      <button type="button" class="row-remove" onclick="removerLinha('${rowId}')">×</button>
    `;
    container.appendChild(div);
  }

  function removerLinha(rowId) {
    const el = document.getElementById(rowId);
    if (el) el.remove();
    recalcTotal();
  }

  function onProdutoChange(rowId) {
    const row    = document.getElementById(rowId);
    const select = row.querySelector('.produto-select');
    const opt    = select.options[select.selectedIndex];
    const preco  = opt ? parseFloat(opt.dataset.preco || 0) : 0;

    row.querySelector('.preco-input').value = preco ? preco.toFixed(2) : '';
    onQtdChange(rowId);
    recalcTotal();
  }

  function onQtdChange(rowId) {
    const row     = document.getElementById(rowId);
    const select  = row.querySelector('.produto-select');
    const opt     = select.options[select.selectedIndex];
    const estoque = opt ? parseInt(opt.dataset.estoque || 0) : 0;
    const qtd     = parseInt(row.querySelector('.qtd-input').value || 0);
    const hint    = document.getElementById('hint-' + rowId);

    if (!select.value || !qtd) { hint.className = 'item-stock-hint'; return; }

    if (qtd <= estoque) {
      hint.className = 'item-stock-hint ok';
      hint.textContent = `✅ Disponível em estoque (${estoque} un)`;
    } else {
      const falta = qtd - estoque;
      hint.className = 'item-stock-hint warn';
      hint.textContent = `⚠️ Estoque insuficiente: faltam ${falta} un — OP gerada automaticamente`;
    }
    recalcTotal();
  }

  function recalcTotal() {
    let total = 0;
    document.querySelectorAll('.item-row').forEach(row => {
      const qtd   = parseFloat(row.querySelector('.qtd-input').value || 0);
      const preco = parseFloat(row.querySelector('.preco-input').value || 0);
      total += qtd * preco;
    });
    document.getElementById('pedido-total').textContent = formatarDinheiro(total);
  }

  /* ======================== SALVAR PEDIDO ======================== */
  async function salvarPedido(e) {
    e.preventDefault();

    const clienteId   = document.getElementById('pedido-cliente').value;
    const dataEntrega = document.getElementById('pedido-data-entrega').value;
    const rows = document.querySelectorAll('.item-row');

    if (!clienteId) { showToast('Selecione um cliente.', 'error'); return; }
    if (!dataEntrega) { showToast('Informe a data de entrega.', 'error'); return; }
    if (!rows.length) { showToast('Adicione ao menos um produto.', 'error'); return; }

    const itens = [];
    for (const row of rows) {
      const prodId = row.querySelector('.produto-select').value;
      const qtd    = parseFloat(row.querySelector('.qtd-input').value);
      const preco  = parseFloat(row.querySelector('.preco-input').value);
      if (!prodId || !qtd || !preco) { showToast('Preencha todos os produtos corretamente.', 'error'); return; }
      itens.push({ produto_id: parseInt(prodId, 10), quantidade: qtd, preco_unitario: preco });
    }

    const body = { cliente_id: parseInt(clienteId, 10), data_entrega: dataEntrega, itens };

    const btn = document.querySelector('#pedido-modal-overlay .btn-primary');
    btn.disabled = true;
    btn.textContent = 'Salvando...';

    try {
      const res = await fetch(API_PEDIDOS, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      const data = await res.json();

      if (res.ok) {
        closePedidoModal();
        showToast(`✅ Pedido #${data.pedido_id} lançado com sucesso!`, 'success');

        if (data.ops_geradas && data.ops_geradas.length) {
          const opNomes = data.ops_geradas.map(op => `• ${op.produto} — ${op.quantidade_planejada} un`).join('\n');
          setTimeout(() => showToast(`🏭 ${data.ops_geradas.length} OP(s) gerada(s): ${data.ops_geradas.map(o => o.produto).join(', ')}`, ''), 500);
        }

        carregarDados();
      } else {
        showToast('Erro: ' + (data.erro || 'Desconhecido'), 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Lançar Pedido';
    }
  }

  /* ======================== DETALHE DO PEDIDO ======================== */
  async function abrirDetalhe(id) {
    pedidoDetalheId = id;
    const body = document.getElementById('detalhe-modal-body');
    body.innerHTML = `<div style="text-align:center;padding:30px"><div class="spinner" style="margin:0 auto"></div></div>`;
    document.getElementById('detalhe-modal-overlay').classList.add('open');

    try {
      const res  = await fetch(`${API_PEDIDOS}/${id}`);
      const data = await res.json();

      const statusKey = (data.status || 'criado').toLowerCase();
      document.getElementById('detalhe-modal-title').textContent = `Pedido #${data.id}`;
      document.getElementById('detalhe-status-select').value = data.status || 'CRIADO';

      body.innerHTML = `
        <div style="display:flex;gap:20px;margin-bottom:18px">
          <div>
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:2px">Cliente</div>
            <div style="font-weight:700">${data.razao_social}</div>
            <div style="font-size:12px;color:var(--text-secondary)">${data.cnpj || ''}</div>
          </div>
          <div>
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:2px">Entrega</div>
            <div style="font-weight:600">${formatarData(data.data_entrega)}</div>
          </div>
          <div>
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:2px">Status</div>
            <span class="badge-status ${statusKey}">${data.status}</span>
          </div>
        </div>

        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr>
              <th style="text-align:left;padding:8px 0;font-size:11px;text-transform:uppercase;color:var(--text-muted);border-bottom:1px solid var(--border-light)">Produto</th>
              <th style="text-align:center;padding:8px;font-size:11px;text-transform:uppercase;color:var(--text-muted);border-bottom:1px solid var(--border-light)">Qtd</th>
              <th style="text-align:right;padding:8px 0;font-size:11px;text-transform:uppercase;color:var(--text-muted);border-bottom:1px solid var(--border-light)">Preço Unit.</th>
              <th style="text-align:right;padding:8px 0;font-size:11px;text-transform:uppercase;color:var(--text-muted);border-bottom:1px solid var(--border-light)">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            ${(data.itens || []).map(it => `
              <tr style="border-bottom:1px solid var(--border-light)">
                <td style="padding:10px 0;font-weight:600">${it.produto_nome}</td>
                <td style="text-align:center;padding:10px">${it.quantidade}</td>
                <td style="text-align:right;padding:10px 0">${formatarDinheiro(it.preco_unitario)}</td>
                <td style="text-align:right;padding:10px 0;font-weight:700">${formatarDinheiro(it.quantidade * it.preco_unitario)}</td>
              </tr>`).join('')}
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" style="text-align:right;padding:14px 0;font-weight:700;font-size:14px">TOTAL:</td>
              <td style="text-align:right;padding:14px 0;font-weight:800;font-size:16px;color:var(--brand)">${formatarDinheiro(data.valor_total)}</td>
            </tr>
          </tfoot>
        </table>`;
    } catch {
      body.innerHTML = `<p style="color:var(--red);text-align:center;padding:20px">Erro ao carregar detalhes.</p>`;
    }
  }

  async function atualizarStatus() {
    const novoStatus = document.getElementById('detalhe-status-select').value;
    if (!pedidoDetalheId) return;

    try {
      const res = await fetch(`${API_PEDIDOS}/${pedidoDetalheId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: novoStatus })
      });
      if (res.ok) {
        showToast(`✅ Status atualizado para ${novoStatus}!`, 'success');
        document.getElementById('detalhe-modal-overlay').classList.remove('open');
        carregarDados();
      } else {
        const d = await res.json();
        showToast('Erro: ' + d.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarDados;
</script>
</body>
</html>
