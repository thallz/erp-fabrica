    .pill-tab.active, .pill-tab:hover {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
    }
    .pill-tab .count-badge {
      background: rgba(255,255,255,0.25);
      padding: 1px 7px;
      border-radius: 10px;
      font-size: 11px;
    }
    .pill-tab:not(.active) .count-badge {
      background: var(--bg);
      color: var(--text-secondary);
    }
  </style>
</head>
<body>

<div id="toast-container"></div>

<div class="erp-shell">
  <!-- MAIN (PÁGINA INTEIRA 100%) -->
  <div class="main-wrap">
    
    <!-- TOPBAR COM NAVEGAÇÃO -->
    <header class="topbar">
      <a href="ordens_producao.html" class="topbar-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <span>ERP Fabrica</span>
      </a>
      <nav class="topbar-nav">
        <a href="almoxarifado.html">📦 Almoxarifado</a>
        <a href="receitas.html">👨🍳 Receitas</a>
        <a href="produtos.html">🍰 Produtos Finais</a>
        <a href="clientes.html">👥 Clientes</a>
        <a href="vendas.html">💰 Lançar Vendas</a>
