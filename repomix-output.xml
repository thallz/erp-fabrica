      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    .detail-val {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }

    .batelada-config-row {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 24px;
    }

    .batelada-config-row label {
      font-weight: 700;
      font-size: 14px;
