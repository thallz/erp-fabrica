        <a href="colaboradores.html">👤 Colaboradores</a>
        <a href="planejamento.html">📅 Planejamento</a>
      </nav>
      <div class="topbar-right">
        <span class="badge-online">● Online</span>
      </div>
    </header>

    <div class="page-content">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Ordens de Produção (OPs)</h1>
          <p>Gerencie a esteira de produção. Finalizar uma OP envia o lote direto para a câmara fria.</p>
        </div>
        <div class="page-header-actions">
          <div class="search-bar" style="width:280px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="input-busca" placeholder="Buscar produto ou #OP..." oninput="filtrar()" />
          </div>
        </div>
      </div>

      <!-- TABS DE NAVEGAÇÃO DE STATUS -->
      <div class="filter-pills">
        <span class="pill-tab active" onclick="selecionarTab('FILA', this)">
          ⏳ Fila de Espera <span class="count-badge" id="count-fila">0</span>
        </span>
        <span class="pill-tab" onclick="selecionarTab('PRODUZINDO', this)">
          ⚙️ Em Produção <span class="count-badge" id="count-produzindo">0</span>
        </span>
        <span class="pill-tab" onclick="selecionarTab('CONCLUIDA', this)">
          ✅ Finalizadas <span class="count-badge" id="count-concluida">0</span>
        </span>
      </div>

      <!-- GRID DE CARDS DE OPS -->
      <div class="op-grid" id="op-grid">
        <p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
          <span class="spinner" style="display:inline-block;margin-right:8px"></span>
          Carregando ordens de produção...
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  const API_PRODUCAO = 'http://localhost:3001/api/producao';

  let todasOPs    = [];
  let tabAtiva    = 'FILA';

  /* ======================== TOAST & FORMATAÇÃO ======================== */
  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }

  function formatarData(dataStr) {
    if (!dataStr) return '—';
    const d = new Date(dataStr);
    return d.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
  }

  /* ======================== LOAD / RENDER ======================== */
  async function carregarOPs() {
    try {
      const res = await fetch(`${API_PRODUCAO}/fila`);
      todasOPs  = await res.json();
      atualizarContadores();
      renderizar();
    } catch {
      document.getElementById('op-grid').innerHTML =
        `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red)">
          ⚠️ Erro ao conectar com o servidor em localhost:3001
        </p>`;
    }
  }

  function atualizarContadores() {
    const countFila       = todasOPs.filter(o => o.status === 'FILA').length;
    const countProduzindo = todasOPs.filter(o => o.status === 'PRODUZINDO').length;
    const countConcluida  = todasOPs.filter(o => o.status === 'CONCLUIDA').length;

    document.getElementById('count-fila').textContent       = countFila;
    document.getElementById('count-produzindo').textContent = countProduzindo;
    document.getElementById('count-concluida').textContent  = countConcluida;
  }

  function selecionarTab(status, el) {
    tabAtiva = status;
    document.querySelectorAll('.pill-tab').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    renderizar();
  }

  function renderizar() {
    const busca = document.getElementById('input-busca').value.toLowerCase();
    const grid  = document.getElementById('op-grid');

    const lista = todasOPs.filter(o => {
      const matchTab   = o.status === tabAtiva;
      const opNumStr   = `#${String(o.numero_op || o.id).padStart(3, '0')}`;
      const matchBusca = !busca ||
        (o.produto || '').toLowerCase().includes(busca) ||
        opNumStr.toLowerCase().includes(busca) ||
        String(o.id).includes(busca);
      return matchTab && matchBusca;
    });

    if (!lista.length) {
      const msgVazio = {
        FILA: 'Nenhuma ordem de produção na fila de espera.',
        PRODUZINDO: 'Nenhuma ordem de produção em andamento.',
        CONCLUIDA: 'Nenhuma ordem de produção finalizada.'
      }[tabAtiva] || 'Nenhuma OP encontrada.';

      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;padding:50px;color:var(--text-muted)">
        ${msgVazio}
      </p>`;
      return;
    }

    grid.innerHTML = lista.map(o => {
      const opIdNum        = o.numero_op || o.id;
      const opNumFormatted = `#${String(opIdNum).padStart(3, '0')}`;
      const qtdStr         = `${parseFloat(o.quantidade_planejada || 0)} un`;
      const dataCriacao    = formatarData(o.criado_em);
      const statusKey      = (o.status || 'fila').toLowerCase();
      
      const statusBadge = {
        fila:       '<span class="op-badge fila">🟡 Fila de Espera</span>',
        produzindo: '<span class="op-badge produzindo">🔵 Em Produção</span>',
        concluida:  '<span class="op-badge concluida">🟢 Finalizada</span>'
      }[statusKey] || `<span class="op-badge">${o.status}</span>`;

      const tipoBadge = o.tipo_op === 'PREPARO'
        ? '<span class="op-badge" style="background:#f3e8ff;color:#7e22ce;border:1px solid #e9d5ff">🥣 PREPARO</span>'
        : '<span class="op-badge" style="background:#dbeafe;color:#1e40af;border:1px solid #bfdbfe">🛠️ MONTAGEM</span>';

      // Botão de ação
      let botaoAcao = '';
      if (o.status === 'FILA') {
        botaoAcao = `
          <button class="btn btn-primary btn-sm" onclick="iniciarProducao(${opIdNum})">
            ▶️ Iniciar Produção
          </button>`;
      } else if (o.status === 'PRODUZINDO') {
        botaoAcao = `
          <button class="btn btn-success btn-sm" style="background:var(--green);color:#fff;border:none" onclick="finalizarProducao(${opIdNum})">
            ✅ Finalizar e Enviar para Câmara Fria
          </button>`;
      } else if (o.status === 'CONCLUIDA') {
        botaoAcao = `<span style="font-size:12px;color:var(--green);font-weight:600">✓ Estoque Creditado</span>`;
      }

      return `
        <div class="op-card">
          <div>
            <div class="op-card-header">
              <div style="display:flex;gap:6px;align-items:center">
                <span class="op-number">${opNumFormatted}</span>
                ${tipoBadge}
              </div>
              ${statusBadge}
            </div>

            <div class="op-product-name">${o.produto || 'Produto sem nome'}</div>

            <div class="op-detail-box">
              <div class="op-detail-row">
                <span>Quantidade Solicitada:</span>
                <strong>${qtdStr}</strong>
              </div>
              <div class="op-detail-row">
                <span>Data de Criação:</span>
                <span>${dataCriacao}</span>
              </div>
              ${o.categoria_producao ? `
              <div class="op-detail-row">
                <span>Categoria:</span>
                <span>${o.categoria_producao}</span>
              </div>` : ''}
              ${o.estoque_camara_fria !== undefined ? `
              <div class="op-detail-row">
                <span>Estoque Atual:</span>
                <span>${parseFloat(o.estoque_camara_fria || 0)} un</span>
              </div>` : ''}
            </div>
          </div>

          <div class="op-card-footer">
            ${botaoAcao}
          </div>
        </div>`;
    }).join('');
  }

  function filtrar() {
    renderizar();
  }

  /* ======================== AÇÕES DA OP ======================== */
  async function iniciarProducao(opId) {
    if (!opId || opId === 'undefined' || isNaN(opId)) {
      console.error('Erro: ID da OP não definido:', opId);
      showToast('Erro: ID da OP inválido', 'error');
      return;
    }

    try {
      const res = await fetch(`${API_PRODUCAO}/op/${opId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'PRODUZINDO' })
      });
      const data = await res.json();

      if (res.ok && data.status !== 'erro') {
        showToast(`▶️ OP #${String(opId).padStart(3, '0')} em produção!`, 'success');
        carregarOPs();
      } else {
        showToast('Erro: ' + (data.erro || 'Não foi possível iniciar a produção.'), 'error');
      }
    } catch (err) {
      showToast('Erro de conexão com o servidor na porta 3001.', 'error');
    }
  }

  async function finalizarProducao(opId) {
    if (!opId || opId === 'undefined' || isNaN(opId)) {
      console.error('Erro: ID da OP não definido:', opId);
      showToast('Erro: ID da OP inválido', 'error');
      return;
    }

    if (!confirm(`Confirmar a finalização da OP #${String(opId).padStart(3, '0')} e enviar a produção para a câmara fria?`)) return;

    try {
      const res = await fetch(`${API_PRODUCAO}/op/${opId}/finalizar`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();

      if (res.ok && data.status !== 'erro') {
        showToast(`✅ OP #${String(opId).padStart(3, '0')} finalizada! Estoque de "${data.produto?.nome || 'produto'}" atualizado para ${data.produto?.estoque_atual} un.`, 'success');
        carregarOPs();
      } else {
        showToast('Erro: ' + (data.erro || 'Não foi possível finalizar a OP.'), 'error');
      }
    } catch (err) {
      showToast('Erro de conexão com o servidor na porta 3001.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarOPs;
</script>
</body>
</html>
