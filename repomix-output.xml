    async function carregarNecessidadeCompras(silencioso) {
        const grid = document.getElementById('grid-compras');
        const avisosEl = document.getElementById('mrp-avisos');
        if (!grid) return;
        if (!apiOnline) {
            grid.innerHTML = '<p style="padding:16px;color:#64748b">API offline.</p>';
            return;
        }
        const margem = document.getElementById('mrp-margem')?.value || '0';
        try {
            const res = await fetch(`${API_URL}/producao/necessidade-compras?margem=${margem}`);
            if (!res.ok) throw new Error();
            necessidadeCompras = await res.json();

            if (necessidadeCompras.avisos && necessidadeCompras.avisos.length) {
                avisosEl.innerHTML = necessidadeCompras.avisos.map(a =>
                    `<div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:10px;border-radius:8px;margin-bottom:8px;font-size:0.85rem;">⚠️ ${a}</div>`
                ).join('');
            } else {
                avisosEl.innerHTML = '';
            }

            const itens = necessidadeCompras.itens_comprar || [];
            if (!itens.length) {
                grid.innerHTML = `<p style="padding:20px;color:#64748b">Nenhuma compra necessária. ${necessidadeCompras.ops_na_fila || 0} OP(s) na fila — almoxarifado cobre a demanda.</p>`;
                textoWhatsAppCompras = '';
                return;
            }

            let total = 0;
            let linhas = '';
            itens.forEach(i => {
                total += i.custo_estimado;
                const qtdFmt = i.unidade_medida === 'kg' && i.quantidade_comprar < 1
                    ? (i.quantidade_comprar * 1000).toFixed(0) + ' g'
                    : i.quantidade_comprar.toFixed(i.unidade_medida === 'un' ? 0 : 3) + ' ' + i.unidade_medida;
                linhas += `<tr>
                    <td>${i.nome} <small style="color:#94a3b8">(${i.tipo})</small></td>
                    <td align="right">${i.demanda_total.toFixed(3)}</td>
                    <td align="right">${i.estoque_atual}</td>
                    <td align="right"><strong>${qtdFmt}</strong></td>
                    <td align="right">${formatarMoeda(i.custo_estimado)}</td>
                </tr>`;
            });

            grid.innerHTML = `<table class="data-table">
                <thead><tr>
                    <th>Insumo</th><th align="right">Demanda</th><th align="right">Estoque</th>
                    <th align="right">Comprar</th><th align="right">Custo Est.</th>
                </tr></thead>
                <tbody>${linhas}</tbody>
                <tfoot><tr style="font-weight:bold;background:#f8fafc;">
                    <td colspan="4" align="right">Total estimado</td>
                    <td align="right">${formatarMoeda(total)}</td>
                </tr></tfoot>
            </table>`;

            textoWhatsAppCompras = '🛒 *LISTA DE COMPRAS — ERP Fábrica*\n' +
                `OPs na fila: ${necessidadeCompras.ops_na_fila}\n\n` +
                itens.map(i => `• ${i.nome}: ${i.quantidade_comprar.toFixed(3)} ${i.unidade_medida}`).join('\n');
        } catch (e) {
            if (!silencioso) alert('Erro ao calcular necessidade de compras.');
            grid.innerHTML = '<p style="padding:16px;color:#ef4444">Erro ao carregar MRP.</p>';
        }
    }

    function enviarWhatsAppCompras() {
        if (!textoWhatsAppCompras) return alert('Nenhum item para comprar.');
        window.open('https://wa.me/?text=' + encodeURIComponent(textoWhatsAppCompras), '_blank');
    }

    async function salvarIntercorrencia() {
        const opId = document.getElementById('int-op-id').value;
        const cod = document.getElementById('int-codigo').value;
        const tempo = parseInt(document.getElementById('int-tempo').value);
        const obs = document.getElementById('int-obs').value;
        if (isNaN(tempo) || tempo <= 0) return alert('Informe o tempo de parada.');
        if (!apiOnline) return alert('API offline.');
        try {
            const res = await fetch(`${API_URL}/producao/intercorrencia`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ordem_producao_id: opId, codigo_intercorrencia: cod, tempo_parada_minutos: tempo, observacao: obs })
            });
            if (res.ok) { alert('Apontamento registrado!'); fecharModais(); }
        } catch (e) { alert('Erro.'); }
    }

    // --- MATEMÁTICA EM CASCATA ---
    function sincronizarNomes(tipo, idRef, novoNome) {
        receitas.forEach(rec => rec.itens.forEach(item => {
            if (item.tipoOrigem === tipo && String(item.idOrigem) === String(idRef)) item.nome = novoNome;
        }));
        produtos.forEach(prod => prod.itens.forEach(item => {
            if (item.tipoOrigem === tipo && String(item.idOrigem) === String(idRef)) item.nome = novoNome;
        }));
        const extras = getProdExtras();
        produtos.forEach(p => { if (p.itens) extras[p.id] = { ...extras[p.id], itens: p.itens }; });
        setProdExtras(extras);
        persistirReceitasNoBanco();
    }

    function recalcularCascata(salvarNoBanco) {
        const updateRec = (rec) => {
            let totalCusto = 0, totalPeso = 0;
            rec.itens.forEach(item => {
                let custo = 0;
                if (item.tipoOrigem === 'materia') {
                    const m = materias.find(x => String(x.id) === String(item.idOrigem));
                    if (m) custo = (m.custoPadrao / 1000) * item.g;
                } else {
                    const r = receitas.find(x => String(x.id) === String(item.idOrigem));
                    if (r) custo = (r.custoPorKg / 1000) * item.g;
                }
                item.custo = custo;
                totalCusto += custo;
                totalPeso += item.g;
            });
            rec.custo = totalCusto;
            rec.pesoTotal = totalPeso;
            rec.custoPorKg = totalPeso > 0 ? (totalCusto / totalPeso) * 1000 : 0;
        };
        receitas.forEach(updateRec);
        receitas.forEach(updateRec);

        produtos.forEach(p => {
            if (!p.itens || !p.itens.length) return;
            let custoItens = 0, peso = 0;
            p.itens.forEach(item => {
                let c = 0;
                if (item.tipoOrigem === 'receita') {
                    const r = receitas.find(rec => String(rec.id) === String(item.idOrigem));
                    if (r) c = (r.custoPorKg / 1000) * item.g;
                } else {
                    const m = materias.find(mat => String(mat.id) === String(item.idOrigem));
                    if (m) c = (m.custoPadrao / 1000) * item.g;
                }
                item.custo = c;
                custoItens += c;
                peso += item.g;
            });
            let ce = 0;
            if (p.embalagemId && p.embalagemCap > 0) {
                const e = materias.find(m => String(m.id) === String(p.embalagemId));
                if (e) ce = (e.tipo === 'un' ? e.custoPadrao : e.custoPadrao / 1000) / p.embalagemCap;
            }
            p.custo = custoItens + ce;
            p.peso = peso;
            const imp = p.imposto || 10;
            const margem = peso < 100 ? 0.60 : 0.50;
            const div = 1 - ((imp / 100) + margem);
            p.precoSugerido = p.custo / (div > 0 ? div : 0.1);
            p.precoMinimo = p.custo / (1 - (imp / 100));
            if (p.mercado > 0) {
                p.cmv = (p.custo / p.mercado) * 100;
                p.margem = (1 - (imp / 100) - (p.custo / p.mercado)) * 100;
            }
        });

        renderGrids();
        if (salvarNoBanco) persistirReceitasNoBanco();
    }

