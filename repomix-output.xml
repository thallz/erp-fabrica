        </div>

        <div class="form-group">
          <label>Nome do Insumo *</label>
          <input type="text" id="insumo-nome" required placeholder="Ex: Farinha de Trigo Tipo 1" />
        </div>

        <div class="form-row cols-2">
          <div class="form-group">
            <label>Preço Pago (R$) *</label>
            <input type="number" id="insumo-preco-pago" step="0.01" min="0.01" required placeholder="Ex: 25,00" oninput="calcularCustoReal()" />
          </div>
          <div class="form-group">
            <label id="label-peso-emb">Peso da Embalagem (g) *</label>
            <input type="number" id="insumo-peso-embalagem" step="1" min="1" required placeholder="Ex: 5000" oninput="calcularCustoReal()" />
          </div>
        </div>

        <div class="form-group">
          <label>Estoque Atual</label>
          <input type="number" id="insumo-estoque" min="0" step="0.001" value="0" placeholder="0" />
        </div>

        <!-- Custo calculado em tempo real -->
        <div class="calc-preview-box">
          <span>Custo Unitário Calculado:</span>
          <strong id="label-custo-calculado">R$ 0,00 / kg</strong>
        </div>

        <!-- Aviso Laranja -->
        <div class="alert-box-orange" id="aviso-embalagem">
          🍊 <strong>Importante:</strong> Se comprou 1kg, digite <strong>1000g</strong>. Se comprou 500g, digite <strong>500g</strong>. O sistema calcula o custo exato por quilo automaticamente.
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="closeInsumoModal()">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-insumo').requestSubmit()">
        Salvar Insumo
      </button>
    </div>
  </div>
</div>

<!-- MODAL CATEGORIAS -->
<div class="modal-overlay" id="cat-modal-overlay" onclick="closeCatModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="cat-modal-title">⚙️ Categorias de Insumo</h3>
      <button class="modal-close" onclick="closeCatModal()">✕</button>
    </div>
    <div class="modal-body">
      <ul class="cat-list" id="cat-list">
        <li class="cat-empty">Carregando...</li>
      </ul>
      <div class="cat-add-row">
        <input type="text" id="cat-nova-nome" placeholder="Nova categoria..." maxlength="50"
               onkeydown="if(event.key==='Enter'){event.preventDefault();adicionarCategoria();}" />
        <button class="btn btn-primary" type="button" onclick="adicionarCategoria()">+ Adicionar</button>
      </div>
    </div>
  </div>
</div>

<script>
  const API_INSUMOS    = 'http://localhost:3001/api/insumos';
  const API_CATEGORIAS = 'http://localhost:3001/api/categorias';

  let todosInsumos   = [];
  let catTipoAtivo   = 'INSUMO';

  /* ======================== FUNÇÕES PADRÃO DE FORMATAÇÃO ======================== */
  function formatarDinheiro(valor) {
    const num = Number(valor || 0);
    return num.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });
  }

  function formatarPeso(gramas) {
    const g = parseFloat(gramas || 0);
    if (g >= 1000) {
      const kg = g / 1000.0;
      return kg.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
    }
    return Math.round(g).toLocaleString('pt-BR') + 'g';
  }

  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  /* ======================== CATEGORIAS ======================== */
  async function carregarCategoriaSelect(tipo, selectId, valorSelecionado = '') {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Selecione...</option>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${tipo}`);
      const cats = await res.json();
      cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.nome;
        opt.textContent = c.nome;
        if (c.nome === valorSelecionado) opt.selected = true;
        select.appendChild(opt);
      });
    } catch {
      select.innerHTML = '<option value="">Erro ao carregar</option>';
    }
  }

  function openCatModal(tipo) {
    catTipoAtivo = tipo;
    document.getElementById('cat-modal-title').textContent =
      `⚙️ Categorias de ${tipo === 'INSUMO' ? 'Insumo' : tipo === 'RECEITA' ? 'Receita' : 'Produto'}`;
    document.getElementById('cat-nova-nome').value = '';
    document.getElementById('cat-modal-overlay').classList.add('open');
    renderCatList();
  }

  function closeCatModal() {
    document.getElementById('cat-modal-overlay').classList.remove('open');
    const selectId = 'insumo-categoria';
    const atual = document.getElementById(selectId).value;
    carregarCategoriaSelect(catTipoAtivo, selectId, atual);
  }

  function closeCatModalOnBackdrop(event) {
    if (event.target === document.getElementById('cat-modal-overlay')) closeCatModal();
  }

  async function renderCatList() {
    const ul = document.getElementById('cat-list');
    ul.innerHTML = '<li class="cat-empty">Carregando...</li>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${catTipoAtivo}`);
      const cats = await res.json();
      if (!cats.length) {
        ul.innerHTML = '<li class="cat-empty">Nenhuma categoria cadastrada.</li>';
        return;
      }
      ul.innerHTML = cats.map(c => `
        <li class="cat-item">
          <span>${c.nome}</span>
          <button class="cat-del" title="Excluir" onclick="excluirCategoria(${c.id})">×</button>
        </li>`).join('');
    } catch {
      ul.innerHTML = '<li class="cat-empty" style="color:var(--red)">Erro ao carregar.</li>';
    }
  }

  async function adicionarCategoria() {
    const nome = document.getElementById('cat-nova-nome').value.trim();
    if (!nome) { showToast('Digite um nome para a categoria.', 'error'); return; }

    try {
      const res = await fetch(API_CATEGORIAS, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, tipo: catTipoAtivo })
      });
      if (res.ok) {
        document.getElementById('cat-nova-nome').value = '';
        showToast(`✅ Categoria "${nome}" adicionada!`, 'success');
        renderCatList();
      } else {
        const d = await res.json();
        showToast(d.erro || 'Erro ao adicionar.', 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  async function excluirCategoria(id) {
    if (!confirm('Excluir esta categoria?')) return;
    try {
      const res = await fetch(`${API_CATEGORIAS}/${id}`, { method: 'DELETE' });
      if (res.ok) { showToast('🗑️ Categoria removida.'); renderCatList(); }
      else { const d = await res.json(); showToast(d.erro, 'error'); }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== MODAL CENTRALIZADO DE INSUMO ======================== */
  async function openInsumoModal(id = null) {
    const form = document.getElementById('form-insumo');
    form.reset();
    document.getElementById('insumo-id').value = '';
    document.getElementById('insumo-tipo-medida').value = 'Peso';
    document.getElementById('insumo-preco-pago').value = '';
    document.getElementById('insumo-peso-embalagem').value = '';
    document.getElementById('insumo-estoque').value = '0';

    atualizarCamposTipoMedida();
    await carregarCategoriaSelect('INSUMO', 'insumo-categoria');

    if (id) {
      const item = todosInsumos.find(i => i.id === id);
      document.getElementById('insumo-modal-title').textContent = '✏️ Editar Insumo';
      document.getElementById('insumo-id').value      = item.id;
      document.getElementById('insumo-nome').value    = item.nome;
      document.getElementById('insumo-tipo-medida').value = item.tipo_medida || (item.unidade_medida === 'un' ? 'Unidade' : 'Peso');
      
      atualizarCamposTipoMedida();

      const pPago = item.preco_pago ? parseFloat(item.preco_pago) : parseFloat(item.custo_unitario || 0);
      const pEmb  = item.peso_embalagem ? parseFloat(item.peso_embalagem) : (item.unidade_medida === 'un' ? 1 : 1000);

      document.getElementById('insumo-preco-pago').value = pPago || '';
      document.getElementById('insumo-peso-embalagem').value = pEmb || '';
      document.getElementById('insumo-estoque').value = parseFloat(item.estoque_atual || 0);

      const sel = document.getElementById('insumo-categoria');
      for (const opt of sel.options) {
        if (opt.value === item.categoria) { opt.selected = true; break; }
      }
    } else {
      document.getElementById('insumo-modal-title').textContent = '📦 Novo Insumo';
    }

    calcularCustoReal();
    document.getElementById('insumo-modal-overlay').classList.add('open');
  }

  function closeInsumoModal() {
    document.getElementById('insumo-modal-overlay').classList.remove('open');
  }

  function closeInsumoModalOnBackdrop(event) {
    if (event.target === document.getElementById('insumo-modal-overlay')) closeInsumoModal();
  }

  function atualizarCamposTipoMedida() {
    const tipo = document.getElementById('insumo-tipo-medida').value;
    const labelEmb = document.getElementById('label-peso-emb');
    const aviso = document.getElementById('aviso-embalagem');

    if (tipo === 'Peso') {
      labelEmb.textContent = 'Peso da Embalagem (g) *';
      document.getElementById('insumo-peso-embalagem').placeholder = 'Ex: 5000 (para 5kg)';
      aviso.innerHTML = '🍊 <strong>Importante:</strong> Se comprou 1kg, digite <strong>1000g</strong>. Se comprou 500g, digite <strong>500g</strong>. O sistema calcula o custo exato por quilo automaticamente.';
    } else {
      labelEmb.textContent = 'Quantidade da Embalagem (un) *';
      document.getElementById('insumo-peso-embalagem').placeholder = 'Ex: 1 ou 12';
      aviso.innerHTML = '📦 <strong>Importante:</strong> Digite a quantidade de unidades contidas no pacote/caixa comprada.';
    }
    calcularCustoReal();
  }

  function calcularCustoReal() {
    const tipo  = document.getElementById('insumo-tipo-medida').value;
    const preco = parseFloat(document.getElementById('insumo-preco-pago').value || 0);
    const emb   = parseFloat(document.getElementById('insumo-peso-embalagem').value || 0);
    const label = document.getElementById('label-custo-calculado');

    if (preco > 0 && emb > 0) {
      let custoUnit = 0;
      if (tipo === 'Peso') {
        custoUnit = (preco / emb) * 1000.0;
        label.textContent = `${formatarDinheiro(custoUnit)} / kg`;
      } else {
        custoUnit = preco / emb;
        label.textContent = `${formatarDinheiro(custoUnit)} / un`;
      }
    } else {
      label.textContent = tipo === 'Peso' ? 'R$ 0,00 / kg' : 'R$ 0,00 / un';
    }
  }

  /* ======================== LOAD / RENDER CARDS ======================== */
  async function carregarInsumos() {
    try {
      const res = await fetch(API_INSUMOS);
      todosInsumos = await res.json();
      renderizar(todosInsumos);
    } catch {
      document.getElementById('insumos-grid').innerHTML =
        `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red)">
          ⚠️ Erro ao conectar com o servidor.</p>`;
    }
  }

  function renderizar(lista) {
    const grid = document.getElementById('insumos-grid');
    if (!lista.length) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
        Nenhum insumo cadastrado. Clique em <strong>+ Novo Insumo</strong> para começar.</p>`;
      return;
    }

    grid.innerHTML = lista.map(i => {
      const custo    = formatarDinheiro(i.custo_unitario);
      const estoque  = parseFloat(i.estoque_atual || 0);
      const unidade  = i.unidade_medida || (i.tipo_medida === 'Unidade' ? 'un' : 'kg');
      const estoqueClass = estoque <= 0 ? 'badge-red' : estoque < 5 ? 'badge-amber' : 'badge-green';

      const pPago = i.preco_pago ? formatarDinheiro(i.preco_pago) : null;
      const pEmb  = i.peso_embalagem ? (i.tipo_medida === 'Unidade' ? `${Math.round(i.peso_embalagem)} un` : formatarPeso(i.peso_embalagem)) : null;
      
      const infoEmb = (pPago && pEmb) ? `Pacote: ${pPago} por ${pEmb}` : '';

      return `
        <div class="insumo-card">
          <div>
            <div class="insumo-card-header">
              <span class="badge badge-purple">${i.categoria || 'Outros'}</span>
              <span class="badge ${estoqueClass}">Estoque: ${estoque} ${unidade}</span>
            </div>
            <div class="insumo-title">${i.nome}</div>
            ${infoEmb ? `<div style="font-size:12px;color:var(--text-muted);margin-top:3px">${infoEmb}</div>` : ''}
          </div>

          <div class="insumo-price-box">
            <span class="insumo-price-label">Preço Calculado:</span>
            <span class="insumo-price-val">${custo} / ${unidade}</span>
          </div>

          <div class="insumo-card-footer">
            <button class="btn btn-entrada btn-sm"
              onclick="darEntradaInsumo(${i.id}, '${i.nome.replace(/'/g, "\\'")}', '${unidade}')">📥 Entrada</button>
            <button class="btn btn-outline btn-sm" onclick="openInsumoModal(${i.id})">Editar</button>
            <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"
              onclick="excluirInsumo(${i.id}, '${i.nome.replace(/'/g, "\\'")}')">Excluir</button>
          </div>
        </div>`;
    }).join('');
  }

  /* ======================== ENTRADA DE COMPRAS ======================== */
  async function darEntradaInsumo(id, nome, unidade) {
    const valor = prompt(`Quantos ${unidade === 'un' ? 'unidades' : 'quilos'} de "${nome}" chegaram do fornecedor?`);
    if (!valor) return;
    const qtd = parseFloat(valor.replace(',', '.'));
    if (isNaN(qtd) || qtd <= 0) {
      showToast('Digite uma quantidade válida maior que zero.', 'error');
      return;
    }

    try {
      const res = await fetch(`${API_INSUMOS}/${id}/entrada`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ quantidade: qtd })
      });
      const data = await res.json();
      if (res.ok) {
        showToast(`📥 Entrada de ${qtd} ${unidade} registrada para "${nome}"!`, 'success');
        carregarInsumos();
      } else {
        showToast('Erro: ' + (data.erro || 'Não foi possível registrar a entrada.'), 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    }
  }

  function filtrar() {
    const q = document.getElementById('input-busca').value.toLowerCase();
    renderizar(todosInsumos.filter(i =>
      i.nome.toLowerCase().includes(q) ||
      (i.categoria || '').toLowerCase().includes(q)
    ));
  }

  /* ======================== SAVE ======================== */
  async function salvarInsumo(e) {
    e.preventDefault();
    const id = document.getElementById('insumo-id').value;
    const tipo = document.getElementById('insumo-tipo-medida').value;
    const preco = parseFloat(document.getElementById('insumo-preco-pago').value || 0);
    const emb   = parseFloat(document.getElementById('insumo-peso-embalagem').value || 1);

    const custoCalc = tipo === 'Peso' ? (preco / emb) * 1000.0 : (preco / emb);
    const unidade   = tipo === 'Peso' ? 'kg' : 'un';

    const body = {
      nome:           document.getElementById('insumo-nome').value.trim(),
      categoria:      document.getElementById('insumo-categoria').value,
      unidade_medida: unidade,
      tipo_medida:    tipo,
      preco_pago:     preco,
      peso_embalagem: emb,
      custo_unitario: custoCalc,
      estoque_atual:  parseFloat(document.getElementById('insumo-estoque').value || 0)
    };

    try {
      const res = id
        ? await fetch(`${API_INSUMOS}/${id}`, { method: 'PUT',  headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        : await fetch(API_INSUMOS,             { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

      if (res.ok) {
        showToast(id ? '✅ Insumo atualizado!' : '✅ Insumo cadastrado com sucesso!', 'success');
        closeInsumoModal();
        carregarInsumos();
      } else {
        const d = await res.json();
        showToast('Erro ao salvar: ' + d.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== DELETE ======================== */
  async function excluirInsumo(id, nome) {
    if (!confirm(`Excluir "${nome}"? Esta ação não pode ser desfeita.`)) return;
    try {
      const res = await fetch(`${API_INSUMOS}/${id}`, { method: 'DELETE' });
      if (res.ok) {
        showToast('🗑️ Insumo removido.', '');
        carregarInsumos();
      } else {
        const d = await res.json();
        showToast('Erro: ' + d.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarInsumos;
</script>
</body>
</html>
</file>

<file path="frontend/receitas.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Receitas — ERP Fabrica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/global.css" />
  <style>
    /* Grid de Cards de Receita (Página Inteira - Maximizada) */
    .rec-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
    }
    .rec-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      padding: 18px;
      display: flex; flex-direction: column; justify-content: space-between;
      transition: box-shadow .15s, transform .12s;
    }
    .rec-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    .rec-card-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 8px;
    }
    
    .rec-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--text-primary);
      margin-top: 4px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      word-wrap: break-word;
      word-break: break-word;
    }
    
    .rec-meta { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }

    .rec-price-box {
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 8px;
      padding: 10px 12px;
      margin: 12px 0;
      display: flex; justify-content: space-between; align-items: center;
    }
    .rec-price-label { font-size: 12px; color: var(--text-secondary); }
    .rec-price-val { font-size: 16px; font-weight: 700; color: var(--brand); }

    .rec-card-footer {
      display: flex; justify-content: flex-end; gap: 8px; align-items: center;
      border-top: 1px dashed var(--border-light);
      padding-top: 12px; margin-top: 12px;
    }

    /* Quadro de Ingredientes com Borda Pontilhada (Dashed Box) */
    .dashed-table-box {
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 14px;
      background: var(--bg);
      margin-top: 10px;
    }

    .ingredient-rows { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
    
    .ingredient-row {
      display: grid;
      grid-template-columns: 85px 1fr 75px 95px 95px 28px;
      gap: 6px;
      align-items: center;
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: 8px;
      padding: 6px 8px;
    }
    .ingredient-row select,
    .ingredient-row input { padding: 6px 8px; font-size: 12.5px; }

    .val-cell { font-size: 12px; font-weight: 600; text-align: right; color: var(--text-primary); }
    .val-cell.total { color: var(--brand); font-weight: 700; }

    .row-remove {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 18px; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      transition: color .12s;
    }
    .row-remove:hover { color: var(--red); }

    .btn-add-row {
      background: none; border: none; cursor: pointer;
      color: var(--brand); font-size: 12.5px; font-weight: 600;
      display: inline-flex; align-items: center; gap: 4px;
      margin-top: 10px; padding: 0;
    }
    .btn-add-row:hover { text-decoration: underline; }

    /* Totais no Modal com Linha Azul em Destaque */
    .totals-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-top: 18px;
    }
    .totals-row {
      display: flex; justify-content: space-between;
      font-size: 13.5px; padding: 4px 0; color: var(--text-secondary);
    }
    .totals-row strong { color: var(--text-primary); font-weight: 700; }

    .price-kg-highlight {
      background: var(--brand-light);
      border: 1px solid var(--brand);
      border-radius: 8px;
      padding: 12px 14px;
      margin-top: 12px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .price-kg-highlight span { font-size: 13px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: 0.04em; }
    .price-kg-highlight strong { font-size: 17px; font-weight: 800; color: var(--brand); }

    .ingredient-chips {
      display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;
      max-height: none; overflow: visible;
    }
    .chip {
      font-size: 11.5px; padding: 3px 9px; border-radius: 20px;
      background: var(--brand-light); color: var(--brand); font-weight: 500;
    }
    .chip.sub { background: var(--amber-bg); color: var(--amber); }

    /* =========== MODAL CENTRALIZADO PADRONIZADO =========== */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,.5);
      z-index: 1100;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal-box {
      background: var(--surface);
      border-radius: 16px;
      box-shadow: var(--shadow-lg);
      width: 440px;
      max-width: calc(100vw - 32px);
      max-height: 90vh;
      display: flex; flex-direction: column;
      transform: translateY(12px) scale(.97);
      transition: transform .2s;
    }
    .modal-box.modal-lg {
      width: 650px;
    }
    .modal-overlay.open .modal-box { transform: none; }

    .modal-header {
      padding: 20px 24px 14px;
      border-bottom: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-header h3 { font-size: 16.5px; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; }
    .modal-close {
      background: none; border: none; cursor: pointer;
      font-size: 20px; color: var(--text-muted);
      line-height: 1; padding: 2px 6px; border-radius: 4px;
      transition: background .12s;
    }
    .modal-close:hover { background: var(--bg); color: var(--text-primary); }

    .modal-body { padding: 20px 24px; overflow-y: auto; flex: 1; }
    .modal-footer {
      padding: 14px 24px 18px;
      border-top: 1px solid var(--border-light);
      display: flex; justify-content: flex-end; gap: 8px; align-items: center;
    }

    .cat-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
    .cat-item {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 14px;
      font-size: 13.5px; font-weight: 500;
    }
    .cat-item .cat-del {
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 18px; line-height: 1;
      padding: 0 4px; border-radius: 4px; transition: color .12s;
    }
    .cat-item .cat-del:hover { color: var(--red); }

    .cat-add-row { display: flex; gap: 8px; margin-top: 14px; }
    .cat-add-row input { flex: 1; }
    .cat-empty { text-align: center; padding: 24px; color: var(--text-muted); font-size: 13px; }

    .field-with-action { display: flex; gap: 8px; align-items: center; }
    .field-with-action select { flex: 1; }
    .btn-gear {
      flex-shrink: 0;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 0 10px; height: 38px;
      cursor: pointer; font-size: 15px;
      display: flex; align-items: center; justify-content: center;
      transition: border-color .12s, background .12s;
      color: var(--text-secondary);
    }
    .btn-gear:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-light); }
  </style>
</head>
<body>

<div id="toast-container"></div>

<div class="erp-shell">

  <!-- MAIN (LARGURA TOTAL 100%) -->
  <div class="main-wrap">
    <!-- TOPBAR COM NAVEGAÇÃO -->
    <header class="topbar">
      <a href="receitas.html" class="topbar-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <span>ERP Fabrica</span>
      </a>
      <nav class="topbar-nav">
        <a href="almoxarifado.html">📦 Almoxarifado</a>
        <a href="receitas.html" class="active">👨🍳 Receitas</a>
        <a href="produtos.html">🍰 Produtos Finais</a>
        <a href="clientes.html">👥 Clientes</a>
        <a href="vendas.html">💰 Lançar Vendas</a>
        <a href="ordens_producao.html">🏭 Produção</a>
        <a href="colaboradores.html">👤 Colaboradores</a>
        <a href="planejamento.html">📅 Planejamento</a>
      </nav>
      <div class="topbar-right">
        <span class="badge-online">● Online</span>
      </div>
    </header>

    <div class="page-content">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Pré-Preparos e Receitas</h1>
          <p>Massas, recheios, molhos e temperos — com cálculo de custos em cascata.</p>
        </div>
        <div class="page-header-actions">
          <div class="search-bar" style="width:280px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="input-busca" placeholder="Buscar receita..." oninput="filtrar()" />
          </div>
          <button class="btn btn-primary" onclick="openReceitaModal()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nova Receita
          </button>
        </div>
      </div>

      <!-- GRID DE CARDS DE RECEITAS -->
      <div class="rec-grid" id="receitas-grid">
        <p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
          <span class="spinner" style="display:inline-block;margin-right:8px"></span>
          Carregando receitas...
        </p>
      </div>

    </div>
  </div>
</div>

<!-- ==================== MODAL CENTRALIZADO DE RECEITA (650px) ==================== -->
<div class="modal-overlay" id="receita-modal-overlay" onclick="closeReceitaModalOnBackdrop(event)">
  <div class="modal-box modal-lg">
    <div class="modal-header">
      <h3 id="receita-modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg> Nova Receita
      </h3>
      <button class="modal-close" onclick="closeReceitaModal()">✕</button>
    </div>

    <div class="modal-body">
      <form id="form-receita" onsubmit="salvarReceita(event)">
        <input type="hidden" id="receita-id" />

        <div class="form-row cols-2">
          <div class="form-group">
            <label>Nome da Receita *</label>
            <input type="text" id="receita-nome" required placeholder="Ex: Tempero de Carne" />
          </div>
          <div class="form-group">
            <label style="display:flex;align-items:center;justify-content:space-between">
              <span>Categoria *</span>
              <button type="button" class="btn-link" onclick="openCatModal('RECEITA')"
                style="font-size:11.5px;color:var(--brand);background:none;border:none;cursor:pointer;font-weight:600">
                ⚙️ Gerenciar
              </button>
            </label>
            <div class="field-with-action">
              <select id="receita-categoria" required>
                <option value="">Carregando...</option>
              </select>
              <button type="button" class="btn-gear" title="Gerenciar categorias" onclick="openCatModal('RECEITA')">⚙️</button>
            </div>
          </div>
        </div>

        <!-- Quadro de Ingredientes (Borda Pontilhada / Dashed Box) -->
        <div class="form-section-title">Composição da Batelada</div>
        
        <div class="dashed-table-box">
          <!-- Cabeçalho da Tabela -->
          <div style="display:grid;grid-template-columns:85px 1fr 75px 95px 95px 28px;gap:6px;padding:0 8px;margin-bottom:6px">
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em">Origem</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em">Item</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em">Peso (g)</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right">Unit. (Kg)</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right">Total</span>
            <span></span>
          </div>

          <div class="ingredient-rows" id="ingredient-rows"></div>

          <button type="button" class="btn-add-row" onclick="addIngredientRow()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Adicionar ingrediente
          </button>
        </div>

        <!-- Painel de Totais no Rodapé -->
        <div class="totals-panel">
          <div class="totals-row">
            <span>Peso total da batelada:</span>
            <strong id="total-peso">0g</strong>
          </div>
          <div class="totals-row">
            <span>Custo total da batelada:</span>
            <strong id="total-custo">R$ 0,00</strong>
          </div>

          <!-- Linha Azul de Destaque PREÇO POR KG -->
          <div class="price-kg-highlight">
            <span>PREÇO POR KG</span>
            <strong id="total-custo-kg">R$ 0,00 / kg</strong>
          </div>
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="closeReceitaModal()">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-receita').requestSubmit()">
        Salvar Receita
      </button>
    </div>
  </div>
</div>

<!-- MODAL CATEGORIAS -->
<div class="modal-overlay" id="cat-modal-overlay" onclick="closeCatModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="cat-modal-title">⚙️ Categorias de Receita</h3>
      <button class="modal-close" onclick="closeCatModal()">✕</button>
    </div>
    <div class="modal-body">
      <ul class="cat-list" id="cat-list">
        <li class="cat-empty">Carregando...</li>
      </ul>
      <div class="cat-add-row">
        <input type="text" id="cat-nova-nome" placeholder="Nova categoria..." maxlength="50"
               onkeydown="if(event.key==='Enter'){event.preventDefault();adicionarCategoria();}" />
        <button class="btn btn-primary" type="button" onclick="adicionarCategoria()">+ Adicionar</button>
      </div>
    </div>
  </div>
</div>

<script>
  const API_RECEITAS   = 'http://localhost:3001/api/receitas';
  const API_INSUMOS    = 'http://localhost:3001/api/insumos';
  const API_CATEGORIAS = 'http://localhost:3001/api/categorias';

  let todasReceitas = [];
  let todosInsumos  = [];
  let catTipoAtivo  = 'RECEITA';

  /* ======================== FUNÇÕES PADRÃO DE FORMATAÇÃO ======================== */
  function formatarDinheiro(valor) {
    const num = Number(valor || 0);
    return num.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });
  }

  function formatarPeso(gramas) {
    const g = parseFloat(gramas || 0);
    if (g >= 1000) {
      const kg = g / 1000.0;
      return kg.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
    }
    return Math.round(g).toLocaleString('pt-BR') + 'g';
  }

  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3500);
  }

  /* ======================== CATEGORIAS ======================== */
  async function carregarCategoriaSelect(tipo, selectId, valorSelecionado = '') {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Selecione...</option>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${tipo}`);
      const cats = await res.json();
      cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.nome;
        opt.textContent = c.nome;
        if (c.nome === valorSelecionado) opt.selected = true;
        select.appendChild(opt);
      });
    } catch {
      select.innerHTML = '<option value="">Erro ao carregar</option>';
    }
  }

  function openCatModal(tipo) {
    catTipoAtivo = tipo;
    document.getElementById('cat-modal-title').textContent =
      `⚙️ Categorias de ${tipo === 'INSUMO' ? 'Insumo' : tipo === 'RECEITA' ? 'Receita' : 'Produto'}`;
    document.getElementById('cat-nova-nome').value = '';
    document.getElementById('cat-modal-overlay').classList.add('open');
    renderCatList();
  }

  function closeCatModal() {
    document.getElementById('cat-modal-overlay').classList.remove('open');
    const selectId = 'receita-categoria';
    const atual = document.getElementById(selectId).value;
    carregarCategoriaSelect(catTipoAtivo, selectId, atual);
  }

  function closeCatModalOnBackdrop(event) {
    if (event.target === document.getElementById('cat-modal-overlay')) closeCatModal();
  }

  async function renderCatList() {
    const ul = document.getElementById('cat-list');
    ul.innerHTML = '<li class="cat-empty">Carregando...</li>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${catTipoAtivo}`);
      const cats = await res.json();
      if (!cats.length) {
        ul.innerHTML = '<li class="cat-empty">Nenhuma categoria cadastrada.</li>';
        return;
      }
      ul.innerHTML = cats.map(c => `
        <li class="cat-item">
          <span>${c.nome}</span>
          <button class="cat-del" title="Excluir" onclick="excluirCategoria(${c.id})">×</button>
        </li>`).join('');
    } catch {
      ul.innerHTML = '<li class="cat-empty" style="color:var(--red)">Erro ao carregar.</li>';
    }
  }

  async function adicionarCategoria() {
    const nome = document.getElementById('cat-nova-nome').value.trim();
    if (!nome) { showToast('Digite um nome para a categoria.', 'error'); return; }

    try {
      const res = await fetch(API_CATEGORIAS, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, tipo: catTipoAtivo })
      });
      if (res.ok) {
        document.getElementById('cat-nova-nome').value = '';
        showToast(`✅ Categoria "${nome}" adicionada!`, 'success');
        renderCatList();
      } else {
        const d = await res.json();
        showToast(d.erro || 'Erro ao adicionar.', 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  async function excluirCategoria(id) {
    if (!confirm('Excluir esta categoria?')) return;
    try {
      const res = await fetch(`${API_CATEGORIAS}/${id}`, { method: 'DELETE' });
      if (res.ok) { showToast('🗑️ Categoria removida.'); renderCatList(); }
      else { const d = await res.json(); showToast(d.erro, 'error'); }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== LOAD / RENDER CARDS ======================== */
  async function carregarDados() {
    try {
      const [resRec, resIns] = await Promise.all([
        fetch(API_RECEITAS),
        fetch(API_INSUMOS)
      ]);
      todasReceitas = await resRec.json();
      todosInsumos  = await resIns.json();
      renderizar(todasReceitas);
    } catch (e) {
      document.getElementById('receitas-grid').innerHTML =
        `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--red)">⚠️ Erro ao conectar com o servidor em localhost:3001</p>`;
    }
  }

  function renderizar(lista) {
    const grid = document.getElementById('receitas-grid');
    if (!lista.length) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">
        Nenhuma receita cadastrada. Clique em <strong>Nova Receita</strong> para começar.
      </p>`;
      return;
    }

    grid.innerHTML = lista.map(r => {
      const pesoStr  = formatarPeso(r.pesoTotal);
      const custo    = formatarDinheiro(r.custo);
      const porKg    = formatarDinheiro(r.custoPorKg);

      const chips = (r.itens || []).map(it => {
        const cls = it.tipoOrigem === 'receita' ? 'chip sub' : 'chip';
        return `<span class="${cls}">${it.nome} (${formatarPeso(it.g)})</span>`;
      }).join('');

      return `
        <div class="rec-card">
          <div>
            <div class="rec-card-header">
              <span class="badge badge-purple">${r.categoria || 'Geral'}</span>
            </div>
            <div class="rec-title">${r.nome}</div>
            
            <div class="rec-meta">
              <span class="badge badge-gray">Peso: ${pesoStr}</span>
              <span class="badge badge-gray">Custo Batelada: ${custo}</span>
            </div>
          </div>

          <div class="rec-price-box">
            <span class="rec-price-label">Preço por KG:</span>
            <span class="rec-price-val">${porKg} / kg</span>
          </div>

          <div>
            <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em">Ingredientes</div>
            <div class="ingredient-chips">${chips || '<span class="text-muted text-sm">Sem itens</span>'}</div>
          </div>

          <div class="rec-card-footer">
            <button class="btn btn-outline btn-sm" onclick="openReceitaModal(${r.id})">Editar</button>
            <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)"
              onclick="excluirReceita(${r.id}, '${r.nome.replace(/'/g, "\\'")}')">Excluir</button>
          </div>
        </div>`;
    }).join('');
  }

  function filtrar() {
    const q = document.getElementById('input-busca').value.toLowerCase();
    renderizar(todasReceitas.filter(r =>
      r.nome.toLowerCase().includes(q) || (r.categoria || '').toLowerCase().includes(q)
    ));
  }

  /* ======================== MODAL CENTRALIZADO ======================== */
  async function openReceitaModal(id = null) {
    document.getElementById('ingredient-rows').innerHTML = '';
    document.getElementById('form-receita').reset();
    document.getElementById('receita-id').value = '';

    await carregarCategoriaSelect('RECEITA', 'receita-categoria');

    if (id) {
      const r = todasReceitas.find(x => x.id === id);
      document.getElementById('receita-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg> Editar Receita`;
      document.getElementById('receita-id').value    = r.id;
      document.getElementById('receita-nome').value  = r.nome;

      const sel = document.getElementById('receita-categoria');
      for (const opt of sel.options) {
        if (opt.value === r.categoria) { opt.selected = true; break; }
      }

      if (r.itens && r.itens.length) {
        r.itens.forEach(it => addIngredientRow(it));
      } else {
        addIngredientRow();
      }
    } else {
      document.getElementById('receita-modal-title').innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
        </svg> Nova Receita`;
      addIngredientRow();
    }

    recalcTotals();
    document.getElementById('receita-modal-overlay').classList.add('open');
  }

  function openDrawer(id = null) { openReceitaModal(id); }

  function closeReceitaModal() {
    document.getElementById('receita-modal-overlay').classList.remove('open');
  }
  function closeDrawer() { closeReceitaModal(); }

  function closeReceitaModalOnBackdrop(event) {
    if (event.target === document.getElementById('receita-modal-overlay')) closeReceitaModal();
  }

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeReceitaModal();
      closeCatModal();
    }
  });

  /* ======================== INGREDIENT ROWS ======================== */
  function addIngredientRow(dados = null) {
    const container = document.getElementById('ingredient-rows');
    const rowId = 'row-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6);

    const div = document.createElement('div');
    div.className = 'ingredient-row';
    div.id = rowId;

    const tipoVal  = dados ? (dados.tipoOrigem || 'materia') : 'materia';
    const gramsVal = dados ? parseFloat(dados.g || 0) : '';

    div.innerHTML = `
      <select class="tipo-select" onchange="populateOrigemSelect('${rowId}', null); recalcTotals()">
        <option value="materia" ${tipoVal === 'materia' ? 'selected' : ''}>Insumo</option>
        <option value="receita" ${tipoVal === 'receita' ? 'selected' : ''}>Receita</option>
      </select>
      <select class="origem-select" required onchange="updateRowCost('${rowId}')">
        <option value="">Selecione...</option>
      </select>
      <input type="number" class="qtd-input" step="0.1" min="0.1"
             value="${gramsVal}" placeholder="g" required
             oninput="updateRowCost('${rowId}')" />
      <span class="val-cell unit-cost-cell">-</span>
      <span class="val-cell total row-total-cell">R$ 0,00</span>
      <button type="button" class="row-remove" onclick="removeRow('${rowId}')">×</button>
    `;

    container.appendChild(div);
    populateOrigemSelect(rowId, dados ? dados.idOrigem : null);
  }

  function removeRow(rowId) {
    const el = document.getElementById(rowId);
    if (el) el.remove();
    recalcTotals();
  }

  function populateOrigemSelect(rowId, selectedId) {
    const row    = document.getElementById(rowId);
    const tipo   = row.querySelector('.tipo-select').value;
    const select = row.querySelector('.origem-select');
    const currentReceitaId = parseInt(document.getElementById('receita-id').value || 0);

    select.innerHTML = '<option value="">Selecione...</option>';

    if (tipo === 'materia') {
      todosInsumos.forEach(i => {
        const opt = document.createElement('option');
        opt.value = i.id;
        opt.textContent = `${i.nome} (${i.unidade_medida})`;
        opt.dataset.costKg = parseFloat(i.custo_unitario || 0);
        if (selectedId == i.id) opt.selected = true;
        select.appendChild(opt);
      });
    } else {
      todasReceitas.forEach(r => {
        if (r.id === currentReceitaId) return;
        const opt = document.createElement('option');
        opt.value = r.id;
        opt.textContent = `${r.nome} (${r.categoria})`;
        opt.dataset.costKg = parseFloat(r.custoPorKg || 0);
        if (selectedId == r.id) opt.selected = true;
        select.appendChild(opt);
      });
    }

    updateRowCost(rowId);
  }

  function updateRowCost(rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;

    const select = row.querySelector('.origem-select');
    const opt    = select.options[select.selectedIndex];
    const costKg = opt ? parseFloat(opt.dataset.costKg || 0) : 0;
    const g      = parseFloat(row.querySelector('.qtd-input').value || 0);

    const custoItem = (costKg / 1000.0) * g;

    row.querySelector('.unit-cost-cell').textContent = opt && select.value ? `${formatarDinheiro(costKg)}` : '-';
    row.querySelector('.row-total-cell').textContent = formatarDinheiro(custoItem);

    recalcTotals();
  }

  /* ======================== REALTIME CALC ======================== */
  function recalcTotals() {
    let pesoTotal  = 0;
    let custoTotal = 0;

    document.querySelectorAll('.ingredient-row').forEach(row => {
      const select = row.querySelector('.origem-select');
      const opt    = select.options[select.selectedIndex];
      const costKg = opt ? parseFloat(opt.dataset.costKg || 0) : 0;
      const g      = parseFloat(row.querySelector('.qtd-input').value || 0);

      pesoTotal  += g;
      custoTotal += (costKg / 1000.0) * g;
    });

    const porKg = pesoTotal > 0 ? (custoTotal / pesoTotal) * 1000.0 : 0;

    document.getElementById('total-peso').textContent = formatarPeso(pesoTotal);
    document.getElementById('total-custo').textContent = formatarDinheiro(custoTotal);
    document.getElementById('total-custo-kg').textContent = `${formatarDinheiro(porKg)} / kg`;
  }

  /* ======================== SAVE ======================== */
  async function salvarReceita(e) {
    e.preventDefault();

    const id = document.getElementById('receita-id').value;
    const rows  = document.querySelectorAll('.ingredient-row');
    const itens = [];

    for (const row of rows) {
      const tipo   = row.querySelector('.tipo-select').value;
      const select = row.querySelector('.origem-select');
      const opt    = select.options[select.selectedIndex];
      const g      = parseFloat(row.querySelector('.qtd-input').value);

      if (!select.value || !g) {
        showToast('Preencha todos os ingredientes antes de salvar.', 'error');
        return;
      }

      const costKg = opt ? parseFloat(opt.dataset.costKg || 0) : 0;
      const custoItem = (costKg / 1000.0) * g;

      itens.push({
        tipoOrigem:    tipo,
        idOrigem:      parseInt(select.value, 10),
        nome:          opt ? opt.textContent.split(' (')[0] : '',
        g:             g,
        custoUnitario: costKg,
        custo:         custoItem
      });
    }

    if (!itens.length) {
      showToast('Adicione pelo menos um ingrediente.', 'error');
      return;
    }

    const body = {
      nome:      document.getElementById('receita-nome').value.trim(),
      categoria: document.getElementById('receita-categoria').value,
      itens
    };

    try {
      const res = id
        ? await fetch(`${API_RECEITAS}/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })
        : await fetch(API_RECEITAS, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });

      if (res.ok) {
        showToast(id ? '✅ Receita atualizada!' : '✅ Receita criada com sucesso!', 'success');
        closeReceitaModal();
        carregarDados();
      } else {
        const data = await res.json();
        showToast('Erro ao salvar: ' + data.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    }
  }

  /* ======================== DELETE ======================== */
  async function excluirReceita(id, nome) {
    if (!confirm(`Excluir a receita "${nome}"? Esta ação não pode ser desfeita.`)) return;
    try {
      const res = await fetch(`${API_RECEITAS}/${id}`, { method: 'DELETE' });
      if (res.ok) {
        showToast('🗑️ Receita removida.', '');
        carregarDados();
      } else {
        const data = await res.json();
        showToast('Erro ao excluir: ' + data.erro, 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarDados;
</script>
</body>
</html>
</file>

<file path="frontend/planejamento.html">
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel do Maestro (Planejamento) — ERP Fabrica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/global.css" />
  <style>
    /* ============ LAYOUT MAESTRO (FULL SCREEN) ============ */
    .maestro-grid-layout {
      display: grid;
      grid-template-columns: 310px 1fr;
      gap: 20px;
      align-items: start;
    }

    /* Coluna de Pendências (Esquerda) */
    .pendencias-col {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 170px);
    }
    .pendencias-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px; padding-bottom: 10px;
      border-bottom: 1px solid var(--border-light);
    }
    .pendencias-header h3 { font-size: 15px; font-weight: 800; margin: 0; }

    .pendencias-list {
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-right: 4px;
    }

    .op-item-card {
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      padding: 12px;
      transition: all .15s;
    }
    .op-item-card:hover {
      border-color: var(--brand);
      box-shadow: var(--shadow-sm);
    }

    .op-item-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 6px;
    }
    .op-item-title { font-size: 14px; font-weight: 700; color: var(--text-primary); }
    .op-item-qtd { font-size: 13px; font-weight: 800; color: var(--brand); }

    /* Quadro Semanal (Direita) */
    .semana-quadro {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      overflow-x: auto;
    }

    .dia-coluna {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 12px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      min-width: 210px;
    }
    .dia-header {
      text-align: center;
      padding-bottom: 10px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border-light);
    }
    .dia-nome { font-size: 14px; font-weight: 800; color: var(--text-primary); }
    .dia-data { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    /* Card do Colaborador no Dia */
    .colab-day-card {
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      padding: 10px;
      margin-bottom: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .colab-day-header {
      display: flex; justify-content: space-between; align-items: center;
    }
    .colab-day-name { font-size: 13px; font-weight: 700; color: var(--text-primary); }
    .colab-day-meta { font-size: 11px; color: var(--text-secondary); }

    /* Barra de Progresso */
    .progress-container {
      background: #e2e8f0;
      border-radius: 10px;
      height: 9px;
      width: 100%;
      overflow: hidden;
    }
    .progress-bar {
      height: 100%;
      border-radius: 10px;
      transition: width .3s, background-color .3s;
    }
    .progress-bar.verde   { background-color: #22c55e; }
    .progress-bar.amarelo { background-color: #f59e0b; }
    .progress-bar.vermelho{ background-color: #ef4444; }

    .progress-info {
      display: flex; justify-content: space-between; font-size: 10.5px; font-weight: 700;
      color: var(--text-secondary); margin-top: 2px;
    }

    /* OPs Alocadas no Colaborador */
    .alocada-op {
      background: var(--surface);
      border: 1px solid var(--border-light);
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 11.5px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .alocada-op-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 110px; }
    .alocada-op-remove {
      background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 14px; padding: 0 2px; line-height: 1;
    }
    .alocada-op-remove:hover { color: var(--red); }

    /* Botão de Alocação */
    .btn-alocar-sm {
      background: none; border: 1px dashed var(--brand);
      color: var(--brand); border-radius: 6px;
      padding: 4px 8px; font-size: 11px; font-weight: 700;
      cursor: pointer; text-align: center; width: 100%;
      transition: background .12s;
    }
    .btn-alocar-sm:hover { background: var(--brand-light); }

    /* Selos visuais */
    .badge-prep { background:#f3e8ff; color:#7e22ce; border:1px solid #e9d5ff; border-radius:10px; padding:1px 6px; font-size:10px; font-weight:700; }
    .badge-mont { background:#dbeafe; color:#1e40af; border:1px solid #bfdbfe; border-radius:10px; padding:1px 6px; font-size:10px; font-weight:700; }

    /* Modal de Alocação Rápida */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 1100;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity .2s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal-box {
      background: var(--surface); border-radius: 16px; box-shadow: var(--shadow-lg);
      width: 440px; max-width: calc(100vw - 32px); display: flex; flex-direction: column;
      transform: translateY(12px) scale(.97); transition: transform .2s;
    }
    .modal-overlay.open .modal-box { transform: none; }
    .modal-header { padding: 18px 22px 14px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; }
    .modal-header h3 { font-size: 16px; font-weight: 700; margin: 0; }
    .modal-body { padding: 18px 22px; }
    .modal-footer { padding: 12px 22px 16px; border-top: 1px solid var(--border-light); display: flex; justify-content: flex-end; gap: 8px; }
  </style>
</head>
<body>

<div id="toast-container"></div>

<div class="erp-shell">
  <div class="main-wrap">

    <!-- TOPBAR COM NAVEGAÇÃO -->
    <header class="topbar">
      <a href="planejamento.html" class="topbar-logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <span>ERP Fabrica</span>
      </a>
      <nav class="topbar-nav">
        <a href="almoxarifado.html">📦 Almoxarifado</a>
        <a href="receitas.html">👨🍳 Receitas</a>
        <a href="produtos.html">🍰 Produtos Finais</a>
        <a href="clientes.html">👥 Clientes</a>
        <a href="vendas.html">💰 Lançar Vendas</a>
        <a href="ordens_producao.html">🏭 Ordens de Produção</a>
        <a href="colaboradores.html">👤 Colaboradores</a>
        <a href="planejamento.html" class="active">📅 Planejamento</a>
      </nav>
      <div class="topbar-right">
        <span class="badge-online">● Online</span>
      </div>
    </header>

    <div class="page-content">

      <div class="page-header">
        <div class="page-header-left">
          <h1>Painel do Maestro — Planejamento Semanal</h1>
          <p>Distribua a produção da semana para sua equipe com cálculo de meta em tempo real e agendamento inteligente D-1.</p>
        </div>
        <div class="page-header-actions">
          <button class="btn btn-outline" onclick="carregarTudo()">🔄 Atualizar Quadro</button>
        </div>
      </div>

      <!-- LAYOUT PRINCIPAL -->
      <div class="maestro-grid-layout">

        <!-- COLUNA DE PENDÊNCIAS (ESQUERDA) -->
        <div class="pendencias-col">
          <div class="pendencias-header">
            <h3>⏳ OPs Pendentes</h3>
            <span class="badge badge-amber" id="count-pendentes">0 OPs</span>
          </div>

          <div class="pendencias-list" id="pendencias-list">
            <p style="text-align:center;padding:20px;color:var(--text-muted)">Carregando OPs...</p>
          </div>
        </div>

        <!-- QUADRO SEMANAL (DIREITA) -->
        <div class="semana-quadro" id="semana-quadro">
          <!-- 5 colunas preenchidas via JS -->
        </div>

      </div>

    </div>
  </div>
</div>

<!-- ==================== MODAL DE ALOCAÇÃO RÁPIDA DE OP ==================== -->
<div class="modal-overlay" id="alocar-modal-overlay" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="alocar-modal-title">Atribuir OP ao Colaborador</h3>
      <button class="modal-close" onclick="document.getElementById('alocar-modal-overlay').classList.remove('open')">✕</button>
    </div>

    <div class="modal-body">
      <form id="form-alocar" onsubmit="confirmarAlocacao(event)">
        <input type="hidden" id="alocar-op-id" />

        <div class="form-group">
          <label>OP Selecionada</label>
          <input type="text" id="alocar-op-nome" readonly style="background:var(--bg);font-weight:700" />
        </div>

        <div class="form-group">
          <label>Dia da Semana *</label>
          <select id="alocar-dia-select" required onchange="aoMudarDiaOuColab()"></select>
        </div>

        <div class="form-group">
          <label>Colaborador *</label>
          <select id="alocar-colab-select" required onchange="aoMudarDiaOuColab()"></select>
        </div>

        <div id="alocar-hint-box" style="margin-top:10px;font-size:12px"></div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="document.getElementById('alocar-modal-overlay').classList.remove('open')">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-alocar').requestSubmit()">
        Confirmar Atribuição
      </button>
    </div>
  </div>
</div>

<script>
  const API_PRODUCAO     = 'http://localhost:3001/api/producao';
  const API_PLANEJAMENTO = 'http://localhost:3001/api/planejamento';
  const API_COLABORADORES = 'http://localhost:3001/api/colaboradores';

  let todasOPsFila       = [];
  let agendaSemanal      = {};
  let todosColaboradores = [];
  let datasSemanaAtual   = []; // array de { dia_nome, dataStr }

  /* ======================== TOAST ======================== */
  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 4000);
  }

  /* ======================== DATAS DA SEMANA ======================== */
  function calcularDatasSemana() {
    const hoje = new Date();
    const diaSem = hoje.getDay();
    const diffSeg = hoje.getDate() - diaSem + (diaSem === 0 ? -6 : 1);
    
    const seg = new Date(hoje.setDate(diffSeg));
    const diasNomes = ['Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira'];
    
    datasSemanaAtual = [];
    for (let i = 0; i < 5; i++) {
      const d = new Date(seg);
      d.setDate(seg.getDate() + i);
      const dataStr = d.toISOString().split('T')[0];
      datasSemanaAtual.push({ dia_nome: diasNomes[i], dataStr });
    }
  }

  /* ======================== CARREGAR DADOS ======================== */
  async function carregarTudo() {
    calcularDatasSemana();
    try {
      const dataInicio = datasSemanaAtual[0].dataStr;
      const dataFim    = datasSemanaAtual[4].dataStr;

      const [rFila, rSem, rCol] = await Promise.all([
        fetch(`${API_PRODUCAO}/fila`),
        fetch(`${API_PLANEJAMENTO}/semanal?data_inicio=${dataInicio}&data_fim=${dataFim}`),
        fetch(API_COLABORADORES)
      ]);

      todasOPsFila       = await rFila.json();
      const semJson      = await rSem.json();
      agendaSemanal      = semJson.sugestao || semJson.agenda || semJson;
      todosColaboradores = await rCol.json();

      renderizarPendencias();
      renderizarQuadroSemanal();
    } catch {
      showToast('⚠️ Erro ao carregar dados do planejamento na porta 3001.', 'error');
    }
  }

  /* ======================== RENDER PENDÊNCIAS ======================== */
  function renderizarPendencias() {
    // Pendentes: OPs na FILA sem data_programada ou sem colaborador_id
    const pendentes = todasOPsFila.filter(o => o.status === 'FILA' && (!o.data_programada || !o.colaborador_id));
    
    document.getElementById('count-pendentes').textContent = `${pendentes.length} OPs`;
    const container = document.getElementById('pendencias-list');

    if (!pendentes.length) {
      container.innerHTML = `<p style="text-align:center;padding:30px 10px;color:var(--text-muted)">
        ✅ Todas as OPs foram atribuídas!
      </p>`;
      return;
    }

    container.innerHTML = pendentes.map(o => {
      const opIdNum   = o.numero_op || o.id;
      const opNumStr  = `#${String(opIdNum).padStart(3, '0')}`;
      const isPreparo = o.tipo_op === 'PREPARO';
      const badgeTipo = isPreparo
        ? `<span class="badge-prep">🥣 PREPARO</span>`
        : `<span class="badge-mont">🛠️ MONTAGEM</span>`;

      return `
        <div class="op-item-card">
          <div class="op-item-header">
            <span style="font-size:11.5px;font-weight:700;color:var(--brand)">${opNumStr}</span>
            ${badgeTipo}
          </div>
          <div class="op-item-title">${o.produto}</div>
          <div class="op-item-header" style="margin-top:6px;gap:6px">
            <span class="op-item-qtd">${parseFloat(o.quantidade_planejada)} un</span>
            <div style="display:flex;gap:4px">
              <button class="btn btn-dividir btn-sm" onclick="dividirOP(${opIdNum}, ${o.quantidade_planejada})">
                ✂️ Dividir
              </button>
              <button class="btn btn-primary btn-sm" onclick="abrirModalAlocar(${opIdNum}, '${o.produto.replace(/'/g, "\\'")}', ${o.quantidade_planejada})">
                + Atribuir
              </button>
            </div>
          </div>
        </div>`;
    }).join('');
  }

  /* ======================== DIVIDIR OP ======================== */
  async function dividirOP(opId, totalQtd) {
    const valor = prompt(`Esta OP tem ${totalQtd} unidades.\nQuantas unidades você deseja mover para a NOVA OP secundária?`);
    if (!valor) return;
    const qtdNova = parseFloat(valor.replace(',', '.'));
    if (isNaN(qtdNova) || qtdNova <= 0 || qtdNova >= totalQtd) {
      showToast(`Digite um valor válido maior que 0 e menor que ${totalQtd}.`, 'error');
      return;
    }
    const qtdRestante = totalQtd - qtdNova;

    try {
      const res = await fetch(`${API_PLANEJAMENTO}/split-op`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          op_id: opId,
          quantidade_colaborador_1: qtdRestante,
          quantidade_colaborador_2: qtdNova
        })
      });

      const data = await res.json();
      if (res.ok && data.status !== 'erro') {
        showToast(`✂️ OP dividida com sucesso em duas! (${qtdRestante} un + ${qtdNova} un)`, 'success');
        carregarTudo();
      } else {
        showToast('Erro: ' + (data.erro || 'Não foi possível dividir a OP.'), 'error');
      }
    } catch {
      showToast('Erro de conexão com o servidor.', 'error');
    }
  }

  /* ======================== RENDER QUADRO SEMANAL ======================== */
  function renderizarQuadroSemanal() {
    const colabsAtivos = todosColaboradores.filter(c => (c.status || 'Ativo') === 'Ativo');
    const container    = document.getElementById('semana-quadro');

    container.innerHTML = datasSemanaAtual.map(diaObj => {
      const dataStr = diaObj.dataStr;
      const diaAgenda = agendaSemanal[dataStr] || { colaboradores: [] };

      // Renderizar cards de colaboradores para este dia
      const colabsHtml = colabsAtivos.map(c => {
        const metaIndiv = parseInt(c.meta_diaria_individual || c.meta_diaria || 350, 10);
        
        // Buscar OPs alocadas para este colaborador neste dia na agendaSemanal ou todasOPsFila
        const opsAlocadas = todasOPsFila.filter(o => {
          if (!o.data_programada || !o.colaborador_id) return false;
          const oDataStr = new Date(o.data_programada).toISOString().split('T')[0];
          return oDataStr === dataStr && o.colaborador_id === c.id;
        });

        // Somar a quantidade alocada
        const totalAlocado = opsAlocadas.reduce((acc, curr) => acc + (parseFloat(curr.quantidade_planejada) || 0), 0);

        // Cálculo de Progresso
        const pct = Math.min(Math.round((totalAlocado / metaIndiv) * 100), 150);
        let corClasse = 'verde';
        if (pct > 100) corClasse = 'vermelho';
        else if (pct >= 80) corClasse = 'amarelo';

        const opsHtml = opsAlocadas.map(op => {
          const opNumStr = `#${String(op.numero_op || op.id).padStart(3, '0')}`;
          return `
            <div class="alocada-op">
              <span class="alocada-op-name" title="${op.produto}">${opNumStr} ${op.produto} (${parseFloat(op.quantidade_planejada)}un)</span>
              <button class="alocada-op-remove" onclick="desalocarOP(${op.id})" title="Desatribuir">✕</button>
            </div>`;
        }).join('');

        return `
          <div class="colab-day-card">
            <div class="colab-day-header">
              <span class="colab-day-name">${c.nome}</span>
              <span class="colab-day-meta">Meta: ${metaIndiv}un</span>
            </div>

            <!-- BARRA DE PROGRESSO DA META -->
            <div>
              <div class="progress-container">
                <div class="progress-bar ${corClasse}" style="width: ${Math.min(pct, 100)}%"></div>
              </div>
              <div class="progress-info">
                <span>${totalAlocado} un</span>
                <span>${pct}%</span>
              </div>
            </div>

            <!-- OPS DO COLABORADOR -->
            <div style="display:flex;flex-direction:column;gap:4px;margin-top:2px">
              ${opsHtml}
            </div>

            <button class="btn-alocar-sm" onclick="abrirAlocarParaColab(${c.id}, '${dataStr}')">
              + Atribuir OP
            </button>
          </div>`;
      }).join('');

      const formatDataCurta = new Date(dataStr + 'T00:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });

      return `
        <div class="dia-coluna">
          <div class="dia-header">
            <div class="dia-nome">${diaObj.dia_nome.replace('-feira', '')}</div>
            <div class="dia-data">${formatDataCurta}</div>
          </div>
          <div style="flex:1;display:flex;flex-direction:column">
            ${colabsHtml}
          </div>
        </div>`;
    }).join('');
  }

  /* ======================== ALOCAÇÃO DE OP ======================== */
  function abrirModalAlocar(opId, produtoNome, qtd) {
    document.getElementById('alocar-op-id').value = opId;
    document.getElementById('alocar-op-nome').value = `${produtoNome} (${qtd} un)`;

    // Preencher select de dias
    const diaSel = document.getElementById('alocar-dia-select');
    diaSel.innerHTML = datasSemanaAtual.map(d => `
      <option value="${d.dataStr}">${d.dia_nome} (${new Date(d.dataStr + 'T00:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' })})</option>
    `).join('');

    // Preencher select de colaboradores
    const colabSel = document.getElementById('alocar-colab-select');
    const colabsAtivos = todosColaboradores.filter(c => (c.status || 'Ativo') === 'Ativo');
    colabSel.innerHTML = colabsAtivos.map(c => `
      <option value="${c.id}">${c.nome} (Meta: ${c.meta_diaria_individual || 350} un)</option>
    `).join('');

    document.getElementById('alocar-modal-overlay').classList.add('open');
  }

  function abrirAlocarParaColab(colabId, dataStr) {
    const pendente = todasOPsFila.find(o => o.status === 'FILA' && (!o.data_programada || !o.colaborador_id));
    if (!pendente) {
      showToast('Nenhuma OP pendente na fila para atribuir.', 'error');
      return;
    }
    abrirModalAlocar(pendente.id, pendente.produto, pendente.quantidade_planejada);
    document.getElementById('alocar-dia-select').value = dataStr;
    document.getElementById('alocar-colab-select').value = colabId;
  }

  async function confirmarAlocacao(e) {
    e.preventDefault();
    const opId         = document.getElementById('alocar-op-id').value;
    const dataSelected = document.getElementById('alocar-dia-select').value;
    const colabId      = document.getElementById('alocar-colab-select').value;

    try {
      const res = await fetch(`${API_PLANEJAMENTO}/agendar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          op_id: parseInt(opId, 10),
          data_programada: dataSelected,
          colaborador_id: parseInt(colabId, 10)
        })
      });

      const data = await res.json();

      if (res.ok && data.status !== 'erro') {
        document.getElementById('alocar-modal-overlay').classList.remove('open');
        showToast('✅ OP atribuída com sucesso!', 'success');
        
        if (data.aviso) {
          setTimeout(() => showToast(data.aviso, ''), 600);
        }

        carregarTudo();
      } else {
        showToast('Erro: ' + (data.erro || 'Não foi possível agendar.'), 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  async function desalocarOP(opId) {
    try {
      const res = await fetch(`${API_PLANEJAMENTO}/agendar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op_id: opId, data_programada: null, colaborador_id: null })
      });
      if (res.ok) {
        showToast('↩️ OP devolvida para a lista de pendências.');
        carregarTudo();
      }
    } catch {
      showToast('Erro ao desatribuir OP.', 'error');
    }
  }

  /* ======================== INIT ======================== */
  window.onload = carregarTudo;
</script>
</body>
</html>
</file>

