            `;
          }
        });
      }

      const tipoFichaTitulo = isCozinha ? 'MAPA DE RECHEIOS - PARA USO AMANHÃ (D-1)' : 'ORDEM DE CONFEÇÃO - DIA ' + formatarData(data.data);

      container.innerHTML = `
