    }

    .detail-card {
      background: var(--bg);
      border-radius: 8px;
      padding: 12px 16px;
    }
    .detail-label {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    .detail-val {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }

    .batelada-config-row {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 24px;
    }

    .batelada-config-row label {
      font-weight: 700;
      font-size: 14px;
      color: #1e3a8a;
    }
    .batelada-config-row input {
      width: 100px;
      padding: 8px 12px;
      border: 1px solid #93c5fd;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 700;
      text-align: center;
      outline: none;
    }

    .bateladas-result-container {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .batelada-card {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }

    .batelada-header {
      background: var(--bg);
      padding: 10px 16px;
      font-weight: 700;
      font-size: 14px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
    }

    .ingredient-table {
      width: 100%;
      border-collapse: collapse;
    }
    .ingredient-table th {
      background: var(--surface);
      text-align: left;
      padding: 8px 16px;
      font-size: 11px;
      text-transform: uppercase;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
    }
    .ingredient-table td {
      padding: 10px 16px;
      border-bottom: 1px solid var(--border-light);
      font-size: 13.5px;
    }
    .ingredient-table tr:last-child td {
      border-bottom: none;
    }

    .btn-print {
      background: #10b981;
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-print:hover {
      background: #059669;
    }

    #api-status {
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
    }
    .api-online { background: #dcfce7; color: #166534; }
    .api-offline { background: #fee2e2; color: #991b1b; }

    @media print {
      body { background: white; color: black; padding: 0; }
      header, .date-selector, .btn-refresh, .panel:first-child, .batelada-config-row, .btn-print {
        display: none !important;
      }
      .layout-grid {
        grid-template-columns: 1fr;
      }
      .panel {
        border: none;
        box-shadow: none;
        padding: 0;
      }
      .batelada-card {
        page-break-inside: avoid;
        margin-bottom: 20px;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>🧮 Calculadora de Bateladas (Chão de Fábrica)</h1>
    <div style="display:flex; gap:16px; align-items:center;">
      <span id="api-status" class="api-offline">Verificando API...</span>
      <div class="date-selector">
        <input type="date" id="data-busca" onchange="carregarOPsDoDia()" />
        <button class="btn-refresh" onclick="carregarOPsDoDia()">🔄 Recarregar</button>
      </div>
    </div>
  </header>

  <div class="layout-grid">
    <!-- LEFT PANEL: TODAY'S OPS -->
    <div class="panel">
      <div class="panel-title">
        <span>OPs Programadas</span>
        <span id="ops-count" style="font-size:12px; color:var(--text-muted)">0</span>
      </div>
      <div class="ops-list" id="ops-list">
        <div class="no-ops">Carregando ordens...</div>
      </div>
    </div>

    <!-- RIGHT PANEL: CALCULATION DETAILS -->
    <div class="panel" id="calc-panel">
      <div class="calc-box" id="calc-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--text-muted); margin-bottom:12px;"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg>
        <p>Selecione uma Ordem de Produção (OP) ao lado para realizar a divisão em panelas/bateladas.</p>
      </div>

      <div id="calc-content" style="display:none">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 20px;">
          <div>
            <h2 id="calc-title" style="font-size:22px; font-weight:800;">Nome do Produto</h2>
            <p id="calc-op-info" style="color:var(--text-muted); font-size:13px; font-weight:600;">OP #000</p>
          </div>
          <button class="btn-print" onclick="window.print()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir Ficha de Batelada
          </button>
        </div>

        <div class="details-grid">
          <div class="detail-card">
            <div class="detail-label">Quantidade Planejada</div>
            <div class="detail-val" id="detail-qtd">0 un</div>
          </div>
          <div class="detail-card">
            <div class="detail-label">Responsável / Meta</div>
            <div class="detail-val" id="detail-colab">Maria Silva (350 un)</div>
          </div>
        </div>

        <!-- BATCH SIZE CONFIG -->
        <div class="batelada-config-row">
          <label for="batch-cap">Capacidade Máxima por Panela (un):</label>
          <input type="number" id="batch-cap" value="50" min="1" oninput="calcularDivisaoBateladas()" />
          <span style="font-size:12px; color:#1e40af; font-weight:600">Ajuste o tamanho de acordo com o misturador/panela</span>
        </div>

        <!-- CALCULATION RESULTS -->
        <div>
          <h3 style="font-size:15px; font-weight:700; margin-bottom:12px;">Divisão em Panelas (Bateladas)</h3>
          <div class="bateladas-result-container" id="bateladas-container">
            <!-- Batelada Cards Rendered Dynamically -->
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    const API_URL = 'http://localhost:3001/api';
    let OPsHoje = [];
    let OPSelecionada = null;
    let produtoSelecionado = null;

    // Inicializar data
    document.getElementById('data-busca').value = new Date().toISOString().split('T')[0];

    async function init() {
      await testarConexao();
      await carregarOPsDoDia();
    }

    async function testarConexao() {
      const status = document.getElementById('api-status');
      try {
        const res = await fetch(`${API_URL}/status`);
        if (res.ok) {
          status.textContent = 'API Online';
          status.className = 'api-online';
        } else {
          throw new Error();
        }
      } catch {
        status.textContent = 'API Offline (Modo Demo)';
        status.className = 'api-offline';
      }
    }

    // Carregar OPs programadas para a data selecionada
    async function carregarOPsDoDia() {
      const dataStr = document.getElementById('data-busca').value;
      const listEl = document.getElementById('ops-list');
      const countEl = document.getElementById('ops-count');

      try {
        const res = await fetch(`${API_URL}/producao/programadas-hoje?data=${dataStr}`);
        if (!res.ok) throw new Error();
        OPsHoje = await res.json();
      } catch (e) {
        // Fallback demo
        OPsHoje = [
          { op_id: 10, produto: 'Coxinha de Frango', produto_id: 1, quantidade_planejada: 220, colaborador_nome: 'Maria Silva', meta_diaria_individual: 350, peso_produtividade: 1.0 },
          { op_id: 12, produto: 'Pão de Queijo', produto_id: 3, quantidade_planejada: 150, colaborador_nome: 'João Santos', meta_diaria_individual: 400, peso_produtividade: 0.8 },
          { op_id: 15, produto: 'Pastel de Carne', produto_id: 5, quantidade_planejada: 80, colaborador_nome: 'Ana Costa', meta_diaria_individual: 350, peso_produtividade: 1.0 }
        ];
      }

      countEl.textContent = `${OPsHoje.length} OPs`;

      if (OPsHoje.length === 0) {
        listEl.innerHTML = '<div class="no-ops">Nenhuma OP programada para hoje.</div>';
        resetCalculadora();
        return;
      }

      listEl.innerHTML = OPsHoje.map(op => `
        <div class="op-item" id="op-item-${op.op_id}" onclick="selecionarOP(${op.op_id})">
          <div class="op-id">OP-${String(op.op_id).padStart(3, '0')}</div>
          <div class="op-product">${op.produto}</div>
          <div class="op-details">
            <span>Qtd: <strong>${op.quantidade_planejada} un</strong></span>
            <span>👤 ${op.colaborador_nome || 'Sem operador'}</span>
          </div>
        </div>
      `).join('');

      // Auto-seleciona a primeira OP
      selecionarOP(OPsHoje[0].op_id);
    }

    // Resetar view da calculadora
    function resetCalculadora() {
      document.getElementById('calc-placeholder').style.display = 'flex';
      document.getElementById('calc-content').style.display = 'none';
      OPSelecionada = null;
      produtoSelecionado = null;
    }

    // Selecionar uma OP
    async function selecionarOP(opId) {
      // Remove class active de todos
      document.querySelectorAll('.op-item').forEach(el => el.classList.remove('active'));
      const activeEl = document.getElementById(`op-item-${opId}`);
      if (activeEl) activeEl.classList.add('active');

      OPSelecionada = OPsHoje.find(op => op.op_id === opId);
      if (!OPSelecionada) return;

      // Buscar produto com ficha técnica do backend
      try {
        const res = await fetch(`${API_URL}/produtos/${OPSelecionada.produto_id}`);
        if (!res.ok) throw new Error();
        produtoSelecionado = await res.json();
      } catch (e) {
        // Fallback demo ficha técnica
        produtoSelecionado = {
          id: OPSelecionada.produto_id,
          nome: OPSelecionada.produto,
          ficha_tecnica_insumos: [
            { insumo_id: 1, nome: 'Farinha de Trigo', quantidade: 0.05, unidade_medida: 'kg' },
            { insumo_id: 2, nome: 'Água', quantidade: 0.03, unidade_medida: 'l' },
            { insumo_id: 3, nome: 'Recheio de Frango Temperado', quantidade: 0.04, unidade_medida: 'kg' }
          ],
          ficha_tecnica_embalagens: [
            { embalagem_id: 1, nome: 'Caixa de Salgados Congelados (Cap: 50 un)', quantidade: 1 }
          ]
        };
      }

      // Preencher campos
      document.getElementById('calc-title').textContent = OPSelecionada.produto;
      document.getElementById('calc-op-info').textContent = `ORDEM DE PRODUÇÃO: OP-${String(OPSelecionada.op_id).padStart(3, '0')} · CATEGORIA: ${OPSelecionada.categoria_producao || 'Geral'}`;
      document.getElementById('detail-qtd').textContent = `${OPSelecionada.quantidade_planejada} unidades`;
      document.getElementById('detail-colab').textContent = `${OPSelecionada.colaborador_nome || 'Não alocado'} (Meta: ${OPSelecionada.meta_diaria_individual || 350} pts)`;

      document.getElementById('calc-placeholder').style.display = 'none';
      document.getElementById('calc-content').style.display = 'block';

      calcularDivisaoBateladas();
    }

    // Calcular bateladas/panelas e explodir ingredientes
    function calcularDivisaoBateladas() {
      if (!OPSelecionada || !produtoSelecionado) return;

      const qtdTotal = OPSelecionada.quantidade_planejada;
      const capBatelada = parseInt(document.getElementById('batch-cap').value, 10) || 50;

      const container = document.getElementById('bateladas-container');
      container.innerHTML = '';

      const numBateladasInteiras = Math.floor(qtdTotal / capBatelada);
      const saldoRestante = qtdTotal % capBatelada;

      let indexPanela = 1;

      // 1. Bateladas Padrão
      for (let i = 0; i < numBateladasInteiras; i++) {
        container.appendChild(criarBateladaCard(indexPanela++, capBatelada));
      }

      // 2. Batelada de Saldo (se sobrar)
      if (saldoRestante > 0) {
        container.appendChild(criarBateladaCard(indexPanela, saldoRestante, true));
      }
    }

    // Criar o card HTML de uma batelada e sua explosão de insumos
    function criarBateladaCard(index, quantidade, isSaldo = false) {
      const card = document.createElement('div');
      card.className = 'batelada-card';
      
      const title = isSaldo 
        ? `Panela #${index} — Saldo Final (${quantidade} un)` 
        : `Panela #${index} — Batelada Padrão (${quantidade} un)`;

      let rowsHtml = '';

      // Insumos
      const insumos = produtoSelecionado.ficha_tecnica_insumos || [];
      insumos.forEach(ins => {
        const totalKgG = ins.quantidade * quantidade; // Qtd por un * qtd batelada
        let displayQtd = `${totalKgG.toFixed(3)} ${ins.unidade_medida}`;
        
        // Converte kg para g se for pequeno para ajudar a balança do chão de fábrica
        if (ins.unidade_medida === 'kg' && totalKgG < 1.0) {
          displayQtd = `${(totalKgG * 1000).toFixed(1)} g`;
        }
        
        rowsHtml += `
          <tr>
            <td><strong>${ins.nome}</strong></td>
            <td>Matéria-prima</td>
            <td><strong>${displayQtd}</strong></td>
          </tr>
        `;
      });

      // Embalagens (opcional, só mostra se a capacidade coincidir ou se fizer sentido embalar)
      const embalagens = produtoSelecionado.ficha_tecnica_embalagens || [];
      embalagens.forEach(emb => {
        // Se a embalagem é por unidade, faz a multiplicação normal
        const totalEmb = Math.ceil(emb.quantidade * quantidade);
        rowsHtml += `
          <tr>
            <td><strong>${emb.nome}</strong></td>
            <td>Embalagem</td>
            <td><strong>${totalEmb} un</strong></td>
          </tr>
        `;
      });

      card.innerHTML = `
        <div class="batelada-header">
          <span>${title}</span>
          <span style="color:var(--primary)">Produzir batelada de ${quantidade} salgados</span>
        </div>
        <table class="ingredient-table">
          <thead>
            <tr>
              <th>Ingrediente</th>
              <th>Tipo</th>
              <th>Peso / Qtd Necessária para esta panela</th>
            </tr>
          </thead>
          <tbody>
            ${rowsHtml || '<tr><td colspan="3" align="center" style="color:var(--text-muted)">Sem ficha técnica cadastrada para este produto.</td></tr>'}
          </tbody>
        </table>
      `;

      return card;
    }

    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
