                ⚙️ Gerenciar
              </button>
            </label>
            <div class="field-with-action">
              <select id="produto-categoria" required>
                <option value="">Carregando...</option>
              </select>
              <button type="button" class="btn-gear" title="Gerenciar categorias" onclick="openCatModal('PRODUTO')">⚙️</button>
            </div>
          </div>
        </div>

        <!-- BLOCO 2: COMPONENTES (RECEITAS) -->
        <div class="drawer-section-block">
          <div class="drawer-section-title">👨🍳 2. Componentes da Ficha Técnica</div>

          <div style="display:grid;grid-template-columns:1fr 90px 95px 28px;gap:6px;padding:0 4px;margin-bottom:4px">
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase">Receita</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase">Peso (g)</span>
            <span style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;text-align:right">Custo</span>
            <span></span>
          </div>

          <div class="ficha-list" id="ficha-container"></div>

          <button type="button" class="btn-add-row" onclick="adicionarLinhaFicha()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Adicionar Componente
          </button>
        </div>

        <!-- BLOCO 3: EMBALAGEM & RATEIO -->
        <div class="drawer-section-block">
          <div class="drawer-section-title">📦 3. Embalagem & Rateio</div>

          <div class="form-row cols-2">
            <div class="form-group">
              <label>Caixa / Embalagem</label>
              <select id="produto-embalagem" onchange="recalcFinancialSummary()">
                <option value="">Nenhuma embalagem</option>
              </select>
            </div>
            <div class="form-group">
              <label>Capacidade (unidades)</label>
              <input type="number" id="produto-capacidade-emb" step="1" min="1" value="1" placeholder="Ex: 100" oninput="recalcFinancialSummary()" />
            </div>
          </div>

          <div style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;padding-top:4px">
            <span class="text-muted">Rateio de Embalagem por Salgado:</span>
            <strong id="label-rateio-emb" style="color:var(--text-primary)">R$ 0,00</strong>
          </div>
        </div>

        <!-- BLOCO COLORIDO NO FINAL: RESUMO DE MARGEM & PREÇO SUGERIDO -->
        <div class="summary-card-block green" id="summary-card-block">
          <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">
            📊 Resumo Financeiro & Margem
          </div>
          <div class="summary-grid">
            <div class="summary-item">
              <label>Peso Total Unitário</label>
              <strong id="summary-peso">0g</strong>
            </div>
            <div class="summary-item">
              <label>Custo Total (Ingr + Rateio)</label>
              <strong id="summary-custo">R$ 0,00</strong>
            </div>
            <div class="summary-item">
              <label>Preço Sugerido (2.5x)</label>
              <strong id="summary-preco-sugerido">R$ 0,00</strong>
            </div>
            <div class="summary-item">
              <label>Margem Real (%)</label>
              <strong id="summary-margem-pct">0.0%</strong>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" type="button" onclick="closeProdutoModal()">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="document.getElementById('form-produto').requestSubmit()">Salvar Produto</button>
    </div>
  </div>
</div>

<!-- MODAL CATEGORIAS -->
<div class="modal-overlay" id="cat-modal-overlay" onclick="closeCatModalOnBackdrop(event)">
  <div class="modal-box">
    <div class="modal-header">
      <h3 id="cat-modal-title">⚙️ Categorias de Produto</h3>
      <button class="modal-close" onclick="closeCatModal()">✕</button>
    </div>
    <div class="modal-body">
      <ul class="cat-list" id="cat-list">
        <li class="cat-empty">Carregando...</li>
      </ul>
      <div class="cat-add-row">
        <input type="text" id="cat-nova-nome" placeholder="Nova categoria..." maxlength="50"
               onkeydown="if(event.key==='Enter'){event.preventDefault();adicionarCategoria();}" />
        <button class="btn btn-primary" type="button" onclick="adicionarCategoria()">+ Adicionar</button>
      </div>
    </div>
  </div>
</div>

<script>
  const API_PRODUTOS   = 'http://localhost:3001/api/produtos';
  const API_RECEITAS   = 'http://localhost:3001/api/receitas';
  const API_INSUMOS    = 'http://localhost:3001/api/insumos';
  const API_CATEGORIAS = 'http://localhost:3001/api/categorias';

  let todosProdutos = [], todasReceitas = [], todosInsumos = [];
  let catTipoAtivo  = 'PRODUTO';

  /* ======================== FUNÇÕES PADRÃO DE FORMATAÇÃO ======================== */
  function formatarDinheiro(valor) {
    const num = Number(valor || 0);
    return num.toLocaleString('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });
  }

  function formatarPeso(gramas) {
    const g = parseFloat(gramas || 0);
    if (g >= 1000) {
      const kg = g / 1000.0;
      return kg.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kg';
    }
    return Math.round(g).toLocaleString('pt-BR') + 'g';
  }

  function showToast(msg, type = '') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  /* ======================== CATEGORIAS ======================== */
  async function carregarCategoriaSelect(tipo, selectId, valorSelecionado = '') {
    const select = document.getElementById(selectId);
    select.innerHTML = '<option value="">Selecione...</option>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${tipo}`);
      const cats = await res.json();
      cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.nome;
        opt.textContent = c.nome;
        if (c.nome === valorSelecionado) opt.selected = true;
        select.appendChild(opt);
      });
    } catch {
      select.innerHTML = '<option value="">Erro ao carregar</option>';
    }
  }

  function openCatModal(tipo) {
    catTipoAtivo = tipo;
    document.getElementById('cat-modal-title').textContent =
      `⚙️ Categorias de ${tipo === 'INSUMO' ? 'Insumo' : tipo === 'RECEITA' ? 'Receita' : 'Produto'}`;
    document.getElementById('cat-nova-nome').value = '';
    document.getElementById('cat-modal-overlay').classList.add('open');
    renderCatList();
  }

  function closeCatModal() {
    document.getElementById('cat-modal-overlay').classList.remove('open');
    const selectId = 'produto-categoria';
    const atual = document.getElementById(selectId).value;
    carregarCategoriaSelect(catTipoAtivo, selectId, atual);
  }

  function closeCatModalOnBackdrop(event) {
    if (event.target === document.getElementById('cat-modal-overlay')) closeCatModal();
  }

  async function renderCatList() {
    const ul = document.getElementById('cat-list');
    ul.innerHTML = '<li class="cat-empty">Carregando...</li>';
    try {
      const res  = await fetch(`${API_CATEGORIAS}?tipo=${catTipoAtivo}`);
      const cats = await res.json();
      if (!cats.length) {
        ul.innerHTML = '<li class="cat-empty">Nenhuma categoria cadastrada.</li>';
        return;
      }
      ul.innerHTML = cats.map(c => `
        <li class="cat-item">
          <span>${c.nome}</span>
          <button class="cat-del" title="Excluir" onclick="excluirCategoria(${c.id})">×</button>
        </li>`).join('');
    } catch {
      ul.innerHTML = '<li class="cat-empty" style="color:var(--red)">Erro ao carregar.</li>';
    }
  }

  async function adicionarCategoria() {
    const nome = document.getElementById('cat-nova-nome').value.trim();
    if (!nome) { showToast('Digite um nome para a categoria.', 'error'); return; }

    try {
      const res = await fetch(API_CATEGORIAS, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, tipo: catTipoAtivo })
      });
      if (res.ok) {
        document.getElementById('cat-nova-nome').value = '';
        showToast(`✅ Categoria "${nome}" adicionada!`, 'success');
        renderCatList();
      } else {
        const d = await res.json();
        showToast(d.erro || 'Erro ao adicionar.', 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  async function excluirCategoria(id) {
    if (!confirm('Excluir esta categoria?')) return;
    try {
      const res = await fetch(`${API_CATEGORIAS}/${id}`, { method: 'DELETE' });
      if (res.ok) { showToast('🗑️ Categoria removida.'); renderCatList(); }
      else { const d = await res.json(); showToast(d.erro, 'error'); }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  /* ======================== LOAD / RENDER CARDS ======================== */
  async function carregarDados() {
    try {
      const [resProd, resRec, resIns] = await Promise.all([
        fetch(API_PRODUTOS),
        fetch(API_RECEITAS),
        fetch(API_INSUMOS)
      ]);
      todosProdutos = await resProd.json();
      todasReceitas = await resRec.json();
      todosInsumos  = await resIns.json();
      renderizar(todosProdutos);
    } catch (e) {
      document.getElementById('product-list').innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--red)">⚠️ Erro ao conectar com o servidor.</p>`;
    }
  }

  function renderizar(lista) {
    const grid = document.getElementById('product-list');
    if (!lista.length) {
      grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:40px">Nenhum produto cadastrado. Clique em <strong>+ Novo Produto</strong> para começar.</p>`;
      return;
    }
    grid.innerHTML = lista.map(p => {
      const preco = formatarDinheiro(p.preco_venda);
      const custo = formatarDinheiro(p.custo_producao);
      const margemPctNum = parseFloat(p.margem_contribuicao_pct || 0);
      const margemPct = margemPctNum.toFixed(1);
      const margemClass = margemPctNum < 0 ? 'badge-red' : margemPctNum < 50 ? 'badge-amber' : 'badge-green';

      return `
        <div class="prod-card">
          <div>
            <div class="prod-card-header">
              <span class="badge badge-purple">${p.categoria_producao || p.categoria || 'Geral'}</span>
            </div>
            <div class="prod-card-title">${p.nome}</div>
            <div class="prod-meta">
              <span class="badge badge-green">Venda: ${preco}</span>
              <span class="badge badge-gray">Custo: ${custo}</span>
              <span class="badge ${margemClass}">Margem Real: ${margemPct}%</span>
              <span class="badge badge-gray">${parseFloat(p.peso_produtividade || 1).toFixed(1)} pt</span>
            </div>

            <div class="ficha-resumo">
              <div style="font-size:11px;font-weight:600;color:var(--text-muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Composição do Produto</div>
              ${p.ficha_tecnica_receitas && p.ficha_tecnica_receitas.length ? `
                ${p.ficha_tecnica_receitas.map(r => {
                  const g = r.quantidade_gramas ? parseFloat(r.quantidade_gramas) : (parseFloat(r.quantidade_necessaria || 0) * 1000);
                  const custoItem = (g / 1000.0) * parseFloat(r.custo_por_kg || 0);
                  return `<div class="ficha-item">
                    <span>• ${r.nome} <span class="text-muted text-sm">(${formatarPeso(g)})</span></span>
                    <strong>${formatarDinheiro(custoItem)}</strong>
                  </div>`;
                }).join('')}
              ` : '<span class="text-muted">Sem receitas vinculadas.</span>'}

              ${p.rateio_embalagem > 0 ? `
                <div class="ficha-item" style="border-top:1px dashed var(--border-light);margin-top:4px;padding-top:4px">
                  <span>📦 Embalagem (${p.embalagem_nome || 'Caixa'}):</span>
                  <strong>+ ${formatarDinheiro(p.rateio_embalagem)} / un</strong>
                </div>` : ''}
            </div>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:8px;align-items:center;border-top:1px dashed var(--border-light);padding-top:12px;margin-top:12px">
            <button class="btn btn-outline btn-sm" onclick="openProdutoModal(${p.id})">Editar</button>
            <button class="btn btn-outline btn-sm" style="color:var(--red);border-color:var(--red)" onclick="excluirProduto(${p.id})">Excluir</button>
          </div>
        </div>`;
    }).join('');
  }

  function filtrar() {
    const q = document.getElementById('input-busca').value.toLowerCase();
    renderizar(todosProdutos.filter(p => p.nome.toLowerCase().includes(q) || (p.categoria_producao || p.categoria || '').toLowerCase().includes(q)));
  }

  /* ======================== MODAL CENTRALIZADO DE PRODUTO ======================== */
  async function openProdutoModal(id = null) {
    document.getElementById('ficha-container').innerHTML = '';
    document.getElementById('form-produto').reset();
    document.getElementById('produto-id').value = '';

    await carregarCategoriaSelect('PRODUTO', 'produto-categoria');
    popularEmbalagemSelect();

    if (id) {
      try {
        const res = await fetch(`${API_PRODUTOS}/${id}`);
        const p = await res.json();

        document.getElementById('produto-modal-title').innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Editar Produto`;
        document.getElementById('produto-id').value = p.id;
        document.getElementById('produto-nome').value = p.nome;
        document.getElementById('produto-preco').value = parseFloat(p.preco_venda || 0);
        document.getElementById('produto-peso-prod').value = parseFloat(p.peso_produtividade || 1.0);
        document.getElementById('produto-embalagem').value = p.embalagem_id || '';
        document.getElementById('produto-capacidade-emb').value = parseFloat(p.capacidade_embalagem || 1);

        const valCat = p.categoria_producao || p.categoria || '';
        const sel = document.getElementById('produto-categoria');
        for (const opt of sel.options) {
          if (opt.value === valCat) { opt.selected = true; break; }
        }

        if (p.ficha_tecnica_receitas && p.ficha_tecnica_receitas.length) {
          p.ficha_tecnica_receitas.forEach(r => {
            const g = r.quantidade_gramas ? parseFloat(r.quantidade_gramas) : (parseFloat(r.quantidade_necessaria || 0) * 1000);
            adicionarLinhaFicha({ receita_id: r.receita_id, g });
          });
        } else {
          adicionarLinhaFicha();
        }
      } catch {
        showToast('Erro ao carregar dados do produto.', 'error');
      }
    } else {
      document.getElementById('produto-modal-title').innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg> Novo Produto`;
      adicionarLinhaFicha();
    }

    recalcFinancialSummary();
    document.getElementById('produto-modal-overlay').classList.add('open');
  }

  function openDrawer(id = null) { openProdutoModal(id); }

  function closeProdutoModal() {
    document.getElementById('produto-modal-overlay').classList.remove('open');
  }
  function closeDrawer() { closeProdutoModal(); }

  function closeProdutoModalOnBackdrop(event) {
    if (event.target === document.getElementById('produto-modal-overlay')) closeProdutoModal();
  }

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      closeProdutoModal();
      closeCatModal();
    }
  });

  function popularEmbalagemSelect() {
    const sel = document.getElementById('produto-embalagem');
    sel.innerHTML = '<option value="">Nenhuma embalagem</option>';
    todosInsumos.forEach(i => {
      const pPago = parseFloat(i.preco_pago || i.custo_unitario || 0);
      sel.innerHTML += `<option value="${i.id}" data-cost="${pPago}">${i.nome} (${formatarDinheiro(pPago)})</option>`;
    });
  }

  function adicionarLinhaFicha(dados = null) {
    const container = document.getElementById('ficha-container');
    const rowId = 'row-' + Date.now() + '-' + Math.random().toString(36).slice(2,6);
    const div = document.createElement('div');
    div.className = 'ficha-row'; div.id = rowId;

    const selectedRecId = dados ? dados.receita_id : null;
    const gVal = dados ? parseFloat(dados.g || 0) : '';

    let options = '<option value="">Selecione a receita...</option>';
    todasReceitas.forEach(r => {
      const isSel = selectedRecId == r.id ? 'selected' : '';
      options += `<option value="${r.id}" data-cost-kg="${r.custoPorKg || 0}" ${isSel}>${r.nome} (${r.categoria})</option>`;
    });

    div.innerHTML = `
      <select class="receita-select" required onchange="updateFichaRowCost('${rowId}')">
        ${options}
      </select>
      <input type="number" class="qtd-input" step="0.1" min="0.1" value="${gVal}" placeholder="Ex: 60" required oninput="updateFichaRowCost('${rowId}')" />
      <span class="row-cost-cell" style="font-size:12px;font-weight:600;text-align:right">R$ 0,00</span>
      <button type="button" class="row-remove-btn" onclick="document.getElementById('${rowId}').remove(); recalcFinancialSummary()">×</button>`;
    
    container.appendChild(div);
    updateFichaRowCost(rowId);
  }

  function updateFichaRowCost(rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;

    const select = row.querySelector('.receita-select');
    const opt    = select.options[select.selectedIndex];
    const costKg = opt ? parseFloat(opt.dataset.costKg || 0) : 0;
    const g      = parseFloat(row.querySelector('.qtd-input').value || 0);

    const custoItem = (costKg / 1000.0) * g;
    row.querySelector('.row-cost-cell').textContent = formatarDinheiro(custoItem);

    recalcFinancialSummary();
  }

  function recalcFinancialSummary() {
    let pesoTotalGramas     = 0;
    let custoIngredientes   = 0;

    document.querySelectorAll('.ficha-row').forEach(row => {
      const select = row.querySelector('.receita-select');
      const opt    = select.options[select.selectedIndex];
      const costPerKg = opt ? parseFloat(opt.dataset.costKg || 0) : 0;
      const g = parseFloat(row.querySelector('.qtd-input').value || 0);

      pesoTotalGramas   += g;
      custoIngredientes += (g / 1000.0) * costPerKg;
    });

    // Rateio de Embalagem
    const selEmb = document.getElementById('produto-embalagem');
    const optEmb = selEmb.options[selEmb.selectedIndex];
    const custoCaixa = optEmb ? parseFloat(optEmb.dataset.cost || 0) : 0;
    const capCaixa   = Math.max(1, parseFloat(document.getElementById('produto-capacidade-emb').value || 1));
    const rateioEmb  = custoCaixa > 0 ? (custoCaixa / capCaixa) : 0;

    document.getElementById('label-rateio-emb').textContent = `${formatarDinheiro(rateioEmb)} / un`;

    const custoTotal   = custoIngredientes + rateioEmb;
    const precoVenda   = parseFloat(document.getElementById('produto-preco').value || 0);
    const precoSugerido = custoTotal * 2.5;

    const margemBruta = precoVenda - custoTotal;
    const margemPct   = precoVenda > 0 ? (margemBruta / precoVenda) * 100 : 0;

    document.getElementById('summary-peso').textContent = formatarPeso(pesoTotalGramas);
    document.getElementById('summary-custo').textContent = formatarDinheiro(custoTotal);
    document.getElementById('summary-preco-sugerido').textContent = formatarDinheiro(precoSugerido);

    const summaryPctEl = document.getElementById('summary-margem-pct');
    summaryPctEl.textContent = `${margemPct.toFixed(1)}%`;

    const cardBlock = document.getElementById('summary-card-block');
    cardBlock.className = 'summary-card-block ';
    if (margemPct < 0) cardBlock.className += 'red';
    else if (margemPct < 50) cardBlock.className += 'amber';
    else cardBlock.className += 'green';
  }

  async function salvarProduto(e) {
    e.preventDefault();
    const id = document.getElementById('produto-id').value;

    const rows = document.querySelectorAll('.ficha-row');
    const fReceitas = [];

    rows.forEach(row => {
      const recId = parseInt(row.querySelector('.receita-select').value, 10);
      const g     = parseFloat(row.querySelector('.qtd-input').value);

      if (recId && g) {
        fReceitas.push({ receita_id: recId, quantidade_gramas: g, quantidade_necessaria: g / 1000.0 });
      }
    });

    if (!fReceitas.length) {
      showToast('Adicione pelo menos uma receita à composição do produto.', 'error');
      return;
    }

    const catValue = document.getElementById('produto-categoria').value;
    const embId = document.getElementById('produto-embalagem').value;
    const capEmb = parseFloat(document.getElementById('produto-capacidade-emb').value || 1);

    const selEmb = document.getElementById('produto-embalagem');
    const optEmb = selEmb.options[selEmb.selectedIndex];
    const custoCaixa = optEmb ? parseFloat(optEmb.dataset.cost || 0) : 0;
    const rateioEmb  = custoCaixa > 0 ? (custoCaixa / capEmb) : 0;

    const body = {
      nome: document.getElementById('produto-nome').value.trim(),
      preco_venda: parseFloat(document.getElementById('produto-preco').value),
      peso_produtividade: parseFloat(document.getElementById('produto-peso-prod').value),
      categoria: catValue,
      categoria_producao: catValue,
      embalagem_id: embId ? parseInt(embId, 10) : null,
      capacidade_embalagem: capEmb,
      rateio_embalagem: rateioEmb,
      ficha_tecnica_receitas: fReceitas,
      ficha_tecnica_insumos: [],
      ficha_tecnica_embalagens: []
    };

    try {
      const res = id
        ? await fetch(`${API_PRODUTOS}/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        : await fetch(API_PRODUTOS, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

      if (res.ok) {
        showToast(id ? '✅ Produto atualizado!' : '✅ Produto criado com sucesso!', 'success');
        closeProdutoModal();
        carregarDados();
      } else {
        const d = await res.json();
        showToast('Erro ao salvar: ' + (d.erro || 'Desconhecido'), 'error');
      }
    } catch {
      showToast('Erro de conexão.', 'error');
    }
  }

  async function excluirProduto(id) {
    const p = todosProdutos.find(x => x.id === id);
    if (!confirm(`Excluir "${p?.nome}"?`)) return;
    try {
      const res = await fetch(`${API_PRODUTOS}/${id}`, { method: 'DELETE' });
      if (res.ok) { showToast('🗑️ Produto removido.'); carregarDados(); }
      else { const d = await res.json(); showToast('Erro ao excluir.', 'error'); }
    } catch { showToast('Erro de conexão.', 'error'); }
  }

  window.onload = carregarDados;
</script>
</body>
</html>
