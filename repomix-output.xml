      display: flex;
      align-items: center;
      gap: 12px;
    }
    .date-selector input[type="date"] {
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      font-weight: 600;
